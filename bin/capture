}
function frameTime(value, markers) {
  const screencast = finite2(value.screencastTimestamp ?? value.timestamp);
  if (screencast !== void 0) return screencastToPerformanceMs(screencast, markers);
  return observerToPerformanceMs(value, markers);
}
function flattenTraceEvents(events) {
  const flattened = [];
