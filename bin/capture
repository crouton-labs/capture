// src/cdp/host/lifecycle.ts
function isCollectorKind(value) {
  return typeof value === "string" && value in COLLECTOR_KINDS;
}
function readCollecting(dir) {
  try {
    const raw = JSON.parse(readPrivateFile(path15.join(dir, "collecting.json")).toString("utf8"));
    if (typeof raw.id !== "string" || !isCollectorKind(raw.kind) || typeof raw.startedAt !== "string") return null;
    return { id: raw.id, kind: raw.kind, startedAt: raw.startedAt };
  } catch {
    return null;
  }
}
function collectingDirectories(root) {
  const dirs = [];
  const walk2 = (dir) => {
    let entries;
    try {
      entries = fs11.readdirSync(dir, { withFileTypes: true });
    } catch {
      return;
    }
    if (entries.some((entry) => entry.isFile() && entry.name === "collecting.json")) dirs.push(dir);
    for (const entry of entries) if (entry.isDirectory()) walk2(path15.join(dir, entry.name));
  };
  walk2(root);
  return dirs;
}
function reapOrphanedCollectors(sessionDir2) {
  const outcomes = [];
  for (const dir of collectingDirectories(sessionDir2)) {
    const collecting = readCollecting(dir);
    if (!collecting) continue;
    try {
      const reconstructed = collectorKind(collecting.kind).reconstruct(dir);
      const summary = reconstructed.summary && typeof reconstructed.summary === "object" && !Array.isArray(reconstructed.summary) ? reconstructed.summary : { value: reconstructed.summary };
      writeJsonPrivate(path15.join(dir, "meta.json"), {
        id: collecting.id,
        kind: collecting.kind,
        completion: "orphaned",
        reason: "host_died",
        startedAt: collecting.startedAt,
        endedAt: (/* @__PURE__ */ new Date()).toISOString(),
        files: reconstructed.files,
        summary,
        ...summary
      });
      unlinkPrivateFile(path15.join(dir, "collecting.json"));
      outcomes.push({ status: "reaped", id: collecting.id, kind: collecting.kind, dir });
    } catch (error4) {
      outcomes.push({ status: "terminal", id: collecting.id, kind: collecting.kind, dir, error: error4 instanceof Error ? error4.message : String(error4) });
    }
  }
  return outcomes;
}
async function waitForHostExit(handle, timeoutMs = 2e3) {
  const deadline = Date.now() + timeoutMs;
  for (; ; ) {
    const observed = processPidBirthProvider.read(handle.pid);
    if (observed.status === "absent" || observed.status === "found" && !sameBirth(observed.identity, handle.birth)) return;
    if (Date.now() >= deadline) {
      stopBridge(handle.pid, handle.socketPath);
      return;
    }
    await new Promise((resolve12) => setTimeout(resolve12, 25));
  }
}
function terminal(error4) {
  return { status: "terminal", error: error4 };
}
async function stopAndReapCollectorHostAtSessionStop(sessionDir2) {
  const scanned = scanCollectorHost(sessionDir2);
  if (scanned.classification === "absent") return { status: "absent" };
  if (!scanned.handle) return terminal(`collector host handle is ${scanned.classification}`);
  if (scanned.classification === "unknown") return terminal("collector host liveness is unknown");
  if (scanned.classification === "dead") {
    const outcomes = reapOrphanedCollectors(sessionDir2);
    removeArtifactTree(scanned.path);
    const failure = outcomes.find((outcome) => outcome.status === "terminal");
    return failure ? terminal(failure.error) : { status: "reaped", outcomes };
  }
  try {
    const response = await sendHostRequest(scanned.handle.socketPath, { type: "session-teardown", nonce: scanned.handle.nonce }, 3e4);
    if (!response.ok) return terminal(response.error ?? "collector host refused session teardown");
    const outcomes = Array.isArray(response.outcomes) ? response.outcomes : [];
    const failure = outcomes.find((outcome) => outcome.status === "terminal");
    if (failure) return terminal(failure.error);
    await waitForHostExit(scanned.handle);
    return { status: "drained", outcomes };
  } catch (error4) {
    return terminal(error4 instanceof Error ? error4.message : String(error4));
  }
}
