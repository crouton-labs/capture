      if (behavior !== "instant" && behavior !== "smooth") throw syntaxSchemaInput(commandPath, `--behavior=${behavior}`, "instant or smooth", "--behavior");
      parsed.behavior = behavior;
      i++;
    } else if (arg === "--full-page") parsed.fullPage = true;
    else if (arg === "--all") parsed.all = true;
    else if (arg === "--session") {
      parsed.session = valueFor(arg, next);
      i++;
    } else if (arg === "--hold") parsed.hold = true;
    else if (arg === "--filter") {
      parsed.filter = valueFor(arg, next);
      i++;
    } else if (arg === "--name") {
      parsed.name = valueFor(arg, next);
      i++;
    } else if (arg === "--filter-url") {
      parsed.filterUrl = valueFor(arg, next);
      i++;
    } else if (arg === "--body") {
      parsed.body = valueFor(arg, next);
      i++;
