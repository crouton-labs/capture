  }
  const records = await withConnection(
    parsed,
    (client) => collectElements(client, { all: parsed.all, name: parsed.name }),
    { settle: 0 }
  );
  emitResult(buildElementsResult(records, { all: Boolean(parsed.all), limit, name: parsed.name }), {
    json: parsed.json
  });
}
