      i++;
    } else if (arg === "--file") {
      parsed.file = valueFor(arg, next);
      i++;
    } else if (arg === "--new") parsed.new = true;
    else if (arg === "--headed") parsed.headed = true;
    else if (arg === "--target") {
      parsed.target = valueFor(arg, next);
      parsed.targetSource = "flag";
      i++;
