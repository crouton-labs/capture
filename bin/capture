        let skipComma = false;
        for (const child of args) {
          if (node && child === node) {
            if (!skipComma && child.kind === 28) {
              argumentIndex++;
            }
            return argumentIndex;
          }
          if (isSpreadElement(child)) {
            argumentIndex += getSpreadElementCount(child, checker);
            skipComma = true;
            continue;
          }
          if (child.kind !== 28) {
            argumentIndex++;
            skipComma = true;
            continue;
          }
          if (skipComma) {
            skipComma = false;
            continue;
          }
          argumentIndex++;
