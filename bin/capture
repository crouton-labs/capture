function rasterRegions(beforePath, afterPath, geometryRecords) {
  const beforePng = import_pngjs6.PNG.sync.read(fs27.readFileSync(beforePath));
  const afterPng = import_pngjs6.PNG.sync.read(fs27.readFileSync(afterPath));
  if (beforePng.width !== afterPng.width || beforePng.height !== afterPng.height) return [];
  const { width, height } = beforePng;
  const diff = new import_pngjs6.PNG({ width, height });
  pixelmatch(beforePng.data, afterPng.data, diff.data, width, height, { threshold: 0.1, diffMask: true });
  const changed = new Uint8Array(width * height);
  for (let i = 0; i < width * height; i += 1) {
    const o = i * 4;
    if (diff.data[o] || diff.data[o + 1] || diff.data[o + 2]) changed[i] = 1;
  }
  const seen = new Uint8Array(width * height);
  const regions = [];
  const geometryRects = geometryRecords.filter((record5) => record5.geometryChanged).flatMap((record5) => [rectOf2(record5.before), rectOf2(record5.after)].filter((rect3) => Boolean(rect3)));
  for (let y = 0; y < height; y += 1) {
    for (let x = 0; x < width; x += 1) {
      const start2 = y * width + x;
      if (!changed[start2] || seen[start2]) continue;
      let minX = x, maxX = x, minY = y, maxY = y, count3 = 0;
      const queue = [start2];
      seen[start2] = 1;
      for (let q = 0; q < queue.length; q += 1) {
        const cur = queue[q];
        const cx = cur % width;
        const cy = Math.floor(cur / width);
        count3 += 1;
        minX = Math.min(minX, cx);
        maxX = Math.max(maxX, cx);
        minY = Math.min(minY, cy);
        maxY = Math.max(maxY, cy);
        for (const [nx, ny] of [[cx + 1, cy], [cx - 1, cy], [cx, cy + 1], [cx, cy - 1]]) {
          if (nx < 0 || ny < 0 || nx >= width || ny >= height) continue;
          const ni = ny * width + nx;
          if (changed[ni] && !seen[ni]) {
            seen[ni] = 1;
            queue.push(ni);
          }
        }
      }
      const region = { x: minX, y: minY, w: maxX - minX + 1, h: maxY - minY + 1, changedPixels: count3, explainedByGeometry: false };
      regions.push({ ...region, explainedByGeometry: geometryRects.some((rect3) => overlaps(rect3, region)) });
    }
  }
  return regions;
}
function selectorsMatch(regionSelector, elementSelector) {
  return regionSelector !== void 0 && elementSelector !== void 0 && regionSelector === elementSelector;
}
function joinCaveats(before, after, beforeRegions, afterRegions) {
  const caveatsFor2 = (element, regions, snapshot) => {
    if (!element) return [];
