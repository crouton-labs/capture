  assertKind(ref, "snap", "readGeometry");
  return readJsonArtifactFile(ref, "geometry.json");
}
function readStyles(ref) {
  assertKind(ref, "snap", "readStyles");
  return readJsonArtifactFile(ref, "styles.json");
}
function readHittest(ref) {
  assertKind(ref, "snap", "readHittest");
  return readJsonArtifactFile(ref, "hittest.json");
}
function readText(ref) {
  assertKind(ref, "snap", "readText");
  return readJsonArtifactFile(ref, "text.json");
}
function readForms(ref) {
  assertKind(ref, "snap", "readForms");
  return readJsonArtifactFile(ref, "forms.json");
}
function readAnimation(ref) {
  assertKind(ref, "snap", "readAnimation");
  return readJsonArtifactFile(ref, "animation.json");
