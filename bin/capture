async function viewportScopedCapture(client, viewport2, options, includeCssViewport = false) {
  const MAX_DIM = 1600;
  const SCREENSHOT_REQUEST_TIMEOUT_MS = 3e4;
  let ownsDeviceMetricsOverride = false;
  let primaryFailed = false;
  let primaryError;
  try {
    if (viewport2) {
      ownsDeviceMetricsOverride = true;
      await client.send("Emulation.setDeviceMetricsOverride", {
        width: viewport2.width,
        height: viewport2.height,
        deviceScaleFactor: 1,
        mobile: false
      });
      await new Promise((resolve12) => setTimeout(resolve12, 150));
    }
    if (options?.fullPage) {
      const layoutMetrics = await client.send("Page.getLayoutMetrics", {}, 5e3);
      const contentWidth = layoutMetrics.cssVisualViewport?.clientWidth ?? viewport2?.width ?? 1280;
      const contentHeight = layoutMetrics.contentSize?.height ?? viewport2?.height ?? 800;
      ownsDeviceMetricsOverride = true;
      await client.send("Emulation.setDeviceMetricsOverride", {
        width: contentWidth,
        height: Math.ceil(contentHeight),
        deviceScaleFactor: 1,
        mobile: false
      });
      await new Promise((resolve12) => setTimeout(resolve12, 150));
    }
    let screenshotOpts = {
      format: "png",
      captureBeyondViewport: false
    };
    let capturedRegion;
    let scrollOffset;
    try {
      const metrics = await client.send("Page.getLayoutMetrics", {}, 5e3);
      const vw = Math.round(metrics.cssVisualViewport?.clientWidth ?? 0);
      const vh = Math.round(metrics.cssVisualViewport?.clientHeight ?? 0);
      const pageX = metrics.cssVisualViewport?.pageX ?? 0;
      const pageY = metrics.cssVisualViewport?.pageY ?? 0;
      const sx = Math.floor(pageX);
      const sy = Math.floor(pageY);
      scrollOffset = validScrollOffset({ x: pageX, y: pageY });
      const dprResult = await client.send("Runtime.evaluate", {
        expression: "window.devicePixelRatio",
        returnByValue: true
      }, 5e3);
      const dpr = dprResult.result.value ?? 1;
      const visualViewport = validRegion({ x: sx, y: sy, width: vw, height: vh });
      const requestedCrop = options?.crop;
      const crop = requestedCrop && visualViewport ? intersectRegions(requestedCrop, visualViewport) : visualViewport;
      if (!crop) {
        throw new Error("The requested CSS crop does not intersect the live visual viewport.");
      }
      const zoom = options?.zoom ?? 1;
      const actualMaxSide = Math.max(crop.width, crop.height) * dpr * zoom;
      const scale = actualMaxSide > MAX_DIM ? MAX_DIM / (Math.max(crop.width, crop.height) * dpr) : zoom / dpr;
      screenshotOpts = {
        ...screenshotOpts,
        clip: { x: crop.x, y: crop.y, width: crop.width, height: crop.height, scale }
      };
      capturedRegion = crop;
    } catch (error4) {
      if (options?.crop) throw error4;
    }
    const result = await client.send(
      "Page.captureScreenshot",
      screenshotOpts,
      SCREENSHOT_REQUEST_TIMEOUT_MS
    );
    let png = Buffer.from(result.data ?? "", "base64");
    if (png.length === 0 && screenshotOpts.clip) {
      const clip = screenshotOpts.clip;
      const retry = await client.send("Page.captureScreenshot", {
        ...screenshotOpts,
        clip: { ...clip, scale: 1 }
      }, SCREENSHOT_REQUEST_TIMEOUT_MS);
      png = Buffer.from(retry.data ?? "", "base64");
      if (png.length > 0) png = downscalePngToFit(png, MAX_DIM);
    }
    if (png.length === 0 && screenshotOpts.clip && !options?.fullPage && !options?.crop) {
      const retry = await client.send("Page.captureScreenshot", {
        format: "png",
        captureBeyondViewport: false
      }, SCREENSHOT_REQUEST_TIMEOUT_MS);
      png = Buffer.from(retry.data ?? "", "base64");
      if (png.length > 0) png = downscalePngToFit(png, MAX_DIM);
      if (png.length > 0) {
        capturedRegion = void 0;
        scrollOffset = void 0;
      }
    }
    if (includeCssViewport && !capturedRegion) {
      try {
        const response = await client.send("Runtime.evaluate", {
          expression: "(() => { const v = window.visualViewport; return v ? { x: v.pageLeft, y: v.pageTop, width: v.width, height: v.height } : null; })()",
          returnByValue: true
        }, 5e3);
        const value = response.result?.value;
        if (value) {
          const x = Number(value.x);
          const y = Number(value.y);
          capturedRegion = validRegion({ x, y, width: Number(value.width), height: Number(value.height) });
          scrollOffset = validScrollOffset({ x, y });
        }
      } catch {
      }
    }
    if (png.length === 0) {
      throw new Error(
        "Page.captureScreenshot returned no image data (the tab may not be rendering); refusing to write a 0-byte PNG"
      );
    }
    return {
      png,
      ...includeCssViewport && capturedRegion ? { cssViewport: capturedRegion } : {},
      ...includeCssViewport && scrollOffset ? { scrollOffset } : {}
    };
  } catch (error4) {
    primaryFailed = true;
    primaryError = error4;
    throw error4;
  } finally {
    if (ownsDeviceMetricsOverride) {
      try {
        await client.send("Emulation.clearDeviceMetricsOverride");
      } catch (cleanupError) {
        if (primaryFailed) {
          throw new AggregateError(
            [primaryError, cleanupError],
            "Screenshot capture failed and device-metrics cleanup also failed.",
            { cause: primaryError }
          );
        }
        throw cleanupError;
      }
    }
  }
}
