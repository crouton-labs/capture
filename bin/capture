        tracker.replaceRangeWithText(
          sourceFile,
          {
            pos: prevNode.getEnd() - 2,
            end: reference.literal.getStart() + 1
          },
          replacement.text.replace(/\\/g, "\\\\").replace(/`/g, "\\`")
        );
      }
