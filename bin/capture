function finiteNumber2(value) {
  return typeof value === "number" && Number.isFinite(value) ? value : null;
}
function stringOrNull(value) {
  return typeof value === "string" ? value : null;
}
function roundMilliseconds(value) {
  return Math.round(value * 1e3) / 1e3;
}
function classTokens(value) {
  return typeof value === "string" ? value.split(/\s+/).filter(Boolean) : [];
}
function matchesRecordedSelector(element, selector) {
  const trimmed = selector.trim();
  if (!trimmed || /[\s>+~\[\]:,*]/.test(trimmed)) return false;
  const match = /^(?<tag>[A-Za-z][A-Za-z0-9-]*)?(?<id>#[A-Za-z_][A-Za-z0-9_-]*)?(?<classes>(?:\.[A-Za-z_][A-Za-z0-9_-]*)*)$/.exec(trimmed);
  if (!match?.groups) return false;
  const tag = match.groups.tag;
  const requestedId = match.groups.id?.slice(1);
  const requestedClasses = [...match.groups.classes?.matchAll(/\.([A-Za-z_][A-Za-z0-9_-]*)/g) ?? []].map((m) => m[1]);
  if (!tag && !requestedId && requestedClasses.length === 0) return false;
  if (tag && stringOrNull(element.tag)?.toLowerCase() !== tag.toLowerCase()) return false;
  if (requestedId && stringOrNull(element.id) !== requestedId) return false;
  const classes = new Set(classTokens(element.classes));
  return requestedClasses.every((name) => classes.has(name));
}
function elementLabel3(element) {
  return [stringOrNull(element.tag) ?? "", stringOrNull(element.id) ?? "", stringOrNull(element.classes) ?? ""].join("\0");
}
function propertyValue(element, property) {
  const geometry = {
    x: element.x,
    y: element.y,
    width: element.width,
    height: element.height,
    left: element.x,
    top: element.y,
    right: finiteNumber2(element.x) !== null && finiteNumber2(element.width) !== null ? finiteNumber2(element.x) + finiteNumber2(element.width) : void 0,
    bottom: finiteNumber2(element.y) !== null && finiteNumber2(element.height) !== null ? finiteNumber2(element.y) + finiteNumber2(element.height) : void 0,
    scrollTop: element.scrollTop,
    scrollLeft: element.scrollLeft
  };
  const direct = geometry[property];
  if (typeof direct === "string" || typeof direct === "number" || typeof direct === "boolean" || direct === null) return direct;
  for (const container of [element.properties, element.computed]) {
    if (container && typeof container === "object") {
      const value = container[property];
      if (typeof value === "string" || typeof value === "number" || typeof value === "boolean" || value === null) return value;
    }
  }
  return void 0;
}
function analyzeMotionTimeline(ref, selector, property) {
  const records = readRects(ref);
  const events = readEvents(ref);
  const markers = readMarkers(ref);
  const frames2 = records.map((record5, index) => ({
    frame: finiteNumber2(record5.frame) ?? index,
    timestamp: finiteNumber2(record5.screencastTimestamp),
    elements: Array.isArray(record5.elements) ? record5.elements.filter((e) => typeof e === "object" && e !== null) : []
  })).sort((a, b) => a.frame - b.frame);
  let selected;
  for (const frame of frames2) {
    selected = frame.elements.find((element) => matchesRecordedSelector(element, selector));
    if (selected) break;
  }
  if (!selected) {
    throw new MotionTimelineSelectionError(selector, frames2.length);
  }
  const selectedBackendNodeId = finiteNumber2(selected.backendNodeId);
  const selectionMethod = selectedBackendNodeId === null ? "sample-label" : "backend-node-id";
  const selectedLabel = elementLabel3(selected);
  const baseline = finiteNumber2(markers.firstScreencastTimestampSec) ?? frames2.find((frame) => frame.timestamp !== null)?.timestamp ?? null;
  const timingDomain = baseline === null ? "frame-order-only" : "screencast-relative";
  let propertyAvailable = property === void 0;
  const points = [];
  for (const frame of frames2) {
    const element = selectedBackendNodeId !== null ? frame.elements.find((candidate) => finiteNumber2(candidate.backendNodeId) === selectedBackendNodeId) : frame.elements.find((candidate) => elementLabel3(candidate) === selectedLabel);
    if (!element) continue;
    const x = finiteNumber2(element.x);
    const y = finiteNumber2(element.y);
    const width = finiteNumber2(element.width);
    const height = finiteNumber2(element.height);
    if (x === null || y === null || width === null || height === null) continue;
    const value = property === void 0 ? void 0 : propertyValue(element, property);
    if (property !== void 0 && value !== void 0) propertyAvailable = true;
    points.push({
      frame: frame.frame,
      timeMs: baseline !== null && frame.timestamp !== null ? roundMilliseconds((frame.timestamp - baseline) * 1e3) : null,
      timestampUncertainty: "\xB1frame",
      elementId: finiteNumber2(element.backendNodeId),
      tag: stringOrNull(element.tag),
      id: stringOrNull(element.id),
      classes: stringOrNull(element.classes),
      x,
      y,
      width,
      height,
      ...finiteNumber2(element.scrollTop) !== null ? { scrollTop: finiteNumber2(element.scrollTop) } : {},
      ...finiteNumber2(element.scrollLeft) !== null ? { scrollLeft: finiteNumber2(element.scrollLeft) } : {},
      ...property !== void 0 && value !== void 0 ? { property: { name: property, value } } : {}
    });
  }
  return { points, selectedBackendNodeId, selectionMethod, frameCount: frames2.length, eventsRead: events.length, propertyAvailable, timingDomain };
}
function readTimelineMeta(ref) {
  const meta = readMeta(ref);
  return { state: typeof meta.state === "string" ? meta.state : "unknown", durationMs: finiteNumber2(meta.durationMs) };
}
var MotionTimelineSelectionError;
var init_timeline = __esm({
  "src/cdp/motion/timeline.ts"() {
