function motionReconstruct(dir) {
  const framesDir = path13.join(dir, "frames");
  const frames2 = fs9.existsSync(framesDir) ? fs9.readdirSync(framesDir).filter((name) => name.endsWith(".png")).length : 0;
  const bytes = (name) => {
    try {
      return fs9.statSync(path13.join(dir, name)).size;
    } catch {
      return 0;
    }
