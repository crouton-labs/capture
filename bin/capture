function httpGetJson(port, path48, timeoutMs) {
  return new Promise((resolve12) => {
    const req = http.get(
      { host: CDP_LOOPBACK_HOST, port, path: path48, timeout: timeoutMs },
      (res) => {
        const status = res.statusCode ?? 0;
        if (status < 200 || status >= 300) {
          res.resume();
          resolve12(null);
          return;
        }
        let body2 = "";
        res.setEncoding("utf-8");
        res.on("data", (chunk) => {
          body2 += chunk;
        });
        res.on("end", () => {
          try {
            resolve12(JSON.parse(body2));
          } catch {
            resolve12(null);
          }
        });
        res.on("error", () => resolve12(null));
      }
    );
    req.on("timeout", () => {
      req.destroy();
      resolve12(null);
    });
    req.on("error", () => resolve12(null));
  });
}
