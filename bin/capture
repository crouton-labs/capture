async function resolveIndexedObjectIds(client, arrayObjectId, count3) {
  const out = new Array(count3).fill(void 0);
  if (count3 <= 0) return out;
  const propsResult = await client.send("Runtime.getProperties", {
    objectId: arrayObjectId,
    ownProperties: true
  });
  for (const prop of propsResult.result ?? []) {
    if (!/^\d+$/.test(prop.name)) continue;
    const idx = Number(prop.name);
    if (idx < 0 || idx >= count3) continue;
    out[idx] = prop.value?.objectId;
  }
  return out;
}
