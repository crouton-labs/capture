      function getPresentModifiers(contextToken, sourceFile, position) {
        if (!contextToken || getLineAndCharacterOfPosition(sourceFile, position).line > getLineAndCharacterOfPosition(sourceFile, contextToken.getEnd()).line) {
          return {
            modifiers: 0
            /* None */
          };
        }
