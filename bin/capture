function representativeFindings(findings, limit) {
  const byKind = /* @__PURE__ */ new Map();
  for (const finding2 of findings) {
    const group = byKind.get(finding2.kind) ?? [];
    group.push(finding2);
    byKind.set(finding2.kind, group);
  }
  const displayed = [];
  for (let index = 0; displayed.length < limit; index++) {
    let added = false;
    for (const group of byKind.values()) {
      const finding2 = group[index];
      if (!finding2) continue;
      displayed.push(finding2);
      added = true;
      if (displayed.length === limit) break;
    }
    if (!added) break;
  }
  return displayed;
}
function rollup(findings) {
  const counts = /* @__PURE__ */ new Map();
  for (const finding2 of findings) counts.set(finding2.kind, (counts.get(finding2.kind) ?? 0) + 1);
  return [...counts.entries()].map(([kind, count3]) => fact`${kind}=${count3}`).reduce((line4, entry) => line4 ? [...line4, ...text`, `, ...entry] : entry, void 0);
}
function caveatLine(caveats) {
  if (!caveats.length) return void 0;
  return fact`Nondeterminism caveat: unstable region ${caveats.map((c) => `${c.regionId}${c.selector ? ` (${c.selector})` : ""}${c.reason ? `: ${c.reason}` : ""}`).join("; ")}.`;
}
function contrastHeadline(detail) {
  const ratioPrefix = "contrast ratio ";
  const divider = " \u2014 ";
  const foregroundMarker = " foreground ";
  const backgroundMarker = " against composited background ";
  const dividerAt = detail.indexOf(divider);
  if (!detail.startsWith(ratioPrefix) || dividerAt < 0) return fact`${detail}`;
  const ratio = detail.slice(ratioPrefix.length, dividerAt);
  const subject = detail.slice(dividerAt + divider.length);
  const foregroundAt = subject.lastIndexOf(foregroundMarker);
  const backgroundAt = subject.indexOf(backgroundMarker, foregroundAt + foregroundMarker.length);
  if (foregroundAt < 0 || backgroundAt < 0) return fact`${detail}`;
  const selector = subject.slice(0, foregroundAt);
  const foreground = subject.slice(foregroundAt + foregroundMarker.length, backgroundAt);
  const background = subject.slice(backgroundAt + backgroundMarker.length);
  return line(
    text`contrast ratio `,
    data(ratio),
    text` — `,
    data(selector),
    text` foreground `,
    data(capped(foreground, Number.MAX_SAFE_INTEGER)),
    text` against composited background `,
    data(capped(background, Number.MAX_SAFE_INTEGER))
  );
}
async function cmdMeasureCheck(parsed, _args) {
  if (parsed.help) {
    console.log(USAGE17);
    return;
  }
  if (parsed.positional.length > 1) {
    emitResult({ tag: "error", attrs: { command: "measure check", status: "invalid_input" }, summary: text`measure check accepts at most one URL or snapshot reference.` }, { json: parsed.json });
    process.exitCode = 1;
    return;
  }
  try {
    const target = parsed.positional[0];
    if (!target) throw new Error("missing snapshot target; pass a snapshot id/path or URL");
    const checks = parseChecks(parsed.for);
    const ref = await resolveSnapRef(target, { onUrl: async (url) => captureMeasureSnap({ ...parsed, positional: [url] }, url) });
    const report = checkSnapshot(ref, checks);
    const scopedElements = parsed.selector ? resolveSelectorInput(readGeometry(ref).elements ?? [], parsed.selector) : void 0;
    if (scopedElements && !scopedElements.length) {
      emitResult({
        tag: "error",
        attrs: { command: "measure check", status: "missing_selector", selector: parsed.selector },
        summary: fact`No geometry record matched selector input ${parsed.selector}.`,
        followUp: text`Use a recorded selector or backend:<id> from geometry.json.`
      }, { json: parsed.json });
      process.exitCode = 1;
