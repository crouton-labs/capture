    const selectorMatched = regions.filter((region) => !region.elementIds?.length && selectorsMatch(region.selector, element.selector)).map((region) => ({ regionId: region.id, selector: region.selector, reason: region.reason }));
    return [...matched, ...selectorMatched].map((caveat) => ({ ...caveat, snapshot }));
  };
  const seen = /* @__PURE__ */ new Set();
