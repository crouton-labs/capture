// src/cdp/commands/page/elements.ts
async function collectElements(client, opts = {}) {
  const nodes = await readFullAXTree(client);
  const nodesById = new Map(nodes.map((node) => [node.nodeId, node]));
  const parents = /* @__PURE__ */ new Map();
  for (const node of nodes) {
    for (const childId of node.childIds ?? []) parents.set(childId, node);
  }
  const nameOf = (node) => {
    const ownName = node.name?.value ?? "";
    if (ownName) return ownName;
    return (node.childIds ?? []).map((childId) => nodesById.get(childId)).filter((child) => child?.role?.value === "StaticText").map((child) => child.name?.value ?? "").filter(Boolean).join(" ");
  };
  const records = [];
  for (const node of nodes) {
    if (node.ignored) continue;
    const role = node.role?.value ?? "";
    if (!role) continue;
    if (!opts.all) {
      if (!INTERACTIVE_ROLES.has(role)) continue;
      if (node.backendDOMNodeId === void 0) continue;
    } else {
      const parent = parents.get(node.nodeId);
      const duplicateParentText = parent !== void 0 && (node.name?.value === parent.name?.value || role === "StaticText" && !parent.name?.value);
      if ((role === "StaticText" || role === "InlineTextBox") && typeof node.name?.value === "string" && node.name.value.length > 0 && duplicateParentText) {
        continue;
      }
    }
    records.push({
      role,
      name: nameOf(node),
      backendNodeId: node.backendDOMNodeId ?? null
    });
  }
  return opts.name === void 0 ? records : records.filter((record5) => record5.name.toLowerCase().includes(opts.name.toLowerCase()));
}
function buildElementsResult(records, opts) {
  const total = records.length;
  const shown = selectRecords(records, { limit: opts.limit }, opts.limit);
  const rows = shown.map(
    (r) => r.backendNodeId !== null ? fact`${r.role} "${r.name}" target:ax:${r.name} backend:${r.backendNodeId}` : fact`${r.role} "${r.name}"`
  );
  const sections = [];
  if (rows.length > 0) sections.push(lineList(rows));
  if (total > shown.length) {
    sections.push(fact`elements-truncated: listing capped at ${shown.length} of ${total} elements (--limit)`);
  }
  return {
    tag: "elements",
    attrs: { scope: opts.all ? "all" : "interactive", count: total, "name-filter": opts.name },
    summary: opts.all ? opts.name === void 0 ? fact`${total} elements in the exposed accessibility tree` : fact`${total} elements in the exposed accessibility tree with accessible name containing ${opts.name}` : opts.name === void 0 ? fact`${total} interactive elements` : fact`${total} interactive elements with accessible name containing ${opts.name}`,
    sections,
    followUp: text`capture page click <target> · capture measure map ax <url|snap>`
  };
}
async function cmdPageElements(parsed, _args) {
  if (parsed.help) {
    console.log(USAGE7);
