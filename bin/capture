function observerToPerformanceMs(value, markers) {
  const performanceNow = finite2(value.startTime ?? value.performanceNowMs ?? value.performanceNow);
  const baseline = finite2(markers.performanceNowMs);
  if (performanceNow === void 0 || baseline === void 0) return null;
