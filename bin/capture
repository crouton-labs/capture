async function cmdTabOpen(parsed, _args) {
  if (parsed.help) {
    console.log(USAGE12);
    return;
  }
  const url = parsed.positional[0];
  if (!url) {
    throw invalidInput("received: no URL; expected: capture tab open <url> [--new] [--port <port>].", "missing_argument");
  }
  let port;
  try {
    port = parsed.port ?? await detectCdpPort();
  } catch {
    throw captureError(
      "world",
