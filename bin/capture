}
function firstPaintDelta(frameDeltas, startMs, endMs) {
  const delta2 = frameDeltas.find((item) => item.diffPixelCount > 0 && item.timestampMs >= startMs && (endMs === null || item.timestampMs < endMs));
  return delta2 ? { stage: "paint", timestampMs: delta2.timestampMs, precision: "frame", source: `${delta2.source} (${delta2.diffPixelCount} changed pixel(s))` } : null;
}
function settlePoint(frameDeltas, candidates, startMs, endMs) {
  const lastSignalMs = Math.max(startMs, ...candidates.filter((point) => inWindow(point, startMs, endMs)).map((point) => point.timestampMs));
  let consecutiveIdentical = 0;
  for (const delta2 of frameDeltas) {
    if (delta2.timestampMs < lastSignalMs || endMs !== null && delta2.timestampMs >= endMs) continue;
    if (delta2.diffPixelCount === 0) consecutiveIdentical += 1;
    else consecutiveIdentical = 0;
    if (consecutiveIdentical >= 2 && delta2.timestampMs - lastSignalMs >= 300) {
      return { stage: "settle", timestampMs: delta2.timestampMs, precision: "frame", source: "two consecutive identical frame deltas; no scoped DOM/network/layout/paint signal for \u2265300ms" };
    }
  }
  return null;
}
function firstStage(candidates, stage, startMs, endMs) {
  return candidates.filter((point) => point.stage === stage && inWindow(point, startMs, endMs)).sort((a, b) => a.timestampMs - b.timestampMs)[0] ?? null;
}
function responseTimelineFromArtifacts(action, events, frames2, markers, state, occurrence) {
  if (!finite3(markers.performanceNowMs)) throw new Error("markers.json has no finite performanceNowMs baseline; re-record with `capture motion rec`.");
  const caveats = eventDropCaveats(events);
  if (markers.baselinesPending) caveats.push("markers.json still has baselinesPending=true; timing sources without anchors are omitted rather than aligned approximately.");
  if (state === "orphaned-finalized") caveats.push("recording state is orphaned-finalized; artifacts are a partial best-effort recording from data flushed before recorder exit.");
  if (state === "partial") caveats.push("recording state is partial (no_frames); retained source records are readable, while frame-derived paint and settle facts are unavailable.");
  if (!finite3(markers.wallClockMs)) caveats.push("screencast wall-clock anchor unavailable; frame-derived paint and settle timing are unavailable.");
  const actions = inputMarks(events, markers);
  const selected = selectAction(actions, action, occurrence);
  const nextAction = actions.find((item) => item.startMs > selected.startMs);
  const actionWindowEndMs = nextAction?.startMs ?? null;
  const candidates = [];
  for (const event of events) {
    const timestampMs = observerPerformance(event, markers);
    if (timestampMs === null) continue;
    if (event.kind === "mutation") candidates.push({ stage: "mutation", timestampMs, precision: "exact", source: "MutationObserver" });
    if (event.kind === "resize" || event.kind === "performance" && event.entryType === "layout") candidates.push({ stage: "layout", timestampMs, precision: "exact", source: event.kind === "resize" ? "ResizeObserver" : "PerformanceObserver layout entry" });
    if (event.kind === "performance" && event.entryType === "paint") candidates.push({ stage: "paint", timestampMs, precision: "exact", source: "PerformanceObserver paint entry" });
    if (event.kind === "network") candidates.push({ stage: "network", timestampMs, precision: "exact", source: "network event" });
    if (event.kind === "performance" && event.entryType === "longtask") candidates.push({ stage: "longtask", timestampMs, precision: "exact", source: "PerformanceObserver longtask entry" });
  }
  for (const trace2 of traceEvents(events, markers, caveats)) {
    if (/layout|updatelayouttree/i.test(trace2.name)) candidates.push({ stage: "layout", timestampMs: trace2.timestampMs, precision: "exact", source: `Tracing ${trace2.name}` });
    else if (/paint|composite|drawframe/i.test(trace2.name)) candidates.push({ stage: "paint", timestampMs: trace2.timestampMs, precision: "exact", source: `Tracing ${trace2.name}` });
    else if (/network|resource(send|receive|finish)|load/i.test(trace2.name)) candidates.push({ stage: "network", timestampMs: trace2.timestampMs, precision: "exact", source: `Tracing ${trace2.name}` });
    else if (/(longtask|run(task|microtasks)|task)/i.test(trace2.name) && (trace2.durationMs ?? 0) >= 50) candidates.push({ stage: "longtask", timestampMs: trace2.timestampMs, precision: "exact", source: `Tracing ${trace2.name}` });
  }
  const frameDeltas = frameDeltasFromRecords(frames2, markers);
  const paintFromFrames = firstPaintDelta(frameDeltas, selected.startMs, actionWindowEndMs);
  if (paintFromFrames) candidates.push(paintFromFrames);
  const points = [{ stage: "input", timestampMs: selected.startMs, deltaMs: 0, precision: "exact", source: `input dispatch mark (occurrence ${selected.occurrence})` }];
  for (const stage of ["mutation", "layout", "paint", "network", "longtask"]) {
    const point = firstStage(candidates, stage, selected.startMs, actionWindowEndMs);
    if (point) points.push({ ...point, deltaMs: point.timestampMs - selected.startMs });
  }
  const settle = settlePoint(frameDeltas, candidates, selected.startMs, actionWindowEndMs);
  if (settle) points.push({ ...settle, deltaMs: settle.timestampMs - selected.startMs });
  points.sort((a, b) => a.timestampMs - b.timestampMs || a.stage.localeCompare(b.stage));
  const present = new Set(points.map((point) => point.stage));
  const unavailableStages = ["mutation", "layout", "paint", "network", "settle"].filter((stage) => !present.has(stage));
  if (unavailableStages.includes("paint") && frameDeltas.length === 0) caveats.push("paint-different frame unavailable: no readable adjacent frame deltas with wall-clock-aligned timestamps.");
  if (unavailableStages.includes("settle")) caveats.push("settle unavailable: this action window has no two consecutive identical frame deltas after \u2265300ms without scoped response signals.");
  return {
    action: selected.label,
    inputStartMs: selected.startMs,
    inputEndMs: selected.endMs,
    actionWindowEndMs,
    points,
    unavailableStages,
    caveats,
    state,
    timingNote: "Timestamps use performance.now() relative to recorder arm; observer points use PerformanceEntry.startTime when present, trace points require a real trace alignment marker, and frame-derived points use the screencast wall-clock anchor with \xB11 frame uncertainty."
  };
}
function withFrameDeltas(ref, rects, markers) {
  const framesDir = artifactPath(ref, "frames", { mustExist: false });
  if (!fs34.existsSync(framesDir) || !fs34.statSync(framesDir).isDirectory()) return [...rects];
  const files = fs34.readdirSync(framesDir).filter((name) => name.endsWith(".png")).sort((a, b) => a.localeCompare(b, void 0, { numeric: true }));
  if (files.length < 2) return [...rects];
  const byFile = new Map(rects.filter((record5) => typeof record5.file === "string").map((record5) => [record5.file, record5]));
  const workDir = path39.join(ref.dir, ".response-diff-work");
  ensurePrivateDir(workDir);
  try {
    const output = [...rects];
    for (let i = 0; i < files.length - 1; i++) {
      const before = path39.join(framesDir, files[i]);
      const after = path39.join(framesDir, files[i + 1]);
      const diffPath = path39.join(workDir, `pair-${String(i).padStart(6, "0")}.png`);
      const diff = diffPngs(before, after, diffPath, { diffMask: true });
      if (!diff.ok) continue;
      const afterRecord = byFile.get(files[i + 1]);
      if (afterRecord) output.push({ ...afterRecord, diffPixelCount: diff.diffPixelCount });
      else output.push({ file: files[i + 1], screencastTimestamp: void 0, timestamp: void 0, frame: i + 1, diffPixelCount: diff.diffPixelCount });
    }
    return output;
  } finally {
    fs34.rmSync(workDir, { recursive: true, force: true });
  }
}
function loadResponseTimeline(rec, action, occurrence) {
  const ref = resolveRecRef(rec);
  const meta = readMeta(ref);
  const state = typeof meta.state === "string" ? meta.state : "unknown";
  const readablePartial = state === "partial" && meta.reason === "no_frames";
  if (state !== "finalized" && state !== "orphaned-finalized" && !readablePartial) {
    throw new Error(`Recording ${JSON.stringify(ref.id)} is state ${JSON.stringify(state)}; finalize it with \`capture motion rec --stop\` before querying response.`);
  }
  const events = readEvents(ref);
  const markers = readMarkers(ref);
  if (!finite3(markers.performanceNowMs)) throw new Error("markers.json has no finite performanceNowMs baseline; re-record with `capture motion rec`.");
  const actions = inputMarks(events, markers);
  if (!action && actions.length !== 1) throw new ResponseActionSelectionError(actions);
  const selected = action ?? actions[0]?.label;
  if (!selected) throw new ResponseActionSelectionError(actions);
  const rects = readRects(ref);
  const frames2 = withFrameDeltas(ref, rects, markers);
  return { ref, timeline: responseTimelineFromArtifacts(selected, events, frames2, markers, state, occurrence), availableActions: actions.map((item) => actionOccurrenceLabel(item)) };
}
function actionOccurrenceLabel(action) {
  return `${action.label} (occurrence ${action.occurrence}, t=${action.startMs.toFixed(2)}ms)`;
}
var fs34, path39, ResponseActionSelectionError;
var init_response = __esm({
  "src/cdp/motion/response.ts"() {
    fs34 = __toESM(require("fs"));
    path39 = __toESM(require("path"));
    init_diff();
    init_artifact();
    init_artifacts();
    ResponseActionSelectionError = class extends Error {
      actions;
      constructor(actions, message) {
        const labels = actions.map((action) => typeof action === "string" ? action : actionOccurrenceLabel(action));
        super(message ?? (labels.length === 0 ? "Recording has no injected input marks." : "Recording has multiple input marks; pass --action <unique action>."));
        this.name = "ResponseActionSelectionError";
        this.actions = labels;
      }
    };
  }
});

// src/cdp/commands/motion/response.ts
function formatPoint2(point) {
  const uncertainty = point.precision === "frame" ? text` (±1 frame)` : text``;
  return line(fact`${point.stage}: t=${point.timestampMs.toFixed(2)}ms, Δ=${point.deltaMs.toFixed(2)}ms — ${point.source}`, uncertainty);
}
function emitError(parsed, status, message, sections) {
  const result = {
    tag: "error",
    attrs: { command: "motion response", status },
    summary: fact`${message}`,
    sections
  };
  emitResult(result, { json: parsed.json });
  process.exitCode = 1;
}
async function cmdMotionResponse(parsed, _args) {
  if (parsed.help) {
    console.log(USAGE32);
    return;
  }
  if (parsed.positional.length !== 1) {
    return emitError(parsed, "invalid_input", "motion response requires exactly one recording id or absolute recording path. Create one with `capture motion rec`.");
  }
  try {
    const loaded = loadResponseTimeline(parsed.positional[0], parsed.action, parsed.occurrence);
    const { ref, timeline } = loaded;
    const result = {
      tag: "response",
      attestation: {
        kind: "recording",
        id: ref.id,
        path: ref.dir,
        note: fact`${timeline.timingNote} Recording state: ${timeline.state}.`
      },
      attrs: {
        action: timeline.action,
        state: timeline.state,
        "timing-domain": "performance.now() relative to recorder arm",
        "frame-uncertainty": "\xB11 frame where marked"
      },
      summary: fact`Input dispatch bracket: t=${timeline.inputStartMs.toFixed(2)}ms to ${timeline.inputEndMs.toFixed(2)}ms. Response stages present: ${timeline.points.length - 1}. Unavailable stages: ${timeline.unavailableStages.length ? timeline.unavailableStages.join(", ") : "none"}.`,
      sections: [
        lineList(timeline.points.map(formatPoint2)),
        ...timeline.caveats.length ? [lineList(timeline.caveats.map((caveat) => fact`caveat: ${caveat}`))] : []
      ]
    };
    emitResult(result, { json: parsed.json });
  } catch (err) {
    if (err instanceof ResponseActionSelectionError) {
      const actions = err.actions.length ? lineList(err.actions.map((action) => fact`available action: ${action}`)) : text`No input marks were recorded. Record a driven capture action with \`capture motion rec <url> --do <action>\` or drive an action during composed recording.`;
      return emitError(parsed, "action_required", err.message, [actions]);
    }
    if (err instanceof ArtifactResolutionError) {
      return emitError(parsed, "artifact_unavailable", err.message);
    }
    return emitError(parsed, "response_unavailable", err instanceof Error ? err.message : String(err));
  }
}
