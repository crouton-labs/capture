  const h = finite2(item.h ?? item.height);
  return x === void 0 || y === void 0 || w === void 0 || h === void 0 ? void 0 : { x, y, w, h };
}
function delta(previous, current) {
  return { x: current.x - previous.x, y: current.y - previous.y, w: current.w - previous.w, h: current.h - previous.h };
