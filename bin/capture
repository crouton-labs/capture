function exactKeys(value, keys) {
  const actual = Object.keys(value).sort();
  return actual.length === keys.length && actual.every((key, index) => key === keys.slice().sort()[index]);
}
function parseBirth(value) {
  if (!value || typeof value !== "object" || Array.isArray(value)) return void 0;
  const b = value;
  if (b.provider === "linux-proc-v1" && exactKeys(b, ["provider", "bootId", "startTicks"]) && typeof b.bootId === "string" && BOOT_ID.test(b.bootId) && typeof b.startTicks === "string" && /^[1-9][0-9]*$/.test(b.startTicks)) return { provider: "linux-proc-v1", bootId: b.bootId, startTicks: b.startTicks };
  if (b.provider === "darwin-kern-proc-v1" && exactKeys(b, ["provider", "startSec", "startUsec"]) && typeof b.startSec === "string" && /^[1-9][0-9]*$/.test(b.startSec) && typeof b.startUsec === "number" && Number.isInteger(b.startUsec) && b.startUsec >= 0 && b.startUsec < 1e6) return { provider: "darwin-kern-proc-v1", startSec: b.startSec, startUsec: b.startUsec };
  return void 0;
}
function rejectLogLabel(label2) {
  if (label2.length === 0) return "empty";
  if (label2 === "." || label2 === "..") return `\`${label2}\` is not a filename`;
  if (label2.includes("/") || label2.includes("\\")) return "contains a path separator";
  if (label2.includes("\0")) return "contains a NUL byte";
  if (Buffer.byteLength(label2, "utf-8") > MAX_LOG_LABEL_BYTES) return `exceeds ${MAX_LOG_LABEL_BYTES} bytes`;
  return null;
}
function parseRegisteredLogTailer(value) {
  if (!value || typeof value !== "object" || Array.isArray(value)) return void 0;
  const record5 = value;
  const birth = parseBirth(record5.birth);
  const valid = birth !== void 0 && exactKeys(record5, ["pid", "name", "sourcePath", "birth", "socketPath", "socketDev", "socketIno", "nonce"]) && Number.isSafeInteger(record5.pid) && record5.pid > 0 && typeof record5.name === "string" && rejectLogLabel(record5.name) === null && typeof record5.sourcePath === "string" && path.isAbsolute(record5.sourcePath) && typeof record5.socketPath === "string" && path.dirname(record5.socketPath) === LOG_TAILER_SOCKET_DIR && LOG_TAILER_SOCKET_TOKEN.test(path.basename(record5.socketPath, ".sock")) && path.extname(record5.socketPath) === ".sock" && typeof record5.socketDev === "string" && DECIMAL_IDENTITY.test(record5.socketDev) && typeof record5.socketIno === "string" && DECIMAL_IDENTITY.test(record5.socketIno) && typeof record5.nonce === "string" && LOG_TAILER_NONCE.test(record5.nonce);
  if (!valid || birth === void 0) return void 0;
  return { pid: record5.pid, name: record5.name, sourcePath: record5.sourcePath, birth, socketPath: record5.socketPath, socketDev: record5.socketDev, socketIno: record5.socketIno, nonce: record5.nonce };
}
function parseDarwinKernProc(snapshot, pid, context = { arch: process.arch, selfPid: process.pid, selfStartSeconds: Math.floor(Date.now() / 1e3 - process.uptime()), nowSeconds: Math.floor(Date.now() / 1e3) }) {
  if (!["arm64", "x64"].includes(context.arch) || !Number.isSafeInteger(pid) || pid <= 0 || !snapshot.length || snapshot.length % 648) return unknown("unexpected kern.proc layout");
  const seen = /* @__PURE__ */ new Set();
  let found;
  let selfStart;
  const future = BigInt(context.nowSeconds + 60);
  for (let offset = 0; offset < snapshot.length; offset += 648) {
    const recordPid = snapshot.readInt32LE(offset + 40);
    const sec = snapshot.readBigInt64LE(offset);
    const usec = snapshot.readBigInt64LE(offset + 8);
    if (recordPid < 0 || recordPid > 1e7 || seen.has(recordPid) || recordPid !== 0 && (sec <= 0n || sec > future || usec < 0n || usec >= 1000000n)) return unknown("invalid kern.proc snapshot");
    seen.add(recordPid);
    if (recordPid === context.selfPid) selfStart = sec;
    if (recordPid === pid) found = { provider: "darwin-kern-proc-v1", startSec: sec.toString(), startUsec: Number(usec) };
  }
  const expectedSelf = BigInt(Math.floor(context.selfStartSeconds));
  if (!seen.has(1) || selfStart === void 0 || abs(selfStart - expectedSelf) > 60n) return unknown("kern.proc snapshot missing or invalid self identity");
  return found ? { status: "found", identity: found } : { status: "absent" };
}
function parseLinuxProcStat(stat, expectedPid, bootId) {
  if (!BOOT_ID.test(bootId.trim()) || !stat.startsWith(`${expectedPid} (`)) return unknown("malformed proc identity");
  const close = stat.lastIndexOf(") ");
  const fields = close < 0 ? [] : stat.slice(close + 2).trim().split(/\s+/);
  const startTicks = fields[19];
  if (!/^[1-9][0-9]*$/.test(startTicks ?? "")) return unknown("malformed proc identity");
  return { status: "found", identity: { provider: "linux-proc-v1", bootId: bootId.trim(), startTicks } };
}
function abs(value) {
  return value < 0n ? -value : value;
