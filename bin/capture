// src/cdp/commands/cdp.ts
function emitCdpResult(opts) {
  const sections = [];
  const payloadCap = (payload) => opts.json ? payload.length : GENEROUS_RESULT_CAP2;
  if (opts.method) {
    const payload = JSON.stringify(opts.result) ?? "undefined";
    sections.push(line(text`result: `, data(capped(payload, payloadCap(payload)))));
  }
  if (opts.waitEvent) {
    const payload = JSON.stringify(opts.event) ?? "undefined";
    sections.push(line(text`event: `, data(capped(payload, payloadCap(payload)))));
  }
  emitResult(
    {
      tag: "cdp-result",
      attrs: {
        method: opts.method,
        "wait-event": opts.waitEvent,
        scope: opts.scope,
        target: opts.target
      },
      sections
    },
    { json: opts.json }
  );
}
function timeoutGuidance(message, timeoutMs) {
  return /\b(?:timed out|timeout)\b/i.test(message) ? `${message} The request limit was ${timeoutMs}ms; re-run with \`--timeout <ms>\` to extend it.` : message;
}
function cdpFailed(message, flagTarget, timeoutMs, cause) {
  const detailed = timeoutGuidance(message, timeoutMs);
  return captureError("world", "cdp_failed", flagTarget ? detailed : `${detailed} ${TAB_SCOPE_RECOVERY}`, cause);
}
async function cmdCdp(parsed, _args) {
  if (parsed.help) {
    console.log(HELP3);
    return;
  }
  const method = parsed.positional[0];
  if (!method && !parsed.waitEvent) {
    throw invalidInput(
      "received: neither a <Domain.method> positional nor --wait-event; expected: at least one of the two. Run `capture cdp -h` for the input schema.",
      "missing_method_and_event"
    );
  }
  let params;
  if (parsed.params) {
    try {
      params = JSON.parse(parsed.params);
    } catch (err) {
      throw invalidInput(
        `received: --params that is not valid JSON (${err instanceof Error ? err.message : String(err)}); expected: a JSON-encoded params object.`,
        "invalid_params_json"
      );
    }
  }
  const timeoutMs = parsed.timeoutMs ?? DEFAULT_TIMEOUT_MS;
  if (parsed.browser) {
    await runBrowserScope(method, params, parsed, timeoutMs, DEFAULT_BROWSER_DEPS);
    return;
  }
  try {
    await runPageScope(method, params, parsed, timeoutMs);
  } catch (err) {
    if (err instanceof CaptureError) throw err;
    throw captureError(
      "world",
      "cdp_failed",
      timeoutGuidance(`\`${invocationLabel(method, parsed.waitEvent)}\` failed on the page connection: ${err instanceof Error ? err.message : String(err)}`, timeoutMs),
      err
    );
  }
}
function invocationLabel(method, waitEvent) {
  return method ?? `--wait-event ${waitEvent}`;
}
async function runBrowserScope(method, params, parsed, timeoutMs, deps23 = DEFAULT_BROWSER_DEPS) {
  const flagTarget = parsed.targetSource === "flag" ? parsed.target : void 0;
  const session = getActiveSession();
  const bridgeSocket = session?.bridgeSocket;
  const heldBridgeActive = Boolean(bridgeSocket && fs20.existsSync(bridgeSocket));
  if (parsed.portSource !== "flag" && bridgeSocket && heldBridgeActive) {
    let resp;
    try {
      resp = await deps23.sendBridgeRequest(bridgeSocket, {
        method,
        params,
        targetId: flagTarget,
        waitEvent: parsed.waitEvent,
        timeoutMs
      });
    } catch (err) {
      if (err instanceof CaptureError) throw err;
      throw cdpFailed(
        `\`${invocationLabel(method, parsed.waitEvent)}\` failed over the held connection: ${err instanceof Error ? err.message : String(err)}`,
        flagTarget,
        timeoutMs,
        err
      );
    }
    if (!resp.ok) {
      throw cdpFailed(
        `\`${invocationLabel(method, parsed.waitEvent)}\` failed over the held connection: ${resp.error ?? "unknown bridge error"}`,
        flagTarget,
        timeoutMs
      );
    }
    emitCdpResult({
      method,
      waitEvent: parsed.waitEvent,
      scope: "browser",
      target: flagTarget,
      result: resp.result,
      event: resp.event,
      json: parsed.json
    });
    return;
  }
  const connectionReason = parsed.portSource === "flag" ? heldBridgeActive ? `Using explicitly selected CDP port ${parsed.port} instead of the active session bridge` : `Using explicitly selected CDP port ${parsed.port}` : "No held session bridge active";
  console.error(
    `${connectionReason} \u2014 this one-shot connection closes when the command exits, so any browser-level grant or target enablement made here reverts immediately after.`
  );
  const port = parsed.port ?? await deps23.detectCdpPort();
  const { client } = await deps23.getBrowserClient(port);
  try {
    let sessionId;
    if (flagTarget) {
      const tab = await deps23.findTabById(port, flagTarget);
      if (!tab) {
        throw captureError(
          "precondition",
          "target_not_found",
          `received: --target ${flagTarget} with no matching target on port ${port}; expected: an existing target id (8-char prefix accepted). \`capture tab list\` shows available targets.`
        );
      }
      const attached = await client.send("Target.attachToTarget", {
        targetId: tab.id,
        flatten: true
      }, timeoutMs);
      sessionId = attached.sessionId;
    }
    const eventPromise = parsed.waitEvent ? waitForEventOnce(client, parsed.waitEvent, timeoutMs) : void 0;
    const result = method ? await client.send(method, params ?? {}, timeoutMs, sessionId) : void 0;
    const event = eventPromise ? await eventPromise : void 0;
    emitCdpResult({
      method,
      waitEvent: parsed.waitEvent,
      scope: "browser",
      target: flagTarget,
      result,
      event,
      json: parsed.json
    });
  } catch (err) {
    if (err instanceof CaptureError) throw err;
    throw cdpFailed(
      `\`${invocationLabel(method, parsed.waitEvent)}\` failed on the one-shot browser connection: ${err instanceof Error ? err.message : String(err)}`,
      flagTarget,
      timeoutMs,
      err
    );
  } finally {
    client.close();
  }
}
async function runPageScope(method, params, parsed, timeoutMs, connect = connectForCommand) {
  const { client } = await connect(parsed);
  try {
    let result;
    let event;
    if (isMotionHeldClient(client)) {
      if (method) {
        const combined = await client.dispatch(method, params ?? {}, parsed.waitEvent, timeoutMs);
        result = combined.result;
        event = combined.event;
      } else if (parsed.waitEvent) {
        event = await client.waitEvent(parsed.waitEvent, timeoutMs);
      }
    } else {
      const eventPromise = parsed.waitEvent ? waitForEventOnce(client, parsed.waitEvent, timeoutMs) : void 0;
      result = method ? await client.send(method, params ?? {}, timeoutMs) : void 0;
      event = eventPromise ? await eventPromise : void 0;
    }
    emitCdpResult({
      method,
      waitEvent: parsed.waitEvent,
      scope: "page",
      target: parsed.target,
      result,
      event,
      json: parsed.json
    });
  } finally {
    client.close();
  }
}
function waitForEventOnce(client, eventName, timeoutMs) {
  return new Promise((resolve12, reject) => {
    const timer = setTimeout(
      () => reject(new Error(`Timed out after ${timeoutMs}ms waiting for event "${eventName}"`)),
      timeoutMs
    );
    client.on(eventName, (params) => {
      clearTimeout(timer);
      resolve12(params);
    });
  });
}
var fs20, DEFAULT_TIMEOUT_MS, GENEROUS_RESULT_CAP2, COMMAND_BLOCK5, HELP3, DEFAULT_BROWSER_DEPS, TAB_SCOPE_RECOVERY;
var init_cdp = __esm({
  "src/cdp/commands/cdp.ts"() {
    fs20 = __toESM(require("fs"));
    init_errors();
    init_session_context();
    init_connection();
    init_targets();
    init_detect();
    init_client3();
    init_held_client();
    init_render();
    DEFAULT_TIMEOUT_MS = 1e4;
    GENEROUS_RESULT_CAP2 = 4e3;
    COMMAND_BLOCK5 = `<command name="cdp">
raw CDP escape hatch \u2014 send any protocol method capture doesn't wrap, or wait for a protocol event
use when sending a CDP method or waiting for an event Capture does not otherwise expose
</command>`;
    HELP3 = `capture cdp \u2014 send a raw CDP protocol method and/or wait for a protocol event: the escape hatch for domains no other capture command wraps (Browser.*, ServiceWorker.*, Target.*, ...).

Input:
  <Domain.method>              protocol method to send. At least one of <Domain.method> / --wait-event is required.
  --params <json>              JSON-encoded params object for the method. Spec deviation: params stay inline JSON (no file indirection) \u2014 raw CDP params are small protocol-defined objects.
  --wait-event <Domain.event>  wait for (and return) the next occurrence of a protocol event; combinable with a method (the method is sent first) or usable alone.
  --browser                    route through the held connection (session start --hold) instead of a one-shot page websocket. Connection-scoped state (permission grants, domain enables) reverts the instant its connection closes \u2014 it survives across commands only inside a held session.
  --port <port>                CDP endpoint. An explicit flag selects that endpoint even when an active session holds another browser connection.
  --target <id>                with --browser: attach a flattened CDP session on the held connection to this target (for target-scoped domains), including an already-open tab adopted by \`session start --hold\` without --url; without --browser: the page target to run against. 8-char id prefix accepted.
  --timeout <ms>               one-shot method-response and event-wait timeout (default ${DEFAULT_TIMEOUT_MS}ms). WebSocket connection setup is separately bounded to 5000ms.

Connection lifetime:
  Unless --browser routes through a held session, each invocation opens an isolated CDP connection and closes it when the command exits. Domain enables and remote object handles (objectIds) are connection-scoped, so a later one-shot invocation cannot use either. A multi-step protocol sequence needs connection state that survives between its calls.

Output:
  <cdp-result method=\u2026 wait-event=\u2026 scope=\u2026> \u2014 the protocol result and/or awaited event as an escaped, length-capped JSON payload. --json mirrors the same block with the payload at full fidelity.

Effects:
  Sends the method verbatim to the browser \u2014 whatever browser/page state the protocol call mutates, it mutates. Writes no artifacts.`;
    DEFAULT_BROWSER_DEPS = { sendBridgeRequest, getBrowserClient, findTabById, detectCdpPort };
    TAB_SCOPE_RECOVERY = "Many CDP domains (Storage.*, Page.*, DOM.*, Emulation.*, ...) are tab-scoped, not connection-scoped \u2014 re-run with --target <tabId> (`capture tab list` shows available tabs).";
  }
});

// src/cdp/host/core.ts
var crypto9, fs21, path24, import_node_perf_hooks3, CollectorHost;
var init_core = __esm({
  "src/cdp/host/core.ts"() {
    crypto9 = __toESM(require("node:crypto"));
    fs21 = __toESM(require("node:fs"));
    path24 = __toESM(require("node:path"));
    import_node_perf_hooks3 = require("node:perf_hooks");
    init_artifacts();
    init_artifacts();
    init_kinds();
    init_collector();
    CollectorHost = class {
      constructor(client, sessionDir2, identity3, publish, onEmpty) {
        this.client = client;
        this.sessionDir = sessionDir2;
        this.identity = identity3;
        this.publish = publish;
        this.onEmpty = onEmpty;
        client.onDisconnect(() => {
          void this.transportLost();
        });
      }
      live = /* @__PURE__ */ new Map();
      reservations = /* @__PURE__ */ new Map();
      starting = /* @__PURE__ */ new Map();
      harClosing = false;
      clientUsable = true;
      snapshot() {
        return { collectors: [...this.live.values()].map((item) => item.row), reservations: [...this.reservations.values()] };
      }
      changed() {
        this.publish(this.snapshot());
        if (!this.live.size && !this.reservations.size) this.onEmpty();
      }
      releaseDeadReservations() {
        for (const [token2, reservation] of this.reservations) {
          const observed = processPidBirthProvider.read(reservation.pid);
          if (observed.status === "absent" || observed.status === "found" && !sameBirth(observed.identity, reservation.birth)) this.reservations.delete(token2);
        }
      }
      refuseClaims(claims, exclusive = false) {
        this.releaseDeadReservations();
        const exclusiveReservation = [...this.reservations.values()].find((reservation) => reservation.exclusive);
        if (exclusiveReservation) throw new Error(`Target is held exclusively by reservation ${exclusiveReservation.holderLabel}.`);
        if (exclusive) {
          const collector = this.live.values().next().value;
          if (collector) throw new Error(`Target has live collector ${collector.row.id}.`);
          const reservation = this.reservations.values().next().value;
          if (reservation) throw new Error(`Target has reservation ${reservation.holderLabel}.`);
          const starting = this.starting.keys().next().value;
          if (starting) throw new Error(`Target has starting collector ${starting}.`);
        }
        for (const claim of claims) {
          const collector = [...this.live.values()].find((value) => value.row.claims.includes(claim));
          if (collector) throw new Error(`Claim "${claim}" is held by collector ${collector.row.id}.`);
          const reservation = [...this.reservations.values()].find((value) => value.claims.includes(claim));
          if (reservation) throw new Error(`Claim "${claim}" is held by reservation ${reservation.holderLabel}.`);
          const starting = [...this.starting.entries()].find(([, held]) => held.includes(claim));
          if (starting) throw new Error(`Claim "${claim}" is held by collector ${starting[0]}.`);
        }
      }
      reserve(claims, holderLabel, pid, birth, exclusive = false) {
        this.refuseClaims(claims, exclusive);
        const reservation = { token: crypto9.randomBytes(18).toString("hex"), claims: [...new Set(claims)], ...exclusive ? { exclusive: true } : {}, holderLabel, pid, birth, reservedAt: (/* @__PURE__ */ new Date()).toISOString() };
        this.reservations.set(reservation.token, reservation);
        this.changed();
        return reservation;
      }
      releaseReservation(token2) {
        this.reservations.delete(token2);
        this.changed();
      }
      async start(kind, rawConfig) {
        const entry = collectorKind(kind);
        const config3 = entry.parseConfig(rawConfig);
        const collector = entry.create(config3);
        this.refuseClaims(collector.claims);
        const id = `${entry.idPrefix}-${crypto9.randomBytes(5).toString("hex")}`;
        this.starting.set(id, collector.claims);
        const dir = path24.join(this.sessionDir, ...entry.idSegments, id);
        try {
          ensurePrivateDir(dir);
          const startedAt = (/* @__PURE__ */ new Date()).toISOString();
          const row = { id, kind, dir, claims: [...collector.claims], startedAt };
          const live = { row, collector, startedAt, losses: [], stopping: false };
          const context = {
            client: this.client,
            dir,
            id,
            targetId: this.identity.targetId,
            config: config3,
            appendRecord: (file, record5) => appendNdjsonPrivate(path24.join(dir, file), record5),
            openChunkFile: (file) => openPrivateChunkWriter(path24.join(dir, file)),
            noteLoss: (reason, detail) => {
              live.losses.push({ reason, detail });
            }
          };
          writeJsonPrivate(path24.join(dir, "collecting.json"), { kind, id, startedAt, hostPid: this.identity.pid, hostBirth: this.identity.birth });
          await collector.start(context);
          this.starting.delete(id);
          this.live.set(id, live);
          this.changed();
          return row;
        } catch (error4) {
          this.starting.delete(id);
          if (!(error4 instanceof RetainedCollectorStartFailure)) removeArtifactTree(dir);
          this.changed();
          throw error4;
        }
      }
      cutoff(items) {
        const selected = [...items].filter((item) => !item.stopping);
        for (const item of selected) item.stopping = true;
        for (const item of selected) item.collector.closeAdmission();
        return selected;
      }
      finalizedFiles(dir) {
        const files = [];
        const walk2 = (relative2) => {
          for (const entry of fs21.readdirSync(path24.join(dir, relative2), { withFileTypes: true })) {
            const name = path24.join(relative2, entry.name);
            if (entry.isDirectory()) walk2(name);
            else if (entry.isFile()) files.push({ name, bytes: readPrivateFile(path24.join(dir, name)).length });
          }
        };
        walk2("");
        return files;
      }
      async drainOne(live, cause) {
        const outcome = await live.collector.drain(cause);
        unlinkPrivateFile(path24.join(live.row.dir, "collecting.json"));
        const files = this.finalizedFiles(live.row.dir);
        const loss = live.losses[0];
        const completion = loss || !cause.clientUsable ? "partial" : "complete";
        const summary = outcome.summary && typeof outcome.summary === "object" && !Array.isArray(outcome.summary) ? outcome.summary : { value: outcome.summary };
        writeJsonPrivate(path24.join(live.row.dir, "meta.json"), {
          id: live.row.id,
          kind: live.row.kind,
          completion,
          ...completion === "partial" ? { reason: loss?.reason ?? "transport_lost" } : {},
          startedAt: live.startedAt,
          endedAt: (/* @__PURE__ */ new Date()).toISOString(),
          files,
          summary,
          ...summary
        });
        this.live.delete(live.row.id);
        this.changed();
        return { completion, outcome: { ...outcome, files } };
      }
      async stop(id, trigger = "explicit") {
        const live = this.live.get(id);
        if (!live) throw new Error(`No live collector named ${id}.`);
        this.cutoff([live]);
        const drained = await this.drainOne(live, { trigger, clientUsable: this.clientUsable });
        return { completion: drained.completion, summary: drained.outcome.summary, files: drained.outcome.files };
      }
      async teardown(trigger = "session-stop") {
        const stopping = this.cutoff(this.live.values());
        const outcomes = [];
        for (const live of stopping) {
          try {
            const drained = await this.drainOne(live, { trigger, clientUsable: this.clientUsable });
            outcomes.push({ status: "drained", id: live.row.id, kind: live.row.kind, completion: drained.completion, dir: live.row.dir });
          } catch (error4) {
            outcomes.push({ status: "terminal", id: live.row.id, kind: live.row.kind, dir: live.row.dir, error: error4 instanceof Error ? error4.message : String(error4) });
          }
        }
        return outcomes;
      }
      motionController() {
        return [...this.live.values()].find((live) => live.row.kind === "motion")?.collector;
      }
      async control(message) {
        if (!this.clientUsable) throw new Error("collector host CDP transport is unavailable");
        const controller = this.motionController();
        if (!controller?.control) throw new Error("no collector accepts this host control request");
        return controller.control(message);
      }
      async dispatch(method, params = {}, annotation, waitEvent, timeoutMs, observeDocumentResponse = false) {
        if (!this.clientUsable) throw new Error("collector host CDP transport is unavailable");
        const controller = this.motionController();
        if (controller?.control) return controller.control({ type: "cdp", method, params, annotation, waitEvent, timeoutMs, observeDocumentResponse });
        const notice = { method, params, annotation, atPerformanceNowMs: import_node_perf_hooks3.performance.now() };
        const callbacks = [...this.live.values()].flatMap((live) => {
          try {
            const callback = live.collector.onDispatch?.(notice);
            return callback ? [callback] : [];
          } catch {
            return [];
          }
        });
        try {
          const result = await this.client.send(method, params);
          const outcome = { ok: true, atPerformanceNowMs: import_node_perf_hooks3.performance.now() };
          for (const callback of callbacks) callback(outcome);
          return result;
        } catch (error4) {
          const outcome = { ok: false, error: error4 instanceof Error ? error4.message : String(error4), atPerformanceNowMs: import_node_perf_hooks3.performance.now() };
          for (const callback of callbacks) callback(outcome);
          throw error4;
        }
      }
      async transportLost() {
        if (!this.clientUsable) return;
        this.clientUsable = false;
        await this.teardown("transport-lost");
      }
      abandon() {
        for (const live of this.live.values()) live.collector.abandon();
      }
    };
  }
});

