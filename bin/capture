function presentationField(name) {
  return PRESENTATION_FIELDS.has(name) || /saving|wasted|score/i.test(name);
}
function reportableField(value, ancestors = /* @__PURE__ */ new Set()) {
  const text2 = string2(value);
  if (text2 !== void 0) return text2;
  const number = finite4(value);
  if (number !== void 0) return number;
  if (typeof value === "boolean" || value === null) return value;
  if (Array.isArray(value)) return value.flatMap((item) => {
    const field = reportableField(item, ancestors);
    return field === void 0 ? [] : [field];
  });
  if (value instanceof Map) {
    if (ancestors.has(value)) return void 0;
    ancestors.add(value);
    const entries = [...value].flatMap(([key, item]) => {
      const reportableKey = reportableField(key, ancestors);
      const reportableValue = reportableField(item, ancestors);
      return reportableKey === void 0 || reportableValue === void 0 ? [] : [{ key: reportableKey, value: reportableValue }];
    });
    ancestors.delete(value);
    return { entries };
  }
  if (value instanceof Set) {
    if (ancestors.has(value)) return void 0;
    ancestors.add(value);
    const values = [...value].flatMap((item) => {
      const field = reportableField(item, ancestors);
      return field === void 0 ? [] : [field];
    });
    ancestors.delete(value);
    return { values };
  }
  const fields = record3(value);
  if (fields === null || ancestors.has(fields)) return void 0;
  ancestors.add(fields);
  const result = {};
  for (const [key, item] of Object.entries(fields)) {
    if (presentationField(key)) continue;
    const field = reportableField(item, ancestors);
    if (field !== void 0) result[key] = field;
  }
  ancestors.delete(fields);
  return result;
}
function insightsFrom(model2) {
