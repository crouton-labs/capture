            "missing metric: LCP",
            "No network requests found in trace",
            "Trace is too old"
          ];
          if (!(e instanceof core_exports.LanternError)) {
            console.error(e);
          } else if (!expectedErrors.some((err) => e.message === err)) {
            console.error(e);
          }
        } finally {
          options.logger?.end("insights:createLanternContext");
        }
        const context = {
          options,
          bounds,
          frameId,
          navigation,
          navigationId,
          lantern
        };
        this.#computeInsightSet(data32, context);
      }
    };
    _a2 = TraceProcessor;
  }
