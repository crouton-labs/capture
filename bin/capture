// src/output/render.ts
function assertTrustedTag(tag) {
  if (!RESULT_TAG_SET.has(tag)) {
    throw new Error(
      `render.ts: refusing to render untrusted tag ${JSON.stringify(tag)} \u2014 tag must be one of ${RESULT_TAGS.join(", ")}`
    );
  }
}
function neutralizeControl(s) {
  return s.replace(/[\r\n\t\u2028\u2029]+/g, " ").replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F-\u009F]/g, "").replace(/\p{Cf}/gu, "");
}
function capLength(s, max) {
  if (s.length <= max) return s;
  return `${s.slice(0, max)}\u2026[+${s.length - max} chars]`;
}
function isTagNameChar(cp) {
  const c = String.fromCodePoint(cp);
  return TAG_NAME_START.test(c) || TAG_NAME_CONT.test(c);
}
function startsMarkupName(s, ltIndex) {
  let j = ltIndex + 1;
  if (s[j] === "/") j++;
  if (j >= s.length) return false;
  const cp = s.codePointAt(j);
  if (cp === void 0) return false;
  return TAG_NAME_START.test(String.fromCodePoint(cp));
}
function scanMarkupClose(s, start2, insideCssString) {
  let k = start2 + 1;
  if (s[k] === "/") k++;
  return insideCssString ? scanMarkupCloseCss(s, k) : scanMarkupCloseHtml(s, k);
}
function isTagWhitespace(ch) {
  return ch === " " || ch === "	" || ch === "\n" || ch === "\f" || ch === "\r";
}
function scanMarkupCloseCss(s, startName) {
  let k = startName;
  let nameLen = 0;
  while (k < s.length) {
    const cp = s.codePointAt(k);
    if (!isTagNameChar(cp)) break;
    k += cp > 65535 ? 2 : 1;
    nameLen++;
  }
  if (nameLen === 0) return -1;
  const boundary = s[k];
  if (boundary !== " " && boundary !== "	" && boundary !== "/" && boundary !== ">") return -1;
  let attrQuote = null;
  while (k < s.length) {
    const ck = s[k];
    if (attrQuote) {
      if (ck === attrQuote) attrQuote = null;
      k++;
      continue;
    }
    if (ck === '"' || ck === "'") {
      attrQuote = ck;
      k++;
      continue;
    }
    if (ck === ">") return k;
    if (ck === "<") return -1;
    k++;
  }
  return -1;
}
function scanMarkupCloseHtml(s, startName) {
  const n = s.length;
  let k = startName;
  let nameLen = 0;
  while (k < n) {
    const ch = s[k];
    if (isTagWhitespace(ch) || ch === "/" || ch === ">") break;
    k++;
    nameLen++;
  }
  if (nameLen === 0) return -1;
  let state = "beforeName";
  while (k < n) {
    const ch = s[k];
    switch (state) {
      case "beforeName":
        if (isTagWhitespace(ch) || ch === "/") {
          k++;
          break;
        }
        if (ch === ">") return k;
        state = "name";
        break;
      case "name":
        if (isTagWhitespace(ch)) {
          state = "afterName";
          k++;
          break;
        }
        if (ch === "/") {
          state = "afterName";
          break;
        }
        if (ch === ">") return k;
        if (ch === "=") {
          state = "beforeValue";
          k++;
          break;
        }
        k++;
        break;
      case "afterName":
        if (isTagWhitespace(ch) || ch === "/") {
          k++;
          break;
        }
        if (ch === "=") {
          state = "beforeValue";
          k++;
          break;
        }
        if (ch === ">") return k;
        state = "name";
        break;
      case "beforeValue":
        if (isTagWhitespace(ch)) {
          k++;
          break;
        }
        if (ch === '"') {
          state = "valueDQ";
          k++;
          break;
        }
        if (ch === "'") {
          state = "valueSQ";
          k++;
          break;
        }
        if (ch === ">") return k;
        state = "valueUnquoted";
        break;
      case "valueDQ":
        if (ch === '"') state = "afterValueQuoted";
        k++;
        break;
      case "valueSQ":
        if (ch === "'") state = "afterValueQuoted";
        k++;
        break;
      case "valueUnquoted":
        if (isTagWhitespace(ch)) {
          state = "beforeName";
          k++;
          break;
        }
        if (ch === ">") return k;
        k++;
        break;
      case "afterValueQuoted":
        if (isTagWhitespace(ch)) {
          state = "beforeName";
          k++;
          break;
        }
        if (ch === "/") {
          k++;
          break;
        }
        if (ch === ">") return k;
        state = "beforeName";
        break;
    }
  }
  return -1;
}
function isCssIdentChar(ch) {
  if (ch === void 0) return false;
  const cp = ch.codePointAt(0);
  if (cp > 127) return true;
  return /[A-Za-z0-9_-]/.test(ch);
}
function opensAttrSelectorString(s, quoteIndex) {
  let j = quoteIndex - 1;
  while (j >= 0 && (s[j] === " " || s[j] === "	")) j--;
  if (j < 0) return false;
  if (s[j] !== "=") return false;
  let k = j - 1;
  if (k >= 0 && "~|^$*".includes(s[k])) k--;
  while (k >= 0 && (s[k] === " " || s[k] === "	")) k--;
  if (!isCssIdentChar(s[k])) return false;
  while (k >= 0 && isCssIdentChar(s[k])) k--;
  while (k >= 0 && (s[k] === " " || s[k] === "	")) k--;
  return k >= 0 && s[k] === "[";
}
function markupCloseIndices(s) {
  const marks = /* @__PURE__ */ new Set();
  const n = s.length;
  let i = 0;
  while (i < n) {
    const c = s[i];
    if ((c === '"' || c === "'") && opensAttrSelectorString(s, i)) {
      const delim = c;
      let k = i + 1;
      while (k < n) {
        const ck = s[k];
        if (ck === "\\") {
          k += 2;
          continue;
        }
        if (ck === delim) {
          k++;
          break;
        }
        if (ck === "<" && startsMarkupName(s, k)) {
          const close = scanMarkupClose(s, k, true);
          if (close >= 0) {
            marks.add(close);
            k = close + 1;
            continue;
          }
        }
        k++;
      }
      i = k;
      continue;
    }
    if (c === "<" && startsMarkupName(s, i)) {
      const close = scanMarkupClose(s, i, false);
      if (close >= 0) {
        marks.add(close);
        i = close + 1;
        continue;
      }
    }
    i++;
  }
  for (let p = 0; p + 2 < n; p++) {
    if (s[p] === "]" && s[p + 1] === "]" && s[p + 2] === ">") marks.add(p + 2);
  }
  return marks;
}
function escapeXmlText(s) {
  const marks = markupCloseIndices(s);
  let out = "";
  for (let i = 0; i < s.length; i++) {
    const c = s[i];
    if (c === "&") out += "&amp;";
    else if (c === "<") out += "&lt;";
    else if (c === ">") out += marks.has(i) ? "&gt;" : ">";
    else out += c;
  }
  return out;
}
function escapeXmlAttr(s) {
  return escapeXmlText(s).replace(/"/g, "&quot;");
}
function sanitizeNumber(n) {
  return Number.isFinite(n) ? String(n) : "0";
}
function mkTextNode(value) {
  return { kind: "text", value, [NODE_BRAND]: true };
}
function mkDataNode(value, maxLength) {
  return { kind: "data", value, maxLength, [NODE_BRAND]: true };
}
function isFactNode(v) {
  if (typeof v !== "object" || v === null) return false;
  const n = v;
  if (n[NODE_BRAND] !== true) return false;
  if (n.kind === "text") return typeof n.value === "string";
  if (n.kind === "data") return typeof n.value === "string" || typeof n.value === "number";
  return false;
}
function assertFactLine(fl, context) {
  if (!Array.isArray(fl)) {
    throw new Error(
      `render.ts: ${context} must be a FactLine built via text\`\`/data()/fact\`\`/line()/lineList() \u2014 not a raw value`
    );
  }
  for (const node of fl) {
    if (!isFactNode(node)) {
      throw new Error(
        `render.ts: ${context} contains an unbranded/hand-constructed node \u2014 every FactLine node must come from this module's own text\`\`/data()/fact\`\`/line()/lineList() constructors, never a hand-built object literal`
      );
    }
  }
}
function capped(value, maxLength) {
  return { __capped: true, value, maxLength };
}
function isCapped(v) {
  return typeof v === "object" && v !== null && v.__capped === true;
}
function text(strings) {
  if (!Array.isArray(strings) || !("raw" in strings)) {
    throw new Error(
      "render.ts: text`` must be invoked as a tagged template literal, e.g. text`Artifacts: ` \u2014 not called with a runtime string"
    );
  }
  if (strings.length !== 1) {
    throw new Error("render.ts: text`` does not accept interpolation \u2014 use fact`` or data() for dynamic values");
  }
  return [mkTextNode(strings[0])];
}
function data(value, maxLength) {
  if (isCapped(value)) {
    return [mkDataNode(value.value, value.maxLength)];
  }
  return [mkDataNode(value, maxLength)];
}
function line(...parts) {
  const out = [];
  for (const p of parts) {
    if (!Array.isArray(p)) {
      throw new Error("render.ts: line() only accepts FactLine values (from text``/data()/fact``/line()) \u2014 not raw strings");
    }
    assertFactLine(p, "line() argument");
    out.push(...p);
  }
  return out;
}
function joinFactLines(lines, sep7) {
  const out = [];
  lines.forEach((l, i) => {
    assertFactLine(l, "joined FactLine");
    if (i > 0) out.push(mkTextNode(sep7));
    out.push(...l);
  });
  return out;
}
function lineList(lines) {
  return joinFactLines(lines, "\n");
}
function fact(strings, ...values) {
  if (!Array.isArray(strings) || !("raw" in strings)) {
    throw new Error("render.ts: fact`` must be invoked as a tagged template literal \u2014 not called with a runtime string");
  }
  const out = [];
  strings.forEach((s, i) => {
    if (s) out.push(mkTextNode(s));
    if (i < values.length) out.push(...data(values[i]));
  });
  return out;
}
function resolveDataNode(node, mode) {
  if (typeof node.value === "number") return sanitizeNumber(node.value);
  const cleaned = neutralizeControl(String(node.value));
  const capped2 = capLength(cleaned, node.maxLength ?? DEFAULT_DATA_MAX);
  return mode === "xml" ? escapeXmlText(capped2) : capped2;
}
function resolveFactLine(fl, mode) {
  assertFactLine(fl, "rendered FactLine");
  let out = "";
  for (const node of fl) {
    out += node.kind === "text" ? node.value : resolveDataNode(node, mode);
  }
  return out;
}
function renderAttrValue(raw) {
  if (isCapped(raw)) return escapeXmlAttr(capLength(neutralizeControl(String(raw.value)), raw.maxLength));
  if (typeof raw === "number") return sanitizeNumber(raw);
  if (typeof raw === "boolean") return String(raw);
  return escapeXmlAttr(capLength(neutralizeControl(raw), DEFAULT_ATTR_MAX));
}
function jsonAttrValue(raw) {
  if (isCapped(raw)) return capLength(neutralizeControl(String(raw.value)), raw.maxLength);
  if (typeof raw !== "string") return raw;
  return capLength(neutralizeControl(raw), DEFAULT_ATTR_MAX);
}
function assertValidAttrKey(key) {
  if (!ATTR_KEY_PATTERN.test(key)) {
    throw new Error(`render.ts: invalid attribute key ${JSON.stringify(key)}`);
  }
}
function renderAttrs(attrs) {
  const parts = [];
  for (const [key, raw] of Object.entries(attrs)) {
    if (raw === void 0) continue;
    assertValidAttrKey(key);
    parts.push(` ${key}="${renderAttrValue(raw)}"`);
  }
  return parts.join("");
}
function mergeAttestationAttrs(attrs, attestation3) {
  if (!attestation3) return attrs;
  const idKey = attestation3.kind === "snapshot" ? "snap" : attestation3.kind === "recording" ? "rec" : "trace";
  const canonical = { path: attestation3.path, [idKey]: attestation3.id };
  for (const [key, canonicalValue] of Object.entries(canonical)) {
    const existing = attrs[key];
    if (existing !== void 0 && existing !== canonicalValue) {
      throw new Error(
        `render.ts: attrs.${key}=${JSON.stringify(existing)} conflicts with the attestation's canonical ${key}=${JSON.stringify(canonicalValue)} \u2014 attestation identity is canonical and a leaf must not supply a different value for ${key} (an identical duplicate is fine; omit it entirely and let attestation supply it)`
      );
    }
  }
  const merged = { ...canonical };
  for (const [key, value] of Object.entries(attrs)) {
    if (key in canonical) continue;
    merged[key] = value;
  }
  return merged;
}
function assembleBody(result) {
  const header = [];
  if (result.attestation?.note) header.push(resolveFactLine(result.attestation.note, "xml"));
  if (result.summary) header.push(resolveFactLine(result.summary, "xml"));
  if (result.artifacts) header.push(resolveFactLine(result.artifacts, "xml"));
  const sections = (result.sections ?? []).map((s) => resolveFactLine(s, "xml")).filter((s) => s.length > 0);
  const blocks = [header.join("\n"), sections.join("\n\n")].filter((b) => b.length > 0);
  return blocks.join("\n\n");
}
function renderResult(result) {
  assertTrustedTag(result.tag);
  const attrsStr = renderAttrs(mergeAttestationAttrs(result.attrs ?? {}, result.attestation));
  const body2 = assembleBody(result);
  const block = `<${result.tag}${attrsStr}>
${body2}
</${result.tag}>`;
  if (!result.followUp) return block;
  return `${block}
follow_up: ${resolveFactLine(result.followUp, "xml")}`;
}
function sanitizeJsonValue(value, seen = /* @__PURE__ */ new WeakSet()) {
  if (isCapped(value)) return capLength(neutralizeControl(String(value.value)), value.maxLength);
  if (typeof value === "string") return capLength(neutralizeControl(value), DEFAULT_DATA_MAX);
  if (typeof value === "number") return Number.isFinite(value) ? value : null;
  if (typeof value === "boolean" || value === null) return value;
  if (Array.isArray(value)) return value.map((item) => sanitizeJsonValue(item, seen));
  if (typeof value === "object") {
    if (seen.has(value)) throw new Error("render.ts: structured JSON sections cannot contain cycles");
    seen.add(value);
    const record5 = Object.fromEntries(Object.entries(value).map(([key, item]) => [capLength(neutralizeControl(key), DEFAULT_ATTR_MAX), sanitizeJsonValue(item, seen)]));
    seen.delete(value);
    return record5;
  }
  return null;
}
function toJsonResult(result) {
  assertTrustedTag(result.tag);
  const mergedAttrs = mergeAttestationAttrs(result.attrs ?? {}, result.attestation);
  const attrs = Object.fromEntries(
    Object.entries(mergedAttrs).filter(([, v]) => v !== void 0).map(([k, v]) => {
      assertValidAttrKey(k);
      return [k, jsonAttrValue(v)];
    })
  );
  const out = { tag: result.tag, attrs };
  if (result.attestation) {
    out.attestation = {
      kind: result.attestation.kind,
      id: capLength(neutralizeControl(result.attestation.id), DEFAULT_ATTR_MAX),
      path: capLength(neutralizeControl(result.attestation.path), 400),
      note: result.attestation.note ? resolveFactLine(result.attestation.note, "json") : void 0
    };
  }
  if (result.summary) out.summary = resolveFactLine(result.summary, "json");
  if (result.artifacts) out.artifacts = resolveFactLine(result.artifacts, "json");
  if (result.jsonSections !== void 0) out.sections = sanitizeJsonValue(result.jsonSections);
  else if (result.sections?.length) out.sections = result.sections.map((s) => resolveFactLine(s, "json"));
  if (result.followUp) out.followUp = resolveFactLine(result.followUp, "json");
  return out;
}
function emitResult(result, opts = {}) {
  const output = opts.json ? JSON.stringify(toJsonResult(result), null, 2) : renderResult(result);
  process.stdout.write(`${output}
`);
  return output;
}
function formatCoordinate(c) {
  const parts = [line(text`x=`, data(c.x)), line(text`y=`, data(c.y))];
  if (c.w !== void 0) parts.push(line(text`w=`, data(c.w)));
  if (c.h !== void 0) parts.push(line(text`h=`, data(c.h)));
  return joinFactLines(parts, " ");
}
function formatArtifactList(entries) {
  if (entries.length === 0) return text`Artifacts: (none)`;
  const items = entries.map(
    (e) => e.note ? line(data(e.name, 200), text` (`, data(e.note, 400), text`)`) : line(data(e.name, 200))
  );
  return line(text`Artifacts: `, joinFactLines(items, ", "));
}
function formatProvenance(p) {
  const parts = [
    line(text`winning declaration for \``, data(p.selector, 300), text`\``)
  ];
  if (p.source) parts.push(line(text`is \``, data(p.source, 300), text`\``));
  if (p.specificity) parts.push(line(text`specificity `, data(p.specificity, 40)));
  let result = joinFactLines(parts, " ");
  if (p.extra) result = joinFactLines([result, p.extra], " \u2014 ");
  return result;
}
function formatFindings(findings) {
  return findings.map((f, i) => {
    const headlineLine = line(fact`${i + 1}. `, data(f.kind, 60), text` — `, f.headline);
    const detailLines = (f.detail ?? []).map((d) => line(text`   `, d));
    const cropLine = f.artifactPath ? [line(text`   crop: `, data(f.artifactPath, 400))] : [];
    return joinFactLines([headlineLine, ...detailLines, ...cropLine], "\n");
  });
}
