function relativePerformance(timestamp, markers) {
  return timestamp - markers.performanceNowMs;
}
function observerPerformance(event, markers) {
  const timestamp = event.kind === "performance" ? event.startTime ?? event.performanceNowMs ?? event.performanceNow : event.performanceNowMs ?? event.performanceNow ?? event.startTime;
  return finite3(timestamp) ? relativePerformance(timestamp, markers) : null;
}
function tracePerformance(timestampUs, markers) {
  const traceAnchorUs = finite3(markers.traceTimestampUs) ? markers.traceTimestampUs : null;
  const traceAnchorPerf = finite3(markers.tracePerformanceNowMs) ? markers.tracePerformanceNowMs : null;
  if (traceAnchorUs !== null && traceAnchorPerf !== null) return (timestampUs - traceAnchorUs) / 1e3 + relativePerformance(traceAnchorPerf, markers);
  return null;
}
function framePerformance(timestampSec, markers) {
  if (!finite3(markers.wallClockMs)) return null;
  return timestampSec * 1e3 - markers.wallClockMs;
}
function inWindow(point, startMs, endMs) {
  return point.timestampMs >= startMs && (endMs === null || point.timestampMs < endMs);
}
function traceEvents(events, markers, caveats) {
  const output = [];
  for (const event of events) {
    if (event.kind !== "trace" || !Array.isArray(event.events)) continue;
    for (const raw of event.events) {
      if (!raw || typeof raw !== "object") continue;
      const trace2 = raw;
      if (!finite3(trace2.ts) || typeof trace2.name !== "string") continue;
      const timestampMs = tracePerformance(trace2.ts, markers);
      if (timestampMs === null) continue;
      output.push({ name: trace2.name, timestampMs, durationMs: finite3(trace2.dur) ? trace2.dur / 1e3 : void 0 });
    }
  }
  if (events.some((event) => event.kind === "trace") && output.length === 0) {
    caveats.push("trace timing unavailable: markers.json has no real trace timestamp/performance alignment marker; trace-derived response rows are omitted.");
  }
  return output;
}
function inputMarks(events, markers) {
  const seen = /* @__PURE__ */ new Map();
  const marks = [];
  for (const event of events) {
    if (event.kind !== "input" || typeof event.mark !== "string" || !finite3(event.startPerformanceNow)) continue;
    const label2 = typeof event.action === "string" ? event.action : event.mark;
    if (typeof label2 !== "string") continue;
    const occurrence = (seen.get(label2) ?? 0) + 1;
    seen.set(label2, occurrence);
    const startMs = relativePerformance(event.startPerformanceNow, markers);
    const endMs = finite3(event.endPerformanceNow) ? relativePerformance(event.endPerformanceNow, markers) : startMs;
    marks.push({ label: label2, occurrence, startMs, endMs });
  }
  return marks.sort((a, b) => a.startMs - b.startMs || a.occurrence - b.occurrence);
}
function selectAction(actions, action, occurrence) {
  const matches2 = actions.filter((item) => item.label === action);
  if (matches2.length === 0) throw new Error(`No input mark exists for action ${JSON.stringify(action)}.`);
  if (occurrence !== void 0) {
    const match = matches2.find((item) => item.occurrence === occurrence);
    if (match) return match;
    throw new ResponseActionSelectionError(matches2, `Action ${JSON.stringify(action)} has no occurrence ${occurrence}; ${matches2.length} occurrence(s) available.`);
  }
  if (matches2.length === 1) return matches2[0];
  throw new ResponseActionSelectionError(matches2, `Action ${JSON.stringify(action)} appears ${matches2.length} times; pass --occurrence <n> to select one.`);
}
function eventDropCaveats(events) {
  const caveats = [];
  for (const event of events) {
    if (event.kind !== "trace-dropped" && event.kind !== "binding-dropped" && event.kind !== "rect-sample-dropped") continue;
    const dropped = count2(event.count);
    const reason = typeof event.reason === "string" ? event.reason : "unknown reason";
    caveats.push(`${event.kind}: ${dropped ?? "unknown"} record(s) dropped (${reason}); response evidence may be truncated.`);
  }
  return caveats;
}
function frameRecordTime(frame, markers) {
