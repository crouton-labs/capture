function harFilePath(id) {
  if (path6.isAbsolute(id)) return assertUnderCaptureRoot(id);
  if (path6.basename(id) === id) return assertUnderCaptureRoot(path6.resolve(CAPTURE_ROOT, id));
  if (id.endsWith(".json") && id.includes(path6.sep)) return assertUnderCaptureRoot(id);
  return assertUnderCaptureRoot(path6.resolve(id));
}
async function createHarRecording(sessionDir2 = CAPTURE_ROOT) {
  const sessionAbsolute = path6.resolve(sessionDir2);
  assertUnderCaptureRoot(sessionAbsolute);
  const harDir = path6.join(sessionAbsolute, ".har");
  ensurePrivateDir(harDir);
  const header = {
    format: "capture-live-har-ndjson",
    version: 1,
    creator: { name: "capture", version: captureVersion() }
  };
  const headerLine = `${JSON.stringify(header)}
`;
  for (; ; ) {
    const candidate = path6.join(harDir, `${token()}.json`);
    try {
      createPrivateFile(candidate, headerLine);
    } catch (error4) {
      if (error4.code === "EEXIST") continue;
      throw error4;
    }
    return { id: candidate, path: candidate };
  }
}
async function readHarRecording(id) {
  const target = harFilePath(id);
  const source = `live HAR recording ${target}`;
  let raw;
  try {
    raw = readPrivateFile(target).toString("utf8");
  } catch (error4) {
    if (error4.code === "ENOENT") {
      throw new Error(`live HAR recording is missing \u2014 cannot read: ${target}`, { cause: error4 });
    }
    throw error4;
  }
  if (raw.length === 0) fail(source, "store", "is empty \u2014 a live HAR store always begins with its header record");
  if (!raw.endsWith("\n")) fail(source, "store", "ends with an unterminated record \u2014 the store is corrupt");
  const lines = raw.slice(0, -1).split("\n");
  const parseLine = (line4, index) => {
    if (line4.length === 0) fail(source, `store line ${index + 1}`, "is empty");
    try {
      return JSON.parse(line4);
    } catch {
      return fail(source, `store line ${index + 1}`, "is not valid JSON");
    }
  };
  const header = vStoreHeader(parseLine(lines[0], 0), source);
  const entries = [];
  const incompleteLifecycles = [];
  for (let i = 1; i < lines.length; i++) {
    const batch = validateHarAppendBatch(parseLine(lines[i], i), `${source} line ${i + 1}`);
    entries.push(...batch.entries);
    incompleteLifecycles.push(...batch.incompleteLifecycles);
  }
  return {
    log: { version: "1.2", creator: header.creator, entries },
    incompleteLifecycles
  };
}
async function appendToHarRecording(id, batch) {
  if (batch.entries.length === 0 && batch.incompleteLifecycles.length === 0) return;
  const safeBatch = validateHarAppendBatch(batch, `har append batch ${id}`);
  const target = harFilePath(id);
  try {
    appendPrivateFile(target, `${JSON.stringify(safeBatch)}
`);
  } catch (error4) {
    if (error4.code === "ENOENT") {
      throw new Error(`live HAR recording is missing \u2014 cannot append: ${target}`, { cause: error4 });
    }
    throw error4;
  }
}
async function deleteHarRecording(id) {
  unlinkPrivateFile(harFilePath(id));
}
