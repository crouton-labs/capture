              setSyntheticLeadingComments(result, [{
                text: `*
${newComment.split("\n").map((c) => ` * ${c}`).join("\n")}
 `,
                kind: 3,
                pos: -1,
                end: -1,
                hasTrailingNewLine: true,
                hasLeadingNewline: true
              }]);
            }
          }
          return result;
        }
