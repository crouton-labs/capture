// src/cdp/motion/mask.ts
function createMotionMask(ref) {
  const framesDir = recordingArtifactPath(ref, "frames");
  if (!fs33.statSync(framesDir).isDirectory()) {
    throw new Error(`Recording ${ref.id} has frames but ${framesDir} is not a directory; create a finalized recording with \`capture motion rec\`.`);
  }
  const allFrameFiles = fs33.readdirSync(framesDir).filter((name) => name.endsWith(".png")).sort((a, b) => a.localeCompare(b, void 0, { numeric: true }));
  if (allFrameFiles.length < 2) {
    throw new Error(`Recording ${ref.id} has ${allFrameFiles.length} frame PNG(s) at ${framesDir}; motion mask needs at least two frames. Record again with \`capture motion rec\`.`);
  }
  const dims = allFrameFiles.map((name) => readPngDimensions(path38.join(framesDir, name)));
  const run = longestSameSizeRun(dims);
  if (run.length < 2) {
    throw new Error(`Recording ${ref.id} has no contiguous run of two or more same-size frames at ${framesDir}; every adjacent frame pair differs in viewport size, so a motion composite cannot be built. Record again at one viewport size with \`capture motion rec\`.`);
  }
  const frameFiles = allFrameFiles.slice(run.start, run.start + run.length);
  const runDims = dims[run.start];
  const excludedCount = allFrameFiles.length - frameFiles.length;
  const caveat = excludedCount > 0 ? `Partial-window fallback: recorded frames span more than one viewport size. Composite and region facts cover only the longest contiguous same-size run \u2014 frames ${run.start}\u2013${run.start + run.length - 1} (${frameFiles[0]}\u2013${frameFiles[frameFiles.length - 1]}) at ${runDims.width}\xD7${runDims.height}. ${excludedCount} frame(s) outside this run were excluded; some may share these dimensions.` : void 0;
  const runFiles = new Set(frameFiles);
  const rectRecords = readRects(ref).sort((a, b) => a.frame - b.frame);
  const recordsByFile = new Map(rectRecords.filter((record5) => record5.file && runFiles.has(record5.file)).map((record5) => [record5.file, record5]));
  const meta = readMeta(ref);
  const outputPath = path38.join(ref.dir, "motion-mask.png");
  const workDir = path38.join(ref.dir, ".motion-mask-work");
  ensurePrivateDir(workDir);
  try {
    let width = 0;
    let height = 0;
    let composite2;
    const samples = [];
    for (let pair = 0; pair < frameFiles.length - 1; pair++) {
      const before = path38.join(framesDir, frameFiles[pair]);
      const after = path38.join(framesDir, frameFiles[pair + 1]);
      const diffPath = path38.join(workDir, `pair-${String(pair).padStart(6, "0")}.png`);
      const outcome = diffPngs(before, after, diffPath, { diffMask: true });
      if (!outcome.ok) {
        throw new Error(`Frame dimensions differ between ${frameFiles[pair]} (${outcome.before.width}x${outcome.before.height}) and ${frameFiles[pair + 1]} (${outcome.after.width}x${outcome.after.height}); a motion composite requires one viewport size.`);
      }
      if (!composite2) {
        width = outcome.width;
        height = outcome.height;
        composite2 = new import_pngjs8.PNG({ width, height, fill: true });
      }
      const diff = import_pngjs8.PNG.sync.read(fs33.readFileSync(diffPath));
      const pixels = [];
      for (let y = 0; y < height; y++) {
        for (let x = 0; x < width; x++) {
          const offset = (y * width + x) * 4;
          if (diff.data[offset + 3] === 0) continue;
          pixels.push({ x, y });
          const [r, g, b] = hueForPair(pair, frameFiles.length - 2);
          composite2.data[offset] = r;
          composite2.data[offset + 1] = g;
          composite2.data[offset + 2] = b;
          composite2.data[offset + 3] = 255;
        }
      }
      samples.push({ pair, pixels });
    }
    if (!composite2) throw new Error(`Recording ${ref.id} had no readable frame pairs.`);
    writeBinaryPrivate(outputPath, import_pngjs8.PNG.sync.write(composite2));
    const { components, labels } = connectedComponents(composite2, width, height);
    const stats = computeComponentStats(components, labels, width, height, samples, recordsByFile);
    const durationMs = finiteNumber(meta.durationMs) ?? 0;
    const regions = components.map((component, index) => regionForComponent(
      component,
      index + 1,
      stats[index],
      frameFiles,
      recordsByFile,
      durationMs,
      run.start,
      allFrameFiles.length
    ));
    return { outputPath, width, height, comparedFramePairs: samples.length, regions, caveat };
  } finally {
    fs33.rmSync(workDir, { recursive: true, force: true });
  }
}
function readPngDimensions(file) {
  const fd = fs33.openSync(file, "r");
  try {
    const header = Buffer.alloc(24);
    fs33.readSync(fd, header, 0, 24, 0);
    return { width: header.readUInt32BE(16), height: header.readUInt32BE(20) };
  } finally {
    fs33.closeSync(fd);
  }
}
function longestSameSizeRun(dims) {
  let bestStart = 0;
  let bestLength = dims.length ? 1 : 0;
  let runStart = 0;
  for (let i = 1; i < dims.length; i++) {
    if (dims[i].width !== dims[i - 1].width || dims[i].height !== dims[i - 1].height) runStart = i;
    const length = i - runStart + 1;
    if (length > bestLength) {
      bestLength = length;
      bestStart = runStart;
    }
  }
  return { start: bestStart, length: bestLength };
}
function recordingArtifactPath(ref, filename) {
  try {
    return artifactPath(ref, filename);
  } catch (err) {
    const detail = err instanceof Error ? err.message : String(err);
    throw new Error(`${detail} \u2014 create a finalized recording with \`capture motion rec\`.`);
  }
}
function connectedComponents(composite2, width, height) {
  const seen = new Uint8Array(width * height);
  const components = [];
  for (let start2 = 0; start2 < seen.length; start2++) {
    if (seen[start2] || composite2.data[start2 * 4 + 3] === 0) continue;
    const pixels = [];
    const queue = [start2];
    seen[start2] = 1;
    while (queue.length) {
      const current = queue.pop();
      const x = current % width;
      const y = Math.floor(current / width);
      pixels.push({ x, y });
      for (const [dx, dy] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) {
        const nx = x + dx;
        const ny = y + dy;
        const next = ny * width + nx;
        if (nx < 0 || ny < 0 || nx >= width || ny >= height || seen[next] || composite2.data[next * 4 + 3] === 0) continue;
        seen[next] = 1;
        queue.push(next);
      }
    }
    components.push({ pixels });
  }
  components.sort((a, b) => b.pixels.length - a.pixels.length);
  const labels = new Int32Array(width * height).fill(-1);
  components.forEach((component, index) => {
    for (const pixel of component.pixels) labels[pixel.y * width + pixel.x] = index;
  });
  return { components, labels };
}
function computeComponentStats(components, labels, width, height, samples, recordsByFile) {
  const activeCentroids = components.map(() => []);
  for (const sample of samples) {
    const sums = /* @__PURE__ */ new Map();
    for (const pixel of sample.pixels) {
      const label2 = labels[pixel.y * width + pixel.x];
      if (label2 < 0) continue;
      const acc = sums.get(label2);
      if (acc) {
        acc.sx += pixel.x;
        acc.sy += pixel.y;
        acc.n++;
      } else {
        sums.set(label2, { sx: pixel.x, sy: pixel.y, n: 1 });
      }
    }
    for (const [label2, acc] of sums) {
      activeCentroids[label2].push({ pair: sample.pair, cx: acc.sx / acc.n, cy: acc.sy / acc.n });
    }
  }
  const candidates = components.map(() => /* @__PURE__ */ new Map());
  for (const record5 of recordsByFile.values()) {
    for (const element of record5.elements ?? []) {
      if (![element.x, element.y, element.width, element.height].every((value) => typeof value === "number" && Number.isFinite(value))) continue;
      const key = typeof element.backendNodeId === "number" ? `backend:${element.backendNodeId}` : elementLabel2(element);
      const transformed = deviceRect(element, record5.cssToDevice);
      if (!transformed) continue;
      const x0 = Math.max(0, Math.floor(transformed.x));
      const x1 = Math.min(width, Math.ceil(transformed.x + transformed.width));
      const y0 = Math.max(0, Math.floor(transformed.y));
      const y1 = Math.min(height, Math.ceil(transformed.y + transformed.height));
      const area2 = (x1 - x0) * (y1 - y0);
      if (area2 <= 0) continue;
      const overlaps2 = /* @__PURE__ */ new Map();
      for (let py = y0; py < y1; py++) {
        const rowBase = py * width;
        for (let px2 = x0; px2 < x1; px2++) {
          const label2 = labels[rowBase + px2];
          if (label2 >= 0) overlaps2.set(label2, (overlaps2.get(label2) ?? 0) + 1);
        }
      }
      for (const [label2, overlap] of overlaps2) {
        const map = candidates[label2];
        const existing = map.get(key);
        if (existing) {
          existing.overlap += overlap;
          existing.area += area2;
        } else {
          map.set(key, { element, overlap, area: area2 });
        }
      }
    }
  }
  return components.map((_, index) => ({
    attribution: [...candidates[index].values()].sort((a, b) => b.overlap / b.area - a.overlap / a.area || b.overlap - a.overlap)[0] ?? null,
    activeCentroids: activeCentroids[index]
  }));
}
function regionForComponent(component, index, stats, frameFiles, recordsByFile, durationMs, runStart, totalFrames) {
  let x = Infinity;
  let y = Infinity;
  let right = -Infinity;
  let bottom = -Infinity;
  for (const pixel of component.pixels) {
    if (pixel.x < x) x = pixel.x;
    if (pixel.x > right) right = pixel.x;
    if (pixel.y < y) y = pixel.y;
    if (pixel.y > bottom) bottom = pixel.y;
  }
  const { attribution, activeCentroids } = stats;
  const startPair = activeCentroids[0]?.pair ?? 0;
  const endPair = activeCentroids.at(-1)?.pair ?? startPair;
  const startMs = timestampForPair(startPair, frameFiles, recordsByFile, durationMs, runStart, totalFrames);
  const endMs = timestampForPair(endPair + 1, frameFiles, recordsByFile, durationMs, runStart, totalFrames);
  const rectDistance = attribution ? distanceForElement(attribution.element, recordsByFile) : null;
  const pixelDistance = activeCentroids.slice(1).reduce((total, center, i) => total + Math.hypot(center.cx - activeCentroids[i].cx, center.cy - activeCentroids[i].cy), 0);
  const distancePx = round2(rectDistance ?? pixelDistance);
  const elapsedSeconds = Math.max(0, endMs - startMs) / 1e3;
  return {
    index,
    x,
    y,
    width: right - x + 1,
    height: bottom - y + 1,
    areaPixels: component.pixels.length,
    distancePx,
    velocityPxPerSecond: round2(elapsedSeconds > 0 ? distancePx / elapsedSeconds : 0),
    startMs: round2(startMs),
    endMs: round2(endMs),
    element: attribution ? { label: elementLabel2(attribution.element), ...typeof attribution.element.backendNodeId === "number" ? { backendNodeId: attribution.element.backendNodeId } : {} } : void 0
  };
}
function distanceForElement(target, recordsByFile) {
  const key = typeof target.backendNodeId === "number" ? `backend:${target.backendNodeId}` : elementLabel2(target);
  const centers = [];
  for (const record5 of [...recordsByFile.values()].sort((a, b) => a.frame - b.frame)) {
    const element = (record5.elements ?? []).find((candidate) => (typeof candidate.backendNodeId === "number" ? `backend:${candidate.backendNodeId}` : elementLabel2(candidate)) === key);
    const rect3 = element ? deviceRect(element, record5.cssToDevice) : null;
    if (!rect3) continue;
    centers.push({ x: rect3.x + rect3.width / 2, y: rect3.y + rect3.height / 2 });
  }
  if (centers.length < 2) return null;
  return centers.slice(1).reduce((total, center, i) => total + Math.hypot(center.x - centers[i].x, center.y - centers[i].y), 0);
}
function timestampForPair(pair, frameFiles, recordsByFile, durationMs, runStart, totalFrames) {
  const record5 = recordsByFile.get(frameFiles[Math.min(pair, frameFiles.length - 1)]);
  const first = recordsByFile.get(frameFiles[0])?.screencastTimestamp;
  if (typeof record5?.screencastTimestamp === "number" && typeof first === "number") return (record5.screencastTimestamp - first) * 1e3;
  return totalFrames > 1 ? (runStart + pair) / (totalFrames - 1) * durationMs : 0;
}
function deviceRect(element, transform) {
  if (![element.x, element.y, element.width, element.height].every((value) => typeof value === "number" && Number.isFinite(value))) return null;
  const scaleX = transform?.scaleX;
  const scaleY = transform?.scaleY;
  if (typeof scaleX !== "number" || !Number.isFinite(scaleX) || scaleX <= 0 || typeof scaleY !== "number" || !Number.isFinite(scaleY) || scaleY <= 0) return null;
  return { x: element.x * scaleX, y: element.y * scaleY, width: element.width * scaleX, height: element.height * scaleY };
}
function elementLabel2(element) {
  const tag = element.tag || "element";
  const id = element.id ? `#${element.id}` : "";
  const classes = element.classes ? `.${element.classes.trim().split(/\s+/).filter(Boolean).join(".")}` : "";
  return `${tag}${id}${classes}`;
}
function hueForPair(pair, pairs) {
  const hue = 220 * (1 - (pairs <= 1 ? 1 : pair / (pairs - 1)));
  const c = 1;
  const x = c * (1 - Math.abs(hue / 60 % 2 - 1));
  const [r, g, b] = hue < 60 ? [c, x, 0] : hue < 120 ? [x, c, 0] : hue < 180 ? [0, c, x] : [0, x, c];
  return [Math.round(r * 255), Math.round(g * 255), Math.round(b * 255)];
}
function finiteNumber(value) {
  return typeof value === "number" && Number.isFinite(value) ? value : null;
}
function round2(value) {
  return Math.round(value * 100) / 100;
}
