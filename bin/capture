            }
            if (tryConsumeDeclare() || tryConsumeImport() || tryConsumeExport() || detectJavaScriptImports && (tryConsumeRequireCall(
              /*skipCurrentToken*/
              false,
              /*allowTemplateLiterals*/
              true
