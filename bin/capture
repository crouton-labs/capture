function isPlainObject2(value) {
  return value !== null && typeof value === "object" && (Object.getPrototypeOf(value) === Object.prototype || Object.getPrototypeOf(value) === null);
}
function truncateWebSocketData(data32) {
  const size = Buffer.byteLength(data32, "utf8");
  if (size <= MAX_WS_FRAME_SIZE) return data32;
  let end = Math.min(data32.length, MAX_WS_FRAME_SIZE);
  while (end > 0 && Buffer.byteLength(data32.slice(0, end), "utf8") > MAX_WS_FRAME_SIZE) end--;
  return data32.slice(0, end) + `\u2026[truncated: ${size} bytes]`;
}
function fail2(message) {
  throw new Error(`Malformed owned Network event: ${message}`);
}
function nonempty(value, name) {
  if (typeof value !== "string" || value.length === 0) fail2(name);
  return value;
}
function finite(value, name) {
  if (typeof value !== "number" || !Number.isFinite(value) || value < 0) fail2(name);
  return value;
}
function headers(value, name) {
  if (!isPlainObject2(value)) fail2(name);
  return Object.entries(value).map(([headerName, headerValue]) => {
    if (typeof headerValue !== "string") fail2(`${name}.${headerName}`);
    return { name: headerName, value: headerValue };
  });
}
function wallTime(value) {
  if (typeof value !== "number" || !Number.isFinite(value)) fail2("wallTime");
  try {
    return { seconds: value, iso: new Date(value * 1e3).toISOString() };
  } catch {
    fail2("wallTime is outside the ISO date range");
  }
}
function captureVersion2() {
  const version = "1.4.15";
  return typeof version === "string" && version.length > 0 ? version : "development";
}
function deepFreeze(value) {
  if (value && typeof value === "object" && !Object.isFrozen(value)) {
    Object.freeze(value);
    for (const child of Object.values(value)) deepFreeze(child);
  }
  return value;
}
function same(a, b) {
  return JSON.stringify(a) === JSON.stringify(b);
}
function textPrefix(text2) {
  let bytes = 0;
  let end = 0;
  for (const scalar of text2) {
    const size = Buffer.byteLength(scalar, "utf8");
    if (bytes + size > MAX_BODY_SIZE) break;
    bytes += size;
    end += scalar.length;
  }
  return { text: text2.slice(0, end), bytes };
}
function strictBase64(text2) {
  if (!/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(text2)) {
    throw new Error("Network.getResponseBody returned malformed base64");
  }
  return Buffer.from(text2, "base64");
}
