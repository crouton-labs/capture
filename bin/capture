function numeric(value) {
  return typeof value === "number" && Number.isFinite(value) ? value : void 0;
}
function numberText(value) {
  const n = numeric(value);
  return n === void 0 ? text`unavailable` : data(n);
}
function string(value, fallback = "(unavailable)") {
  return typeof value === "string" ? value : fallback;
}
function rect(value) {
  if (!value || typeof value !== "object") return void 0;
  const x = numeric(value.x);
  const y = numeric(value.y);
  const w = numeric(value.w ?? value.width);
  const h = numeric(value.h ?? value.height);
  if (x === void 0 || y === void 0 || w === void 0 || h === void 0) return void 0;
  return { x, y, w, h };
}
function formatRect2(value) {
  const measured = rect(value);
  return measured ? fact`x=${measured.x} y=${measured.y} w=${measured.w} h=${measured.h}` : text`rect unavailable`;
}
function formatDimension(width, height) {
  return line(numberText(width), text`×`, numberText(height));
}
function viewportFacts(label2, value, unavailable) {
  if (unavailable === true) return fact`${label2}: viewport metrics unavailable in Page.getLayoutMetrics.`;
  if (!value || typeof value !== "object") return fact`${label2}: unavailable`;
  const viewport2 = value;
  return line(
    data(label2),
    text`: client `,
    formatDimension(viewport2.clientWidth, viewport2.clientHeight),
    text` at page x=`,
    numberText(viewport2.pageX),
    text` y=`,
    numberText(viewport2.pageY),
    text` scale=`,
    numberText(viewport2.scale)
  );
}
function backendNodeId(value) {
  return typeof value === "number" && Number.isFinite(value) ? value : void 0;
}
function explicitElementId(value) {
  return typeof value === "string" && value.length > 0 ? value : void 0;
