var init_diff = __esm({
  "src/output/diff.ts"() {
    fs26 = __toESM(require("node:fs"));
    path31 = __toESM(require("node:path"));
    import_pngjs5 = __toESM(require_png());
    init_pixelmatch();
    DEFAULT_THRESHOLD = 0.1;
  }
});

