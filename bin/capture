function isSelfOrDescendant(target, receiver) {
  if (target.backendNodeId != null && target.backendNodeId === receiver.backendNodeId) return true;
  return target.domPath !== void 0 && receiver.domPath !== void 0 && receiver.domPath.startsWith(`${target.domPath}/`);
