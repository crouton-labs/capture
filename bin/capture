            if (names) {
              const duplicates = [];
              const uniqueNames = /* @__PURE__ */ new Set();
              for (let i = 0; i < names.length; i++) {
                const name = names[i];
                if (!tryAddToSet(uniqueNames, name)) {
                  duplicates.push(i);
                }
              }
              const counters = /* @__PURE__ */ new Map();
