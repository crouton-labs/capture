                pos,
                /*isEmittedNode*/
                node.kind !== 354
                /* NotEmittedStatement */
              );
            }
            if (!skipLeadingComments || pos >= 0 && (emitFlags & 1024) !== 0) {
              containerPos = pos;
            }
