// src/session/coordinator.ts
function scopeLifecycleLockPath() {
  return path5.join(CAPTURE_ROOT, `.session-lifecycle-${process.env.CRTR_NODE_ID ?? "default"}`);
}
async function withSessionScopeLifecycle(action) {
  const lock = await acquirePrivateLock(scopeLifecycleLockPath(), {
    acquireTimeoutMs: 12e4,
    leaseMs: 1e3
  });
  try {
    return await action();
  } finally {
    lock.release();
  }
}
function statePath(sessionDir2) {
  return path5.join(assertUnderCaptureRoot(sessionDir2), ".operations.json");
}
function lockPath(sessionDir2) {
  return path5.join(assertUnderCaptureRoot(sessionDir2), ".operations.lock");
}
function isBirth(value) {
  if (!value || typeof value !== "object" || Array.isArray(value)) return false;
  const birth = value;
  return birth.provider === "linux-proc-v1" && typeof birth.bootId === "string" && typeof birth.startTicks === "string" || birth.provider === "darwin-kern-proc-v1" && typeof birth.startSec === "string" && Number.isSafeInteger(birth.startUsec);
}
function isOperationOwner(value) {
  if (!value || typeof value !== "object" || Array.isArray(value)) return false;
  const owner = value;
  return typeof owner.token === "string" && Number.isSafeInteger(owner.pid) && owner.pid > 0 && isBirth(owner.birth);
}
function readState(sessionDir2) {
  try {
    const value = JSON.parse(readPrivateFile(statePath(sessionDir2)).toString("utf-8"));
    if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error("malformed session operation state");
    const record5 = value;
    if (typeof record5.stopping !== "boolean" || !Array.isArray(record5.tokens) || !record5.tokens.every(isOperationOwner)) {
      throw new Error("malformed session operation state");
    }
    return { stopping: record5.stopping, tokens: [...record5.tokens] };
  } catch (error4) {
    if (error4.code === "ENOENT") return { stopping: false, tokens: [] };
    throw error4;
  }
}
async function withStateLock(sessionDir2, action) {
  const lock = await acquirePrivateLock(lockPath(sessionDir2), { acquireTimeoutMs: 3e4, leaseMs: 500 });
  try {
    const state = readState(sessionDir2);
    const result = action(state);
    writeJsonPrivate(statePath(sessionDir2), state);
    return result;
  } finally {
    lock.release();
  }
}
async function admitSessionOperation(sessionDir2) {
  const token2 = crypto3.randomBytes(18).toString("hex");
  const observed = processPidBirthProvider.read(process.pid);
  if (observed.status !== "found") throw new Error(`cannot identify session operation owner: ${observed.status === "unknown" ? observed.reason : "process absent"}`);
  const owner = { token: token2, pid: process.pid, birth: observed.identity };
  await withStateLock(sessionDir2, (state) => {
    if (state.stopping) throw captureError("precondition", "session_stopping", "This session is stopping; start a new operation after `session stop` finalizes.");
    state.tokens.push(owner);
  });
  let released = false;
  return {
    token: token2,
    async release() {
      if (released) return;
      await withStateLock(sessionDir2, (state) => {
        state.tokens = state.tokens.filter((candidate) => candidate.token !== token2);
      });
      released = true;
    }
  };
}
async function beginSessionStop(sessionDir2) {
  const stopLock = await acquirePrivateLock(path5.join(assertUnderCaptureRoot(sessionDir2), ".stop.lock"), {
    acquireTimeoutMs: 12e4,
    leaseMs: 1e3
  });
  try {
    await withStateLock(sessionDir2, (state) => {
      state.stopping = true;
    });
    for (; ; ) {
      const pending = await withStateLock(sessionDir2, (state) => {
        state.tokens = state.tokens.filter((owner) => {
          const observed = processPidBirthProvider.read(owner.pid);
          if (observed.status === "unknown") throw new Error(`cannot establish session operation owner liveness: ${observed.reason}`);
          return observed.status === "found" && sameBirth(observed.identity, owner.birth);
        });
        return state.tokens.length;
      });
      if (pending === 0) break;
      await new Promise((resolve12) => setTimeout(resolve12, 10));
    }
  } catch (error4) {
    stopLock.release();
    throw error4;
  }
  let finished = false;
  return {
    async finish(success) {
      if (finished) return;
      try {
        if (!success) await withStateLock(sessionDir2, (state) => {
          state.stopping = false;
        });
      } finally {
        stopLock.release();
        finished = true;
      }
    }
  };
}
async function withSessionLifecycle(sessionDir2, action, seams2 = {}) {
  const lock = await acquirePrivateLock(path5.join(assertUnderCaptureRoot(sessionDir2), ".lifecycle.lock"), {
    acquireTimeoutMs: seams2.acquireTimeoutMs ?? 3e4,
    leaseMs: seams2.leaseMs ?? 3e4,
    pidBirthProvider: seams2.pidBirthProvider,
    nowNs: seams2.nowNs,
    sleep: seams2.sleep,
    token: seams2.token
  });
  try {
    return await action();
  } finally {
    lock.release();
  }
}
