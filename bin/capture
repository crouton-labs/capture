    if (rangeUs !== void 0) subpartsMs[name] = rangeUs / 1e3;
  }
  const attribution = {
    ...string2(eventData?.nodeName) === void 0 ? {} : { element: string2(eventData?.nodeName) },
    ...finite4(eventData?.nodeId) === void 0 ? {} : { nodeId: finite4(eventData?.nodeId) },
