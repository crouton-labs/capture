  "src/session/har-redact.ts"() {
    REDACTED_VALUE = "REDACTED";
    CREDENTIAL_NAMES = /* @__PURE__ */ new Set([
      "key",
      "apikey",
      "accesskey",
      "secretkey",
      "privatekey",
      "sig",
      "signature",
      "auth",
      "authorization",
      "credential",
      "credentials",
