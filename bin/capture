        if (!connectionReused) {
          roundTrips += 1;
          if (!request.protocol.startsWith("h3")) {
            roundTrips += 1;
          }
          if (request.parsedURL.scheme === "https") {
            roundTrips += 1;
          }
        }
        return Math.max((timing2.receiveHeadersEnd - estimatedServerResponseTime) / roundTrips, 3);
      }
      /**
