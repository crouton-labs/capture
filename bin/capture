function socketDir(create) {
  return create ? ensurePrivateDir(LOG_TAILER_SOCKET_DIR) : LOG_TAILER_SOCKET_DIR;
}
function socketPathForToken(token2, createDir) {
  if (!LOG_TAILER_SOCKET_TOKEN.test(token2)) throw new Error("invalid log tailer socket token");
  return path8.join(socketDir(createDir), `${token2}.sock`);
}
function requireRegisteredLogTailer(value) {
  const record5 = parseRegisteredLogTailer(value);
  if (!record5) throw captureError("artifact", "invalid_log_tailer_record", "Session metadata contains an invalid log tailer registration.");
  return record5;
}
function readRequiredBirth(provider, pid) {
  const observed = provider.read(pid);
  if (observed.status === "found") return observed.identity;
  const detail = observed.status === "unknown" ? observed.reason : "process absent";
  throw captureError("internal", "log_tailer_identity_failed", `Could not establish log tailer birth identity: ${detail}.`);
}
function ownership(record5, provider) {
  const observed = provider.read(record5.pid);
  if (observed.status === "unknown") {
    throw captureError("cleanup", "log_tailer_identity_unknown", `Could not establish log tailer pid ${record5.pid} identity: ${observed.reason}.`);
  }
  return observed.status === "found" && sameBirth(observed.identity, record5.birth) ? "same" : "gone";
}
function socketIdentity(socketPath) {
  const stat = fs6.lstatSync(socketPath, { bigint: true });
  if (!stat.isSocket()) throw new Error(`log tailer control path is not a socket: ${socketPath}`);
  return { dev: stat.dev.toString(), ino: stat.ino.toString() };
}
function unlinkRecordedSocket(record5) {
  let current;
  try {
    current = fs6.lstatSync(record5.socketPath, { bigint: true });
  } catch (error4) {
    if (error4.code === "ENOENT") return;
    throw error4;
  }
  if (!current.isSocket() || current.dev.toString() !== record5.socketDev || current.ino.toString() !== record5.socketIno) return;
  fs6.unlinkSync(record5.socketPath);
}
function closeOwnedFd(fd) {
  if (fd !== void 0) fs6.closeSync(fd);
  return void 0;
}
function awaitChildExit(child, timeoutMs) {
  if (child.exitCode !== null || child.signalCode !== null) return Promise.resolve(true);
  return new Promise((resolve12) => {
    let settled = false;
    const finish = (value) => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      child.removeListener("exit", onGone);
      child.removeListener("error", onGone);
      resolve12(value);
    };
    const onGone = () => finish(true);
    const timer = setTimeout(() => finish(false), timeoutMs);
    child.once("exit", onGone);
    child.once("error", onGone);
  });
}
async function terminateOwnedGroup(child, pid, birth, provider) {
  const canSignal = () => {
    if (!birth) return child.exitCode === null && child.signalCode === null;
    return ownership({ pid, birth }, provider) === "same";
  };
  let signalError;
  const signalGroup = (signal) => {
    if (!canSignal()) return;
    try {
      process.kill(-pid, signal);
    } catch (error4) {
      if (error4.code !== "ESRCH") signalError = error4;
    }
  };
  signalGroup("SIGTERM");
  if (await awaitChildExit(child, 1e3)) return;
  signalGroup("SIGKILL");
  if (await awaitChildExit(child, 2e3)) return;
  if (birth && ownership({ pid, birth }, provider) === "gone") return;
  throw captureError("cleanup", "log_tailer_rollback_failed", `Could not reap log tailer process group ${pid}.`, signalError);
}
function awaitReadiness(child, timeoutMs) {
  return new Promise((resolve12, reject) => {
    const pipe = child.stdio[READINESS_FD];
    if (!pipe) {
      reject(new Error("log tailer readiness pipe was not created"));
      return;
    }
    let input = "";
    let settled = false;
    const finish = (action) => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      pipe.removeListener("data", onData);
      pipe.removeListener("error", onError);
      pipe.removeListener("end", onEnd);
      child.removeListener("error", onError);
      child.removeListener("exit", onExit);
      try {
        pipe.destroy?.();
      } catch {
      }
      action();
    };
    const onData = (chunk) => {
      input += chunk.toString("utf-8");
      if (input.length > CONTROL_MESSAGE_LIMIT) {
        finish(() => reject(new Error("log tailer readiness response exceeded its bound")));
        return;
      }
      const newline = input.indexOf("\n");
      if (newline >= 0) finish(() => resolve12(input.slice(0, newline).trim()));
    };
    const onError = (error4) => finish(() => reject(error4));
    const onEnd = () => finish(() => reject(new Error("log tailer readiness pipe closed without a response")));
    const onExit = () => finish(() => reject(new Error("log tailer exited before signalling readiness")));
    const timer = setTimeout(() => finish(() => reject(new Error(`log tailer did not signal readiness within ${timeoutMs}ms`))), timeoutMs);
    pipe.on("data", onData);
    pipe.once("error", onError);
    pipe.once("end", onEnd);
    child.once("error", onError);
    child.once("exit", onExit);
  });
}
async function startSessionLogTailer(options) {
  const logsDir = ensurePrivateDir(path8.join(options.sessionDir, "logs"));
  const destPath = path8.join(logsDir, `${options.name}.log`);
  const socketToken = crypto6.randomBytes(8).toString("hex");
  const socketPath = socketPathForToken(socketToken, true);
  const nonce = crypto6.randomBytes(24).toString("hex");
  let destFd;
  let child;
  let pid;
  let birth;
  let registered;
  try {
    destFd = openPrivateAppendFd(destPath);
    child = (0, import_node_child_process3.spawn)(
      process.execPath,
      [...world.entryArgv(), "__log-tail-serve", "--source", options.sourcePath, "--socket-token", socketToken, "--confirm-timeout", String(world.confirmTimeoutMs), "--orphan-check", String(world.orphanCheckIntervalMs)],
      {
        detached: true,
        shell: false,
        stdio: ["ignore", destFd, "ignore", "pipe"],
        env: { ...process.env, CAPTURE_LOG_TAIL_NONCE: nonce }
      }
    );
    child.on("error", () => {
    });
    pid = child.pid;
    if (!pid) throw captureError("internal", "log_tailer_spawn_failed", "Failed to spawn the session log tailer process.");
    destFd = closeOwnedFd(destFd);
    birth = readRequiredBirth(world.pidBirthProvider, pid);
    const response = await awaitReadiness(child, world.readinessTimeoutMs);
    if (response !== "ready") {
      const detail = response.replace(/^error:\s*/, "");
      throw captureError("internal", "log_tailer_startup_failed", `Log tailer failed to start: ${detail}`);
    }
    const currentBirth = readRequiredBirth(world.pidBirthProvider, pid);
    if (!sameBirth(birth, currentBirth)) {
      throw captureError("internal", "log_tailer_identity_changed", "Log tailer identity changed before registration.");
    }
    world.beforeParentSocketIdentity?.(socketPath);
    let socket;
    try {
      socket = socketIdentity(socketPath);
    } catch (error4) {
      if (error4.code !== "ENOENT") throw error4;
      socket = { dev: "0", ino: "0" };
    }
    const record5 = {
      pid,
      name: options.name,
      sourcePath: options.sourcePath,
      birth,
      socketPath,
      socketDev: socket.dev,
      socketIno: socket.ino,
      nonce
    };
    await options.register(record5);
    registered = record5;
    let confirmed = false;
    try {
      confirmed = await requestControl(socketPath, nonce, "confirm", world.readinessTimeoutMs);
    } catch {
    }
    if (!confirmed) {
      throw captureError("internal", "log_tailer_confirm_failed", "Log tailer did not acknowledge its registration confirmation.");
    }
    child.unref();
    return { destPath, pid };
  } catch (primary) {
    const cleanup = [];
    let workerGone = true;
    if (child && pid) {
      try {
        await terminateOwnedGroup(child, pid, birth, world.pidBirthProvider);
      } catch (error4) {
        workerGone = false;
        cleanup.push(error4);
      }
    }
    if (registered && workerGone) {
      try {
        await options.unregister(registered);
      } catch (error4) {
        cleanup.push(error4);
      }
    }
    if (destFd !== void 0) {
      try {
        destFd = closeOwnedFd(destFd);
      } catch (error4) {
        cleanup.push(error4);
      }
    }
    if (cleanup.length) throw new AggregateError([primary, ...cleanup], "Log tailer startup failed and rollback was incomplete.");
    throw primary;
  }
}
async function waitUntilGone(record5, provider, timeoutMs) {
  const deadline = Date.now() + timeoutMs;
  for (; ; ) {
    if (ownership(record5, provider) === "gone") return true;
    if (Date.now() >= deadline) return false;
    await new Promise((resolve12) => setTimeout(resolve12, 25));
  }
}
async function requestControl(socketPath, nonce, op, timeoutMs) {
  return new Promise((resolve12, reject) => {
    const connection = net2.createConnection(socketPath);
    let input = "";
    let settled = false;
    const finish = (action) => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      connection.destroy();
      action();
    };
    const timer = setTimeout(() => finish(() => reject(new Error(`log tailer ${op} timed out`))), timeoutMs);
    connection.setEncoding("utf-8");
    connection.on("connect", () => connection.write(`${JSON.stringify({ nonce, op })}
`));
    connection.on("data", (chunk) => {
      input += chunk;
      if (input.length > CONTROL_MESSAGE_LIMIT) {
        finish(() => reject(new Error(`log tailer ${op} response exceeded its bound`)));
        return;
      }
      const newline = input.indexOf("\n");
      if (newline < 0) return;
      let ok = false;
      try {
        ok = JSON.parse(input.slice(0, newline)).ok === true;
      } catch {
      }
      finish(() => resolve12(ok));
    });
    connection.on("error", (error4) => finish(() => reject(error4)));
    connection.on("close", () => finish(() => reject(new Error(`log tailer ${op} connection closed without a reply`))));
  });
}
async function stopOne(record5, provider) {
  if (ownership(record5, provider) === "gone") {
    unlinkRecordedSocket(record5);
    return;
  }
  let acknowledged = false;
  try {
    acknowledged = await requestControl(record5.socketPath, record5.nonce, "drain", Math.min(1e3, world.teardownWaitMs));
  } catch {
  }
  if (acknowledged && await waitUntilGone(record5, provider, world.teardownWaitMs)) {
    unlinkRecordedSocket(record5);
    return;
  }
  if (ownership(record5, provider) === "gone") {
    unlinkRecordedSocket(record5);
    return;
  }
  try {
    process.kill(-record5.pid, "SIGTERM");
  } catch (error4) {
    if (error4.code !== "ESRCH") throw error4;
    unlinkRecordedSocket(record5);
    return;
  }
  if (!await waitUntilGone(record5, provider, world.teardownWaitMs)) {
    throw captureError("cleanup", "log_tailer_still_alive", `Log tailer pid ${record5.pid} (${record5.name}) could not be drained or terminated before session stop.`);
  }
  unlinkRecordedSocket(record5);
}
async function stopSessionLogTailers(entries) {
  const failures = [];
  for (const value of entries) {
    let record5;
    try {
      record5 = requireRegisteredLogTailer(value);
    } catch (error4) {
      failures.push(error4);
      continue;
    }
    try {
      await stopOne(record5, world.pidBirthProvider);
    } catch (error4) {
      failures.push(error4);
    }
  }
  if (failures.length) throw new AggregateError(failures, "Session stop could not drain every registered log tailer.");
}
function parseWorkerArgs(argv) {
  const usage = "log tailer expects exactly --source <path> --socket-token <token> --confirm-timeout <ms> --orphan-check <ms>";
  let sourcePath;
  let socketToken;
  let confirmTimeout;
  let orphanCheck;
  for (let index = 0; index < argv.length; index += 2) {
    const flag = argv[index];
    const value = argv[index + 1];
    if (value === void 0) throw new Error(usage);
    if (flag === "--source") {
      if (sourcePath !== void 0) throw new Error("duplicate --source");
      sourcePath = value;
    } else if (flag === "--socket-token") {
      if (socketToken !== void 0) throw new Error("duplicate --socket-token");
      socketToken = value;
    } else if (flag === "--confirm-timeout") {
      if (confirmTimeout !== void 0) throw new Error("duplicate --confirm-timeout");
      confirmTimeout = value;
    } else if (flag === "--orphan-check") {
      if (orphanCheck !== void 0) throw new Error("duplicate --orphan-check");
      orphanCheck = value;
    } else {
      throw new Error(usage);
    }
  }
  if (!sourcePath || !socketToken || !confirmTimeout || !orphanCheck || argv.length !== 8 || !LOG_TAILER_SOCKET_TOKEN.test(socketToken) || !WORKER_MS.test(confirmTimeout) || !WORKER_MS.test(orphanCheck)) {
