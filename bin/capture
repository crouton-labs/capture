function needsEndpointResolution(parsed) {
  if (parsed.help || parsed.command === "lib") return false;
  const branchOnly = ["session", "page", "tab", "measure", "motion", "perf", "heap"].includes(parsed.command) && (parsed.positional.length === 0 || parsed.command === "measure" && parsed.positional.length === 1 && parsed.positional[0] === "map");
  if (branchOnly) return false;
  if (parsed.command === "session" && parsed.positional[0] !== "start") return false;
  if (parsed.command === "tab" && (parsed.positional[0] === "launch" || parsed.positional[0] === "quit")) return false;
  return true;
}
function resolveCliContext(parsed) {
  if (!needsEndpointResolution(parsed)) return parsed;
  const sessionStart = parsed.command === "session" && parsed.positional[0] === "start";
  const session = getActiveSession({ cleanStale: false });
  if (session) {
    if (!parsed.har && session.harId) parsed.har = session.harId;
    if (!parsed.target && !parsed.url && session.targetId) {
      parsed.target = session.targetId;
      parsed.targetSource = "session";
    }
    if (parsed.port === void 0 && session.port !== void 0 && session.port !== null) {
      parsed.port = session.port;
      parsed.portSource = "session";
    }
  }
  if (parsed.port === void 0 && process.env.CDP_PORT !== void 0) {
    parsed.port = schemaInteger(leafCommand(parsed.command, parsed.positional), process.env.CDP_PORT, "CDP_PORT", 1, 65535);
    parsed.portSource = "env";
  }
  if (!session) getActiveSession();
  if (!sessionStart && !parsed.target && !parsed.url && process.env.CDP_TARGET) {
    parsed.target = process.env.CDP_TARGET;
    parsed.targetSource = "env";
  }
  return parsed;
}
