function rectOf5(rect3) {
  if (!rect3 || !Number.isFinite(rect3.x) || !Number.isFinite(rect3.y)) return void 0;
  const w = rect3.w ?? rect3.width;
  const h = rect3.h ?? rect3.height;
  if (!Number.isFinite(w) || !Number.isFinite(h)) return void 0;
  return { x: rect3.x, y: rect3.y, w, h };
}
function identity2(stop2, geometryIdsByBackendNode) {
  if (typeof stop2.backendNodeId === "number") return geometryIdsByBackendNode.get(stop2.backendNodeId) ?? String(stop2.backendNodeId);
  return typeof stop2.id === "string" ? stop2.id : void 0;
}
function caveatSuffix2(caveats) {
  if (caveats.length === 0) return void 0;
  return line(
    text` · nondeterminism caveat: `,
    data(caveats.map((c) => c.selector ?? c.regionId).join(", ")),
    text` is an unstable captured region`
  );
}
function stopLine(direction, stop2, caveats) {
  const parts = [
    fact`${direction} step ${stop2.step ?? 0}: `,
    text`selector=`,
    data(stop2.selector ?? "(unresolved)")
  ];
  if (stop2.role !== null && stop2.role !== void 0) parts.push(line(text` role=`, data(stop2.role)));
  if (stop2.name !== null && stop2.name !== void 0) parts.push(line(text` name=`, data(stop2.name)));
  const rect3 = rectOf5(stop2.rect);
  if (rect3) parts.push(line(text` rect `, formatCoordinate(rect3)));
  if (stop2.scrollBefore && stop2.scrollAfter) {
    parts.push(fact` scroll x=${stop2.scrollBefore.x ?? 0},y=${stop2.scrollBefore.y ?? 0} → x=${stop2.scrollAfter.x ?? 0},y=${stop2.scrollAfter.y ?? 0}`);
  }
  if (stop2.scrollJump) parts.push(text` scroll-jump=true`);
  if (stop2.focusVisibleStyle) {
    parts.push(line(text` focus-visible outline=`, data(stop2.focusVisibleStyle.outline ?? "(unavailable)")));
    if (stop2.focusVisibleStyle.boxShadow) parts.push(line(text` box-shadow=`, data(stop2.focusVisibleStyle.boxShadow)));
  }
  const caveat = caveatSuffix2(caveats);
  if (caveat) parts.push(caveat);
  return line(...parts);
}
function unreachedLine(item, caveats) {
  const parts = [text`unreached focusable: selector=`, data(item.selector ?? "(unresolved)")];
  const rect3 = rectOf5(item.rect);
  if (rect3) parts.push(line(text` rect `, formatCoordinate(rect3)));
  if (item.visible !== void 0) parts.push(fact` visible=${String(item.visible)}`);
  const caveat = caveatSuffix2(caveats);
  if (caveat) parts.push(caveat);
  return line(...parts);
}
function mapFocus(ref) {
  const focus = readFocus(ref);
  const meta = readMeta(ref);
  const regions = unstableRegionsFor(ref);
  const geometry = readGeometry(ref);
  const geometryIdsByBackendNode = /* @__PURE__ */ new Map();
  for (const element of geometry.elements ?? []) {
    if (typeof element.backendNodeId === "number" && typeof element.id === "string") {
      geometryIdsByBackendNode.set(element.backendNodeId, element.id);
    }
  }
  const forward = focus.forward ?? [];
  const reverse = focus.reverse ?? [];
  const unreached = focus.unreachedFocusable ?? [];
  const annotate = (items) => annotateUnstableFacts(
    items.map((item) => ({ elementId: identity2(item, geometryIdsByBackendNode), rect: rectOf5(item.rect) })),
    regions
  );
  const annotatedForward = annotate(forward);
  const annotatedReverse = annotate(reverse);
  const annotatedUnreached = annotate(unreached);
  const sections = [];
  if (focus.available === false) {
    sections.push(fact`Focus traversal was unavailable during snapshot capture: ${focus.unavailableReason ?? "capture did not return a completed traversal"}.`);
  } else {
    sections.push(lineList(annotatedForward.map((entry, index) => stopLine("forward", forward[index], entry.caveats))));
    sections.push(lineList(annotatedReverse.map((entry, index) => stopLine("reverse", reverse[index], entry.caveats))));
    if (focus.forwardTruncated || focus.reverseTruncated) {
      sections.push(fact`Traversal recording cap reached: forward=${String(Boolean(focus.forwardTruncated))}, reverse=${String(Boolean(focus.reverseTruncated))}.`);
    }
  }
  if (annotatedUnreached.length) sections.push(lineList(annotatedUnreached.map((entry, index) => unreachedLine(unreached[index], entry.caveats))));
  if (focus.scope) {
    sections.push(fact`Traversal scope: root=${focus.scope.root ?? "unavailable"}, shadow-dom=${focus.scope.shadowDom ?? "unavailable"}, iframes-present=${focus.scope.iframesPresent ?? 0}, shadow-hosts-present=${focus.scope.shadowHostsPresent ?? 0}.`);
  }
  return {
    tag: "focus-map",
    attestation: {
      kind: "snapshot",
      id: ref.id,
      path: ref.dir,
      note: meta.settled === false ? text`Snapshot was captured with unsettled regions; only facts intersecting those regions carry nondeterminism caveats.` : fact`Snapshot settled${meta.settleMs === void 0 ? "" : ` after ${meta.settleMs}ms`}.`
    },
    attrs: {
      forward: forward.length,
      reverse: reverse.length,
      "unreached-focusable": unreached.length,
      settled: meta.settled ?? false
    },
    summary: fact`Keyboard traversal facts: ${forward.length} forward stop(s), ${reverse.length} reverse stop(s), and ${unreached.length} unreached focusable element(s) from ${focus.candidateCount ?? 0} captured candidate(s).`,
    sections,
    followUp: fact`Read another snapshot map with \`capture measure map scroll ${ref.id}\` or \`capture measure map layers ${ref.id}\`.`
  };
}
