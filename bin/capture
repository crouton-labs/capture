          const data32 = { sourceMapUrlPos, diagnostics: transform2.diagnostics };
          writeFile(host, emitterDiagnostics, jsFilePath, text2, !!compilerOptions.emitBOM, sourceFiles, data32);
          writer.clear();
          return !data32.skippedDtsWrite;
        }
