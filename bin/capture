function explainSnapshot(ref, selector, detailOpts = {}) {
  const geometryReport = readGeometry(ref);
  const stylesReport = readStyles(ref);
  const meta = readMeta(ref);
  const geometry = geometryReport.elements ?? [];
  const styles = stylesReport.elements ?? [];
  const selectorKind = selector.startsWith("ax:") || selector.startsWith("axid:") ? "ax" : selector.startsWith("text:") ? "text" : "base";
  let axNodes = [];
  let textElements = [];
  if (selectorKind === "ax" && artifactExists(ref, "ax.json")) axNodes = readAx(ref).nodes ?? [];
  if ((selectorKind === "text" || detailOpts.text) && artifactExists(ref, "text.json")) textElements = readText(ref).elements ?? [];
  let selectable = enrichGeometry(geometry, axNodes, textElements);
  let matches2 = resolveSelectorInput(selectable, selector);
  if (!matches2.length) {
    if (!axNodes.length && artifactExists(ref, "ax.json")) axNodes = readAx(ref).nodes ?? [];
    if (!textElements.length && artifactExists(ref, "text.json")) textElements = readText(ref).elements ?? [];
    selectable = enrichGeometry(geometry, axNodes, textElements);
    matches2 = resolveSelectorInput(selectable, selector);
  }
  if (!matches2.length) {
    return { kind: "missing-selector", ref, selector, meta, available: recoveryForms(selectable, selector) };
  }
  if (matches2.length > 1) {
    return { kind: "ambiguous-selector", ref, selector, meta, matchCount: matches2.length, candidates: matches2.slice(0, RECOVERY_CANDIDATE_LIMIT) };
  }
  const selectedId = matches2[0].id;
  const target = geometry.find((element) => element.id === selectedId);
  const focus = readOptional(ref, "focus.json", readFocus, { available: false, unavailableReason: "focus.json not present", forward: [], reverse: [], candidateCount: 0 });
  const scroll = readOptional(ref, "scroll.json", readScroll, { available: false, reason: "scroll.json not present", containers: [] });
  const queries = readOptional(ref, "queries.json", readQueries, { available: false, unavailableReason: "queries.json not present", environment: {}, mediaQueries: [], containerQueries: [] });
  const states = artifactExists(ref, "states.json") ? readStates(ref) : void 0;
  const rawSections = [
    elementSection(target, matches2.length),
    cascadeSection(target, styles),
    stackingClippingSection(target, geometry, states, detailOpts.state),
    focusScrollSection(target, focus, scroll),
    queriesStatesSection(target, queries, states, styles)
  ];
  if (detailOpts.size) rawSections.push(sizeSection(target));
  if (detailOpts.text) rawSections.push(textSection(target, readText(ref)));
  if (detailOpts.form) rawSections.push(formSection(target, readForms(ref)));
  const regions = unstableRegionsFor(ref);
  const sections = rawSections.filter((section3) => section3.facts.length > 0).map((section3) => ({
    kind: section3.kind,
    facts: annotateUnstableFacts(section3.facts, regions)
  }));
  return { kind: "explanation", ref, requestedSelector: selector, element: target, matchCount: matches2.length, meta, sections };
}
