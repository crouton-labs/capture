        function isReservedName(name, privateName) {
          let set;
          let stack;
          if (privateName) {
            set = reservedPrivateNames;
            stack = reservedPrivateNamesStack;
          } else {
            set = reservedNames;
            stack = reservedNamesStack;
          }
          if (set == null ? void 0 : set.has(name)) {
            return true;
          }
          for (let i = stack.length - 1; i >= 0; i--) {
            if (set === stack[i]) {
              continue;
            }
            set = stack[i];
            if (set == null ? void 0 : set.has(name)) {
              return true;
            }
          }
          return false;
        }
