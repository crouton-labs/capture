          const bounds = Timing_exports3.traceWindowFromMicroSeconds(min, max);
          this.#computeInsightsForNavigation(navigation, bounds, data32, traceEvents3, options);
        }
      }
      /**
       * Computes insights for the period before the first navigation, or for the entire trace if no navigations exist.
       */
      #computeInsightsForInitialTracePeriod(data32, navigations, options) {
        const bounds = navigations.length > 0 ? Timing_exports3.traceWindowFromMicroSeconds(data32.Meta.traceBounds.min, navigations[0].ts) : data32.Meta.traceBounds;
        const context = {
