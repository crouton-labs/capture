                node,
                /*discarded*/
                true
              );
            case 218:
              return visitParenthesizedExpression(
                node,
                /*discarded*/
                true
              );
            default:
              return visitor(node);
          }
        }
        function heritageClauseVisitor(node) {
          switch (node.kind) {
            case 299:
