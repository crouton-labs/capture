      provenanceUnavailable
    };
  });
  const elements = provenance.values.filter((element) => element !== void 0);
  ctx.write.json("styles.json", {
    elements,
    coverage: {
      scope: "top-document",
      iframesNotWalked: inventory.iframesNotWalked,
      shadowRootsNotWalked: inventory.shadowRootsNotWalked,
      totalCandidateElements: inventory.total,
      keptElements: elements.length,
      elementsTruncated: inventory.total > facts.length,
      provenanceTruncated: provenance.truncated,
      ...provenance.truncated ? { provenanceTruncationReason: "collector-time-budget" } : {}
    },
    styleSheetHeaders,
    identity: identity3,
    available,
    ...unavailableReason ? { unavailableReason } : {}
  });
}
