function expandWindowByPercentOrToOneMillisecond(annotationWindow, maxTraceWindow, percentage2) {
  let newMin = annotationWindow.min - annotationWindow.range * (percentage2 / 100) / 2;
  let newMax = annotationWindow.max + annotationWindow.range * (percentage2 / 100) / 2;
