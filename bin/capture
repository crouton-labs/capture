// src/cdp/source-map.ts
async function resolveAuthoredSourceLocation(client, ref) {
  const { text: text2, sourceURL } = await fetchGeneratedText(client, ref);
  const generated = { kind: "generated", sourceURL, line: ref.line, column: ref.column };
  if (!text2) return generated;
  const mappingURL = extractSourceMappingURL(text2);
  if (!mappingURL) return generated;
  const rawMap = await loadSourceMap(mappingURL, sourceURL);
  if (!rawMap) return generated;
  const authored = mapGeneratedPosition(rawMap, ref.line, ref.column);
  if (!authored) return generated;
  return {
    kind: "authored",
    generated: { sourceURL, line: ref.line, column: ref.column },
    file: authored.file,
    line: authored.line,
    column: authored.column,
    sourceContent: authored.sourceContent
  };
}
async function fetchGeneratedText(client, ref) {
  if (ref.styleSheetId) {
    try {
      const result = await client.send("CSS.getStyleSheetText", {
        styleSheetId: ref.styleSheetId
      });
      return { text: result.text, sourceURL: ref.sourceURL ?? ref.styleSheetId };
    } catch {
    }
  }
  if (ref.sourceURL) {
    try {
      const text2 = await fetchText(ref.sourceURL);
      return { text: text2, sourceURL: ref.sourceURL };
    } catch {
      return { text: null, sourceURL: ref.sourceURL };
    }
  }
  return { text: null, sourceURL: "" };
}
function extractSourceMappingURL(text2) {
  SOURCE_MAPPING_URL_RE.lastIndex = 0;
  let match;
  let last = null;
  while ((match = SOURCE_MAPPING_URL_RE.exec(text2)) !== null) {
    last = match[1] ?? match[2] ?? last;
  }
  return last;
}
async function loadSourceMap(mappingURL, baseURL) {
  if (mappingURL.startsWith("data:")) {
    return parseDataURISourceMap(mappingURL);
  }
  try {
    const resolved = baseURL ? new URL(mappingURL, baseURL).toString() : mappingURL;
    const text2 = await fetchText(resolved);
    return JSON.parse(text2);
  } catch {
    return null;
  }
}
function parseDataURISourceMap(dataURI) {
  const commaIndex = dataURI.indexOf(",");
  if (commaIndex === -1) return null;
  const meta = dataURI.slice("data:".length, commaIndex);
  const payload = dataURI.slice(commaIndex + 1);
  try {
    const json = meta.includes(";base64") ? Buffer.from(payload, "base64").toString("utf8") : decodeURIComponent(payload);
    return JSON.parse(json);
  } catch {
    return null;
  }
}
async function fetchText(url) {
  const response = await fetch(url);
  if (!response.ok) {
    throw new Error(`Fetching ${url} returned HTTP ${response.status}`);
  }
  return response.text();
}
function mapGeneratedPosition(rawMap, generatedLine, generatedColumn) {
  const entries = decodeMappings(rawMap.mappings).filter(
    (entry) => entry.generatedLine === generatedLine && entry.sourceIndex !== void 0
  );
  if (entries.length === 0) return null;
  let best;
  for (const entry of entries) {
    if (entry.generatedColumn <= generatedColumn && (!best || entry.generatedColumn > best.generatedColumn)) {
      best = entry;
    }
  }
  best = best ?? entries[0];
  const sourceIndex = best.sourceIndex;
  const sourcePath = rawMap.sources[sourceIndex];
  if (sourcePath === void 0) return null;
  const file = rawMap.sourceRoot ? joinSourceRoot(rawMap.sourceRoot, sourcePath) : sourcePath;
  const sourceContent = rawMap.sourcesContent?.[sourceIndex] ?? void 0;
  return {
    file,
    line: (best.sourceLine ?? 0) + 1,
    column: best.sourceColumn ?? 0,
    sourceContent
  };
}
function joinSourceRoot(root, source) {
  if (source.startsWith("/") || /^[a-z]+:\/\//i.test(source)) return source;
  return root.endsWith("/") ? `${root}${source}` : `${root}/${source}`;
}
function decodeVLQSegment(segment) {
  const values = [];
  let shift = 0;
  let result = 0;
  for (const char of segment) {
    const digit = BASE64_LOOKUP.get(char);
    if (digit === void 0) {
      throw new Error(`Invalid base64 VLQ character in source map mappings: ${JSON.stringify(char)}`);
    }
    const continuation = digit & VLQ_CONTINUATION_BIT;
    const bits = digit & VLQ_BASE_MASK;
    result += bits << shift;
    if (continuation) {
      shift += VLQ_BASE_SHIFT;
    } else {
      const negate = result & 1;
      result >>= 1;
      values.push(negate ? -result : result);
      result = 0;
      shift = 0;
    }
  }
  return values;
}
function decodeMappings(mappings) {
  const entries = [];
  const lines = mappings.split(";");
  let sourceIndex = 0;
  let sourceLine = 0;
  let sourceColumn = 0;
  let nameIndex = 0;
  for (let lineIndex = 0; lineIndex < lines.length; lineIndex++) {
    const lineText = lines[lineIndex];
    if (lineText === "") continue;
    let generatedColumn = 0;
    for (const segment of lineText.split(",")) {
      if (segment === "") continue;
      const fields = decodeVLQSegment(segment);
      generatedColumn += fields[0];
      const entry = { generatedLine: lineIndex, generatedColumn };
      if (fields.length > 1) {
        sourceIndex += fields[1];
        sourceLine += fields[2];
        sourceColumn += fields[3];
        entry.sourceIndex = sourceIndex;
        entry.sourceLine = sourceLine;
        entry.sourceColumn = sourceColumn;
        if (fields.length > 4) {
          nameIndex += fields[4];
          entry.nameIndex = nameIndex;
        }
      }
      entries.push(entry);
    }
  }
  return entries;
}
var SOURCE_MAPPING_URL_RE, BASE64_CHARS, BASE64_LOOKUP, VLQ_BASE_SHIFT, VLQ_BASE, VLQ_BASE_MASK, VLQ_CONTINUATION_BIT;
var init_source_map = __esm({
  "src/cdp/source-map.ts"() {
    SOURCE_MAPPING_URL_RE = /\/\*[#@]\s*sourceMappingURL=([^\s*]+)\s*\*\/|\/\/[#@]\s*sourceMappingURL=([^\s]+)/g;
    BASE64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    BASE64_LOOKUP = new Map(Array.from(BASE64_CHARS).map((char, index) => [char, index]));
    VLQ_BASE_SHIFT = 5;
    VLQ_BASE = 1 << VLQ_BASE_SHIFT;
    VLQ_BASE_MASK = VLQ_BASE - 1;
    VLQ_CONTINUATION_BIT = VLQ_BASE;
  }
});

// src/cdp/measure/collectors/style-provenance.ts
function computeSpecificity(selectorText) {
  let s = selectorText;
  let a = 0;
  let b = 0;
  let c = 0;
  const idMatches = s.match(/#[\w-]+/g);
  a += idMatches ? idMatches.length : 0;
  s = s.replace(/#[\w-]+/g, " ");
  const attrMatches = s.match(/\[[^\]]*\]/g);
  b += attrMatches ? attrMatches.length : 0;
  s = s.replace(/\[[^\]]*\]/g, " ");
  const classMatches = s.match(/\.[\w-]+/g);
  b += classMatches ? classMatches.length : 0;
  s = s.replace(/\.[\w-]+/g, " ");
  const pseudoElementMatches = s.match(/::[\w-]+|:(?:before|after|first-line|first-letter)\b/g);
  c += pseudoElementMatches ? pseudoElementMatches.length : 0;
  s = s.replace(/::[\w-]+|:(?:before|after|first-line|first-letter)\b/g, " ");
  const pseudoClassMatches = s.match(/:[\w-]+(\([^)]*\))?/g);
  b += pseudoClassMatches ? pseudoClassMatches.length : 0;
  s = s.replace(/:[\w-]+(\([^)]*\))?/g, " ");
  const identMatches = s.match(/[a-zA-Z][a-zA-Z0-9-]*/g);
  c += identMatches ? identMatches.length : 0;
  return { a, b, c };
}
function compareSpecificity(x, y) {
  return x.a - y.a || x.b - y.b || x.c - y.c;
}
async function resolveNodeIds(client, documentNodeId, paths) {
  const results = [];
  for (const path48 of paths) {
    try {
      const queryResult = await client.send("DOM.querySelector", {
        nodeId: documentNodeId,
        selector: `body > ${path48}`
      });
      const nodeId = queryResult.nodeId;
      if (!nodeId) {
        results.push(void 0);
        continue;
      }
      try {
        const described = await client.send("DOM.describeNode", { nodeId });
        results.push({ nodeId, backendNodeId: described.node?.backendNodeId });
      } catch {
        results.push({ nodeId });
      }
    } catch {
      results.push(void 0);
    }
  }
  return results;
}
function detectUnresolvedCascadeConstruct(rule, declaredValue) {
  if (rule.layers && rule.layers.length > 0) return "cascade-layers-present";
  if (rule.scopes && rule.scopes.length > 0) return "cascade-scope-present";
  const normalized2 = declaredValue.trim().toLowerCase();
  if (normalized2 === "revert" || normalized2 === "revert-layer") return "revert-keyword-present";
  return void 0;
}
function detectSelectorSpecificityApproximation(selectorText) {
  return /:(?:where|is|matches)\(/i.test(selectorText) ? "selector-specificity-where-is-present" : void 0;
}
function buildRangeByProperty(rule) {
  const rangeByProperty = /* @__PURE__ */ new Map();
  for (const p of rule.style.cssProperties) {
    if (!p.range) continue;
    rangeByProperty.set(p.name, p.range);
    if (p.longhandProperties) {
      for (const longhand of p.longhandProperties) rangeByProperty.set(longhand.name, p.range);
    }
  }
  return rangeByProperty;
}
function pickHighestSpecificitySelectorText(rule, matchingSelectors) {
  if (!matchingSelectors || matchingSelectors.length === 0) return rule.selectorList.text;
  let bestText;
  let bestSpecificity;
  for (const idx of matchingSelectors) {
    const sel = rule.selectorList.selectors[idx];
    if (!sel) continue;
    const specificity = computeSpecificity(sel.text);
    if (!bestSpecificity || compareSpecificity(specificity, bestSpecificity) > 0) {
      bestSpecificity = specificity;
      bestText = sel.text;
    }
  }
  return bestText ?? rule.selectorList.text;
}
function buildCandidates(property, matched) {
  const candidates = [];
  for (const entry of matched.matchedCSSRules ?? []) {
    const rule = entry.rule;
    if (rule.origin !== "regular") continue;
    const selectorText = pickHighestSpecificitySelectorText(rule, entry.matchingSelectors);
    const specificity = computeSpecificity(selectorText);
    const rangeByProperty = buildRangeByProperty(rule);
    for (const p of rule.style.cssProperties) {
      if (p.name !== property || p.implicit === true) continue;
      const resolvedRange = p.range ?? rangeByProperty.get(p.name);
      const usedRuleRangeFallback = resolvedRange === void 0 && rule.style.range !== void 0;
      candidates.push({
        value: p.value,
        important: p.important === true,
        selectorText,
        specificity,
        isInline: false,
        rule,
        range: resolvedRange ?? rule.style.range,
        approximateReason: detectUnresolvedCascadeConstruct(rule, p.value) ?? detectSelectorSpecificityApproximation(selectorText) ?? (usedRuleRangeFallback ? "source-range-unresolved" : void 0)
      });
    }
  }
  for (const p of matched.inlineStyle?.cssProperties ?? []) {
    if (p.name !== property || p.implicit === true) continue;
    candidates.push({
      value: p.value,
      important: p.important === true,
      selectorText: "inline",
      specificity: { a: 0, b: 0, c: 0 },
      isInline: true,
      range: p.range
    });
  }
  return candidates;
}
function pickWinner(candidates) {
  if (candidates.length === 0) return void 0;
  const importantPool = candidates.filter((c) => c.important);
  const nonImportantPool = candidates.filter((c) => !c.important);
  const pool = importantPool.length > 0 ? importantPool : nonImportantPool;
  for (let i = pool.length - 1; i >= 0; i--) {
    if (pool[i].isInline) return pool[i];
  }
  let best;
  for (const candidate of pool) {
    if (!best || compareSpecificity(candidate.specificity, best.specificity) >= 0) {
      best = candidate;
    }
  }
  return best;
}
function noDeclarationRecord(property, value) {
  return { property, value, selector: null, specificity: null, source: null };
}
async function buildWinningDeclarations(client, matched, computed2, sourceCache, styleSheetUrls, properties) {
  const declarations2 = [];
  for (const property of properties) {
    const candidates = buildCandidates(property, matched);
    const winner = pickWinner(candidates);
    if (!winner) {
      declarations2.push(noDeclarationRecord(property, computed2[property] ?? null));
      continue;
    }
    const specificityStr = winner.isInline ? null : `${winner.specificity.a}-${winner.specificity.b}-${winner.specificity.c}`;
    const winnerApproximateReason = candidates.map((c) => c.approximateReason).find((reason) => reason !== void 0);
    const rawSourceStyleSheetUrl = winner.rule?.styleSheetId ? styleSheetUrls.get(winner.rule.styleSheetId) : void 0;
    const sourceStyleSheetUrl = rawSourceStyleSheetUrl !== void 0 ? sanitizeString(rawSourceStyleSheetUrl) : void 0;
    let authored;
    let generated;
    let sourceResolutionUnavailable;
    let sourceResolutionUnavailableReason;
    if (!winner.isInline && winner.rule?.styleSheetId && winner.range) {
      const line4 = winner.range.startLine;
      const column = winner.range.startColumn;
      const styleSheetId = winner.rule.styleSheetId;
      const key = `${styleSheetId}:${line4}:${column}`;
      try {
        let pending = sourceCache.get(key);
        if (!pending) {
          pending = resolveAuthoredSourceLocation(client, {
            styleSheetId,
            sourceURL: rawSourceStyleSheetUrl,
            line: line4,
            column
          });
          sourceCache.set(key, pending);
        }
        const location = await pending;
        if (location.kind === "authored") {
          authored = { file: sanitizeString(location.file), line: location.line, column: location.column };
          generated = {
            sourceURL: sanitizeString(location.generated.sourceURL),
            line: location.generated.line,
            column: location.generated.column
          };
        } else {
          generated = { sourceURL: sanitizeString(location.sourceURL), line: location.line, column: location.column };
        }
      } catch (err) {
        sourceResolutionUnavailable = true;
        sourceResolutionUnavailableReason = err instanceof Error ? err.message : "source-resolution-failed";
        generated = { sourceURL: sanitizeString(rawSourceStyleSheetUrl ?? styleSheetId), line: line4, column };
      }
    }
    declarations2.push({
      property,
      value: computed2[property] ?? null,
      declaredValue: sanitizeString(winner.value),
      selector: winner.isInline ? "inline" : sanitizeString(winner.selectorText),
