                  is only ever passed to \`tail\` as an argv element, never a shell.
  --name <label>  destination label; default is the source file's basename. One
                  bounded path component: no \`/\`, no \`.\`/\`..\`, no NUL, \u2264 ${MAX_LOG_LABEL_BYTES} bytes.
  --session <id>  target session; defaults to the active session

output:
  One <log-tail session=\u2026 path=\u2026> block: tailer name, source path, destination
  path, and tailer pid. --json mirrors the same fields.

effects:
  Self-spawns one detached, identity-owned worker (its own process group) that
  runs \`tail -f\` and appends ISO-8601-timestamped lines to the session's
  contained logs/<name>.log. \`session stop\` drains it over its nonce-authenticated
  control socket so its buffered output lands before the bundle is committed;
  the identity-bearing tailer record is registered in the session metadata.`;
    productionStartWorld = {
      async createHar(dir) {
        return (await createHarRecording(dir)).id;
      },
      deleteHar: deleteHarRecording,
      async detectCdpPort() {
        const { detectCdpEndpoint: detectCdpEndpoint2 } = await Promise.resolve().then(() => (init_detect(), detect_exports));
        return detectCdpEndpoint2();
      },
      async openTab(port, url) {
        const { openTab: openTab2 } = await Promise.resolve().then(() => (init_cdp2(), cdp_exports));
        return openTab2(port, url);
      },
      async findTabById(port, targetId) {
        const { findTabById: findTabById2 } = await Promise.resolve().then(() => (init_targets(), targets_exports));
        return findTabById2(port, targetId);
      },
      async closeTarget(port, targetId) {
        const { closeTarget: closeTarget2 } = await Promise.resolve().then(() => (init_targets(), targets_exports));
        return closeTarget2(port, targetId);
      },
      async awaitTabReady(target, url) {
        if (!target.webSocketDebuggerUrl) {
          throw worldFailure(`capture session start could not attach to ${url}: missing WebSocket debugger URL. Reuse an existing tab with --target.`);
        }
        const { CDPClient: CDPClient2 } = await Promise.resolve().then(() => (init_cdp2(), cdp_exports));
        const client = new CDPClient2(target.webSocketDebuggerUrl);
        try {
          try {
            await client.send("Runtime.enable", {}, 5e3);
          } catch (err) {
            throw worldFailure(`capture session start could not attach to ${url}: ${err instanceof Error ? err.message : err}. Reuse an existing tab with --target.`, err);
          }
          try {
            return await waitForPageLoad(client, 1e4);
          } catch (err) {
            throw worldFailure(
              `capture session start could not attach to ${url}: Page.enable failed during its ${SESSION_TAB_ATTACH_TIMEOUT_MS}ms attachment window (${err instanceof Error ? err.message : err}). The CDP endpoint created the tab but cannot drive it; choose another endpoint from \`capture tab list\` and retry with \`--port\`.`,
              err
            );
          }
        } finally {
          client.close();
        }
      },
      startBridge,
      stopBridge,
      publishActiveSession: setActiveSession
    };
    startWorld = productionStartWorld;
  }
});

// src/cdp/connection.ts
function getPortFromWebSocketDebuggerUrl(url) {
  if (!url) return null;
  try {
    return Number(new URL(url).port);
  } catch {
    return null;
  }
}
async function defaultResolveTab(parsed) {
  if (parsed.target) return findTabByIdAcrossEndpoints(parsed.target, parsed.port);
  if (parsed.url) return findTabByUrlAcrossEndpoints(parsed.url, parsed.port);
  return findUnambiguousPageTabInPorts(parsed.port === void 0 ? (await detectCdpPortsAsync()).map((endpoint) => endpoint.port) : [parsed.port]);
}
async function applyActiveSessionNetworkConditions(client, session, targetId) {
  if (!session || session.targetId !== targetId || session.networkOffline === void 0) return;
  const offline = session.networkOffline;
  await client.send("Network.enable");
  await client.send("Network.emulateNetworkConditions", {
    offline,
    latency: offline ? -1 : 0,
    downloadThroughput: offline ? 0 : -1,
    uploadThroughput: offline ? 0 : -1
  });
}
function deriveActionLabel(parsed) {
  if (parsed.command === "type") {
    return `type:${parsed.into ?? "focused element"}`;
  }
  const target = parsed.positional[0] ?? parsed.into ?? parsed.url ?? "";
  return target ? `${parsed.command}:${target}` : parsed.command;
}
function shouldRouteToRecorder(session, parsed) {
  if (!session.activeRecId) return false;
  if (parsed.url) return false;
  if (parsed.target && parsed.target !== session.targetId) return false;
  return true;
}
function connectToActiveRecorder(session, parsed) {
  const recId = session.activeRecId;
  const scanned = scanCollectorHost(session.dir);
  const collector = scanned.handle?.collectors.find((value) => value.id === recId && value.kind === "motion");
  if (scanned.classification !== "live" || !scanned.handle || !collector) {
    throw captureError(
      "precondition",
      "recorder_unavailable",
      `The active session claims recording "${recId}" but its live collector-host handle is unavailable. Recover with: capture motion rec --stop.`
    );
  }
  const actionLabel = deriveActionLabel(parsed);
  const client = new MotionHeldClient({ socketPath: scanned.handle.socketPath, nonce: scanned.handle.nonce, actionLabel });
  const tab = {
    id: scanned.handle.targetId,
    title: "",
    url: session.url ?? "",
    type: "page",
    webSocketDebuggerUrl: void 0
  };
  console.error(`Routing via active motion collector ${recId} (collector-host tab connection, action "${actionLabel}")`);
  return { client, tab };
}
async function connectForCommand(parsed) {
  const activeSession2 = seams.getActiveSession();
  if (activeSession2 && shouldRouteToRecorder(activeSession2, parsed)) {
    const routed = connectToActiveRecorder(activeSession2, parsed);
    await applyActiveSessionNetworkConditions(routed.client, activeSession2, routed.tab.id);
    return routed;
  }
  let resolved;
  try {
    resolved = await seams.resolveTab(parsed);
  } catch (error4) {
    if (error4 instanceof AmbiguousPageTargetError) {
      throw captureError("precondition", "target_unavailable", error4.message, error4);
    }
    throw error4;
  }
  const tab = resolved?.tab ?? null;
  if (!tab) {
    const query = parsed.target ?? parsed.url;
    throw captureError(
      "precondition",
      "target_unavailable",
      query === void 0 ? 'No page tab found. Run "capture tab list" to see available tabs.' : `No tab found for ${parsed.target ? "target" : "URL pattern"} "${query}". Run "capture tab list" to see available tabs.`
    );
  }
  if (!tab.webSocketDebuggerUrl) {
    throw captureError("precondition", "target_unavailable", "Tab has no WebSocket debugger URL");
  }
  const port = resolved?.port ?? getPortFromWebSocketDebuggerUrl(tab.webSocketDebuggerUrl);
  if (activeSession2 && !activeSession2.targetId) {
    await seams.withSessionScopeLifecycle(async () => {
      const current = seams.getActiveSession();
      if (current?.sessionId === activeSession2.sessionId && !current.targetId) {
        await seams.updateActiveSession({ targetId: tab.id, port: port ?? null });
      }
    });
  }
  console.error(
    `Using target ${tab.id.slice(0, 8)}${port ? ` on port ${port}` : ""}${tab.url ? ` (${tab.url})` : ""}`
  );
  const client = seams.createClient(tab.webSocketDebuggerUrl);
  try {
    await client.waitReady();
    await applyActiveSessionNetworkConditions(client, seams.getActiveSession(), tab.id);
    return { client, tab };
  } catch (err) {
    client.close();
    throw err;
  }
}
async function startCollectors(parsed, client) {
  const routed = isMotionHeldClient(client);
  let consoleRecorder;
  if (!routed) {
    consoleRecorder = new ConsoleRecorder(client);
    await consoleRecorder.start();
  }
  let harRecorder;
  if (parsed.har && !routed) {
    const harPath = harFilePath(parsed.har);
    if (!fs13.existsSync(harPath)) {
      throw captureError(
        "precondition",
        "har_missing",
        `The active session's HAR recording file ("${parsed.har}") is missing on disk \u2014 traffic cannot be appended.`
      );
    }
    harRecorder = new HARRecorder(client);
    await harRecorder.start();
  }
  if (routed) {
    console.error(
      "  [recorder] local console/HAR collectors skipped while routed \u2014 traffic streams into the session HAR via the recording's held connection."
    );
  }
  return { routed, consoleRecorder, harRecorder };
}
async function finishLocalHar(parsed, collectors) {
  if (!collectors.harRecorder || !parsed.har) return;
  const har2 = await collectors.harRecorder.finish();
  const batch = { entries: har2.log.entries, incompleteLifecycles: har2.incompleteLifecycles };
  if (batch.entries.length > 0 || batch.incompleteLifecycles.length > 0) {
    await seams.appendHar(parsed.har, batch);
    console.error(
      `  [har:${parsed.har}] +${batch.entries.length} entries +${batch.incompleteLifecycles.length} incomplete \u2014 incomplete lifecycles are retained as their own records (request plus whatever response was observed), separate from log.entries; read them with capture session har`
    );
  }
}
function finishConsole(collectors) {
  if (collectors.consoleRecorder) {
    printConsoleSummary(collectors.consoleRecorder.finish());
  }
}
async function withConnection(parsed, fn, opts = {}) {
  const { client, tab } = await connectForCommand(parsed);
  const collectors = await startCollectors(parsed, client);
  try {
    const result = await fn(client, tab);
    if (collectors.harRecorder && parsed.har) {
      const settle = opts.settle !== void 0 ? opts.settle : 3e3;
      if (settle > 0) {
        await new Promise((r) => setTimeout(r, settle));
      }
      await finishLocalHar(parsed, collectors);
    }
    finishConsole(collectors);
    return result;
  } finally {
    client.close();
  }
}
async function withPageAction(parsed, opts, fn) {
  const { client, tab } = await connectForCommand(parsed);
  const collectors = await startCollectors(parsed, client);
  try {
    const result = await fn(client, tab);
    const requestedMs = opts.settleMs;
    const t0 = seams.now();
    if (requestedMs > 0) {
      await seams.sleep(requestedMs);
    }
    const waitedMs = seams.now() - t0;
    const settle = { requestedMs, waitedMs, completed: true };
    if (collectors.routed) {
      try {
        await seams.flushRecorderHar(client);
      } catch (err) {
        throw captureError(
          "artifact",
          "recorder_har_flush_failed",
          `The page action completed, but the active recording's HAR flush failed \u2014 completed network evidence for this action is not verifiably appended to the session HAR: ${err instanceof Error ? err.message : String(err)}`,
          err
        );
      }
    }
    await finishLocalHar(parsed, collectors);
    finishConsole(collectors);
    return { result, settle };
  } finally {
    client.close();
  }
}
var fs13, import_node_perf_hooks2, seams;
var init_connection = __esm({
  "src/cdp/connection.ts"() {
    fs13 = __toESM(require("fs"));
    import_node_perf_hooks2 = require("node:perf_hooks");
    init_client();
    init_detect();
    init_targets();
    init_console_recorder();
    init_har_recorder();
    init_har_manager();
    init_session_context();
    init_coordinator();
    init_held_client();
    init_handle();
    init_errors();
    seams = {
      getActiveSession: () => getActiveSession(),
      updateActiveSession,
      withSessionScopeLifecycle,
      resolveTab: defaultResolveTab,
      createClient: (wsUrl) => new CDPClient(wsUrl),
      appendHar: appendToHarRecording,
      flushRecorderHar: (client) => client.flushHar(),
      now: () => import_node_perf_hooks2.performance.now(),
      sleep: (ms) => new Promise((r) => setTimeout(r, ms))
    };
  }
});

// src/output/selector.ts
function isNameStart(char) {
  return char !== void 0 && /[A-Za-z_*]/.test(char);
}
function isNameChar(char) {
  return char !== void 0 && /[A-Za-z0-9_-]/.test(char);
}
function readName(value, start2) {
  if (!isNameStart(value[start2])) return void 0;
  let end = start2 + 1;
  while (isNameChar(value[end])) end += 1;
  return { value: value.slice(start2, end), end };
}
function unquoteCssValue(value) {
  const trimmed = value.trim();
  if (!trimmed) return void 0;
  if (trimmed.startsWith('"') && trimmed.endsWith('"') || trimmed.startsWith("'") && trimmed.endsWith("'")) {
    return trimmed.slice(1, -1).replace(/\\(.)/g, "$1");
  }
  return /\s/.test(trimmed) ? void 0 : trimmed;
}
function parseAttribute(value) {
  const equals = value.indexOf("=");
  const name = (equals === -1 ? value : value.slice(0, equals)).trim();
  if (!/^[A-Za-z_][A-Za-z0-9_:-]*$/.test(name)) return void 0;
  if (equals === -1) return { name: name.toLowerCase() };
  const attributeValue = unquoteCssValue(value.slice(equals + 1));
  return attributeValue === void 0 ? void 0 : { name: name.toLowerCase(), value: attributeValue };
}
function parseCompound(value) {
  let index = 0;
  let tag;
  const first = readName(value, index);
  if (first) {
    tag = first.value.toLowerCase();
    index = first.end;
  }
  const classes = [];
  const attributes = [];
  let id;
  let nthOfType;
  while (index < value.length) {
    const marker = value[index];
    if (marker === "." || marker === "#") {
      const name = readName(value, index + 1);
      if (!name) return void 0;
      if (marker === ".") classes.push(name.value);
      else if (id === void 0) id = name.value;
      else return void 0;
      index = name.end;
      continue;
    }
    if (marker === "[") {
      let end = index + 1;
      let quote;
      while (end < value.length) {
        const char = value[end];
        if (quote) {
          if (char === "\\") end += 2;
          else {
            if (char === quote) quote = void 0;
            end += 1;
          }
        } else if (char === '"' || char === "'") {
          quote = char;
          end += 1;
        } else if (char === "]") break;
        else end += 1;
      }
      if (quote || value[end] !== "]") return void 0;
      const attribute = parseAttribute(value.slice(index + 1, end));
      if (!attribute) return void 0;
      attributes.push(attribute);
      index = end + 1;
      continue;
    }
    if (value.startsWith(":nth-of-type(", index)) {
      const end = value.indexOf(")", index);
      const rawIndex = value.slice(index + ":nth-of-type(".length, end);
      if (end === -1 || !/^\d+$/.test(rawIndex) || nthOfType !== void 0) return void 0;
      nthOfType = Number(rawIndex);
      index = end + 1;
      continue;
    }
    return void 0;
  }
  return tag || id || classes.length || attributes.length || nthOfType !== void 0 ? { tag, id, classes, attributes, nthOfType } : void 0;
}
function parseCssMatcher(rawInput) {
  const input = rawInput.trim();
  const compounds = [];
  const combinators = [];
  let index = 0;
  let pendingCombinator;
  while (index < input.length) {
    let sawWhitespace = false;
    while (/\s/.test(input[index] ?? "")) {
      sawWhitespace = true;
      index += 1;
    }
    if (index >= input.length) return void 0;
    if (input[index] === ">") {
      if (!compounds.length || pendingCombinator) return void 0;
      pendingCombinator = "child";
      index += 1;
      continue;
    }
    if (compounds.length && !pendingCombinator) pendingCombinator = sawWhitespace ? "descendant" : void 0;
    if (compounds.length && !pendingCombinator) return void 0;
    const start2 = index;
    let bracketDepth = 0;
    let quote;
    while (index < input.length) {
      const char = input[index];
      if (quote) {
        if (char === "\\") index += 2;
        else {
          if (char === quote) quote = void 0;
          index += 1;
        }
      } else if (char === '"' || char === "'") {
        quote = char;
        index += 1;
      } else if (char === "[") {
        bracketDepth += 1;
        index += 1;
      } else if (char === "]") {
        bracketDepth -= 1;
        if (bracketDepth < 0) return void 0;
        index += 1;
      } else if (bracketDepth === 0 && (char === ">" || /\s/.test(char))) break;
      else index += 1;
    }
    if (quote || bracketDepth !== 0) return void 0;
    const compound = parseCompound(input.slice(start2, index));
    if (!compound) return void 0;
    if (compounds.length) combinators.push(pendingCombinator);
    compounds.push(compound);
    pendingCombinator = void 0;
  }
  return compounds.length && !pendingCombinator ? { compounds, combinators } : void 0;
}
function elementAttributes(element) {
  return element.attributes ?? {};
}
function terminalGeneratedCompound(element) {
  const selector = element.selector;
  if (!selector) return void 0;
  const parts = parseCssMatcher(selector)?.compounds;
  return parts?.at(-1);
}
function matchesCompound(element, compound) {
  const tag = element.tag;
  if (compound.tag && compound.tag !== "*" && (typeof tag !== "string" || tag.toLowerCase() !== compound.tag)) return false;
  const attributes = elementAttributes(element);
  const generated = terminalGeneratedCompound(element);
  const actualId = attributes.id ?? generated?.id;
  if (compound.id && actualId !== compound.id) return false;
  const classNames = new Set((attributes.class ?? "").split(/\s+/).filter(Boolean));
  for (const className of generated?.classes ?? []) classNames.add(className);
  if (compound.classes.some((className) => !classNames.has(className))) return false;
  for (const attribute of compound.attributes) {
    const actual = Object.entries(attributes).find(([name]) => name.toLowerCase() === attribute.name)?.[1];
    if (actual === void 0 || attribute.value !== void 0 && actual !== attribute.value) return false;
  }
  if (compound.nthOfType !== void 0 && generated?.nthOfType !== compound.nthOfType) return false;
  return true;
}
function pathSegments(element) {
  const domPath = element.domPath;
  return typeof domPath === "string" && domPath ? domPath.split("/") : void 0;
}
function treeScope(element) {
  const frame = element.frame;
  if (typeof frame !== "object" || frame === null || typeof frame.frameId !== "string") return void 0;
  const shadow = element.shadow;
  if (typeof shadow !== "object" || shadow === null || shadow.inShadowDom !== true) return `${frame.frameId}:light`;
  const values = shadow;
  return `${frame.frameId}:shadow:${String(values.chainDepth)}:${String(values.hostSelector)}`;
}
function isAncestorOf(ancestor, descendant, direct) {
  const ancestorPath = pathSegments(ancestor);
  const descendantPath = pathSegments(descendant);
  if (!ancestorPath || !descendantPath || ancestorPath.length >= descendantPath.length || treeScope(ancestor) !== treeScope(descendant)) return false;
  if (direct && ancestorPath.length !== descendantPath.length - 1) return false;
  return ancestorPath.every((segment, index) => descendantPath[index] === segment);
}
function matchesCssMatcher(elements, target, matcher2, index = matcher2.compounds.length - 1) {
  if (!matchesCompound(target, matcher2.compounds[index])) return false;
  if (index === 0) return true;
  const direct = matcher2.combinators[index - 1] === "child";
  return elements.some((candidate) => isAncestorOf(candidate, target, direct) && matchesCssMatcher(elements, candidate, matcher2, index - 1));
}
function findBySelector(elements, selector) {
  const exact = elements.filter((element) => element.selector === selector);
  if (exact.length) return exact;
  const matcher2 = parseCssMatcher(selector);
  return matcher2 ? elements.filter((element) => matchesCssMatcher(elements, element, matcher2)) : [];
}
function findByBackendNodeId(elements, backendNodeId2) {
  return elements.find((e) => e.backendNodeId === backendNodeId2);
}
function findByAxId(elements, axId) {
  return elements.find((e) => e.axId === axId);
}
function findByAxName(elements, name, opts = {}) {
  const exact = opts.exact ?? true;
  const needle = name.toLowerCase();
  return elements.filter((e) => {
    if (e.axName === void 0) return false;
    const hay = e.axName.toLowerCase();
    return exact ? hay === needle : hay.includes(needle);
  });
}
function findByText(elements, needle, opts = {}) {
  const exact = opts.exact ?? false;
  const target = needle.toLowerCase();
  return elements.filter((e) => {
    if (e.text === void 0) return false;
    const hay = e.text.toLowerCase();
    return exact ? hay === target : hay.includes(target);
  });
}
function parseSelectorInput(input) {
  const prefixes = [
    ["backend:", "backend"],
    ["axid:", "axid"],
    ["ax:", "ax"],
    ["text:", "text"]
  ];
  for (const [prefix, kind] of prefixes) {
    if (input.startsWith(prefix)) {
      return { kind, value: input.slice(prefix.length) };
    }
  }
  return { kind: "css", value: input };
}
function resolveSelectorInput(elements, input) {
  const parsed = parseSelectorInput(input);
  switch (parsed.kind) {
    case "backend": {
      const id = Number(parsed.value);
      if (!Number.isFinite(id)) return [];
      const found = findByBackendNodeId(elements, id);
      return found ? [found] : [];
    }
    case "axid": {
      const found = findByAxId(elements, parsed.value);
      return found ? [found] : [];
    }
    case "ax":
      return findByAxName(elements, parsed.value, { exact: false });
    case "text":
      return findByText(elements, parsed.value, { exact: false });
    case "css":
      return findBySelector(elements, parsed.value);
  }
}
var init_selector = __esm({
  "src/output/selector.ts"() {
  }
});

// src/interact.ts
function normalizeAccessibleName(name) {
  return name.replace(/\s+/gu, " ").trim().toLowerCase();
}
async function resolveLiveTarget(client, input) {
  const parsed = parseSelectorInput(input);
  switch (parsed.kind) {
    case "text":
      return { ok: false, code: "unsupported-prefix", input, acceptedPrefixes: ACCEPTED_LIVE_PREFIXES };
    case "backend": {
      const id = parseBackendNodeId(parsed.value);
      if (id === null || !await isLiveBackendNode(client, id)) {
        return { ok: false, code: "no-match", input, kind: "backend", matchCount: 0, candidates: [] };
      }
      const { role, name } = await axIdentityFor(client, id);
      return { ok: true, kind: "backend", backendNodeId: id, role, name };
    }
    case "ax": {
      const nodes = await readFullAXTree(client);
      const needle = normalizeAccessibleName(parsed.value);
      const matches2 = nodes.filter(
        (n) => n.backendDOMNodeId !== void 0 && n.name?.value !== void 0 && normalizeAccessibleName(n.name.value).includes(needle)
      );
      return settleAxMatches("ax", input, matches2);
    }
    case "axid": {
      const nodes = await readFullAXTree(client);
      const matches2 = nodes.filter((n) => n.nodeId === parsed.value && n.backendDOMNodeId !== void 0);
      return settleAxMatches("axid", input, matches2);
    }
    case "css":
      return resolveBareTarget(client, input, parsed.value);
  }
}
function preferActionable(matches2) {
  if (matches2.length <= 1) return matches2;
  const interactive = matches2.filter((m) => m.role?.value !== void 0 && INTERACTIVE_ROLES.has(m.role.value));
  return interactive.length === 1 ? interactive : matches2;
}
function settleAxMatches(kind, input, rawMatches) {
  const matches2 = preferActionable(rawMatches);
  if (matches2.length === 1) {
    const m = matches2[0];
    return {
      ok: true,
      kind,
      backendNodeId: m.backendDOMNodeId,
      role: m.role?.value ?? null,
      name: m.name?.value ?? null
    };
  }
  return {
    ok: false,
    code: matches2.length === 0 ? "no-match" : "ambiguous",
    input,
    kind,
    matchCount: matches2.length,
    candidates: matches2.slice(0, CANDIDATE_LIMIT).map((m) => ({
      backendNodeId: m.backendDOMNodeId,
      role: m.role?.value ?? null,
      name: m.name?.value ?? null
    }))
  };
}
async function resolveBareTarget(client, input, selector) {
  const css = await resolveLiveCss(client, input, selector);
  if (css.ok || css.code === "ambiguous") return css;
  const normalized2 = normalizeAccessibleName(input);
  if (!normalized2) return css;
  const matches2 = (await readFullAXTree(client)).filter(
    (node) => node.backendDOMNodeId !== void 0 && node.name?.value !== void 0 && normalizeAccessibleName(node.name.value) === normalized2
  );
  const ax = settleAxMatches("ax", input, matches2);
  return ax.ok || ax.code === "ambiguous" ? ax : css;
}
async function resolveLiveCss(client, input, selector) {
  await client.send("DOM.enable");
  const { root } = await client.send("DOM.getDocument", { depth: 0 });
  let nodeIds;
  try {
    ({ nodeIds } = await client.send("DOM.querySelectorAll", {
      nodeId: root.nodeId,
      selector
    }));
  } catch (error4) {
    if (error4 instanceof Error && error4.message.includes("DOM Error while querying")) {
      return { ok: false, code: "invalid-css-selector", input };
    }
    throw error4;
  }
  if (nodeIds.length === 1) {
    const backendNodeId2 = await backendNodeIdFor(client, nodeIds[0]);
    const { role, name } = await axIdentityFor(client, backendNodeId2);
    return { ok: true, kind: "css", backendNodeId: backendNodeId2, role, name };
  }
  const candidates = await Promise.all(
    nodeIds.slice(0, CANDIDATE_LIMIT).map(async (nodeId) => {
      const backendNodeId2 = await backendNodeIdFor(client, nodeId);
      const { role, name } = await axIdentityFor(client, backendNodeId2);
      return { backendNodeId: backendNodeId2, role, name };
    })
  );
  return {
    ok: false,
    code: nodeIds.length === 0 ? "no-match" : "ambiguous",
    input,
    kind: "css",
    matchCount: nodeIds.length,
    candidates
  };
}
function isContentQuad(value) {
  return Array.isArray(value) && value.length >= 8 && value.slice(0, 8).every((n) => typeof n === "number" && Number.isFinite(n));
}
async function backendNodeIdFor(client, nodeId) {
  const { node } = await client.send("DOM.describeNode", { nodeId });
  return node.backendNodeId;
}
function parseBackendNodeId(value) {
  if (!/^\d+$/.test(value)) return null;
  const id = Number(value);
  return Number.isSafeInteger(id) && id > 0 ? id : null;
}
async function isLiveBackendNode(client, backendNodeId2) {
  try {
    const response = await client.send("DOM.describeNode", { backendNodeId: backendNodeId2, depth: 0 });
    if (response === null || typeof response !== "object" || Array.isArray(response)) return false;
    const node = response.node;
    if (node === null || typeof node !== "object" || Array.isArray(node)) return false;
    return node.backendNodeId === backendNodeId2;
  } catch {
    return false;
  }
}
async function axIdentityFor(client, backendNodeId2) {
  try {
    const { nodes } = await client.send("Accessibility.getPartialAXTree", {
      backendNodeId: backendNodeId2,
      fetchRelatives: false
    });
    const node = nodes?.find((n) => n.backendDOMNodeId === backendNodeId2) ?? nodes?.[0];
    return { role: node?.role?.value ?? null, name: node?.name?.value ?? null };
  } catch {
    return { role: null, name: null };
  }
}
async function clickResolved(client, resolved, opts = {}) {
  const { backendNodeId: backendNodeId2 } = resolved;
  await client.send("DOM.scrollIntoViewIfNeeded", { backendNodeId: backendNodeId2 });
  const boxResponse = await client.send("DOM.getBoxModel", { backendNodeId: backendNodeId2 });
  const quad = boxResponse?.model?.content;
  if (!isContentQuad(quad)) {
    throw captureError(
      "world",
      "target_not_clickable",
      `Resolved target backend:${backendNodeId2} has no box model to click.`,
      { method: "DOM.getBoxModel", response: boxResponse }
    );
  }
  const x = (quad[0] + quad[2] + quad[4] + quad[6]) / 4;
  const y = (quad[1] + quad[3] + quad[5] + quad[7]) / 4;
  const dispatchX = Math.round(x);
  const dispatchY = Math.round(y);
  let hitTestReceiverBackendNodeId;
  if (opts.inspectHitTest) {
    const hitTest = await client.send("DOM.getNodeForLocation", { x: dispatchX, y: dispatchY });
    if (typeof hitTest.backendNodeId !== "number" || !Number.isSafeInteger(hitTest.backendNodeId) || hitTest.backendNodeId <= 0) {
      throw captureError(
        "world",
        "malformed_protocol",
        `DOM.getNodeForLocation returned no valid backend node id for the dispatch point of backend:${backendNodeId2}.`,
        { method: "DOM.getNodeForLocation", response: hitTest }
      );
    }
    if (hitTest.backendNodeId !== backendNodeId2 || opts.includeHitTestReceiver) hitTestReceiverBackendNodeId = hitTest.backendNodeId;
  }
  const pressParams = { type: "mousePressed", x: dispatchX, y: dispatchY, button: "left", clickCount: 1 };
  if (opts.mark !== void 0 && client.sendMarked) {
    await client.sendMarked("Input.dispatchMouseEvent", pressParams, opts.mark);
  } else {
    await client.send("Input.dispatchMouseEvent", pressParams);
  }
  await client.send("Input.dispatchMouseEvent", { type: "mouseReleased", x: dispatchX, y: dispatchY, button: "left", clickCount: 1 });
  return {
    backendNodeId: backendNodeId2,
    role: resolved.role,
    name: resolved.name,
    x: dispatchX,
    y: dispatchY,
    ...hitTestReceiverBackendNodeId === void 0 ? {} : { hitTestReceiverBackendNodeId }
  };
}
async function typeText(client, text2) {
  await client.send("Input.insertText", { text: text2 });
}
async function focusAndType(client, resolved, text2, opts = {}) {
  client.suppressNextFocusClickMark?.();
  const dispatch = await clickResolved(client, resolved, opts);
  await new Promise((r) => setTimeout(r, 100));
  await typeText(client, text2);
  return dispatch;
}
async function scrollResolved(client, resolved, to, opts = {}) {
  if (!isScrollDestination(to)) {
    throw captureError(
      "invocation",
      "invalid_scroll_destination",
      `Invalid scroll destination "${to}" \u2014 expected top, bottom, or a pixel offset.`
    );
  }
  const { backendNodeId: backendNodeId2 } = resolved;
  const { object } = await client.send("DOM.resolveNode", { backendNodeId: backendNodeId2 });
  const objectId = object?.objectId;
  if (!objectId) {
    throw captureError(
      "world",
      "target_not_scrollable",
      `Could not resolve backend node ${backendNodeId2} to a live object for scrolling.`
    );
  }
  let primaryFailed = false;
  let primaryError;
  try {
    const params = {
      objectId,
      functionDeclaration: 'function(to, behavior) { const root = this === document.documentElement || this === document.body; const container = root ? document.scrollingElement : this; const before = container.scrollTop; const max = Math.max(0, container.scrollHeight - container.clientHeight); const n = to === "top" ? 0 : to === "bottom" ? container.scrollHeight : Number(to); const top = Math.max(0, Math.min(n, max)); const observed = () => ({ scrollTopBefore: before, scrollTopAfter: container.scrollTop, maxScrollTop: max }); if (before === top || behavior === "instant") { if (root) window.scrollTo({ top, behavior: "instant" }); else this.scrollTo({ top, behavior: "instant" }); return observed(); } return new Promise((resolve) => { const eventTarget = root ? document : this; let done = false; const finish = () => { if (done) return; done = true; clearTimeout(timeout); resolve(observed()); }; const timeout = setTimeout(finish, 5000); eventTarget.addEventListener("scrollend", finish, { once: true }); if (root) window.scrollTo({ top, behavior: "smooth" }); else this.scrollTo({ top, behavior: "smooth" }); }); }',
      arguments: [{ value: to }, { value: opts.behavior ?? "instant" }],
      awaitPromise: true,
      returnByValue: true
    };
    const result = opts.mark !== void 0 && client.sendMarked ? await client.sendMarked("Runtime.callFunctionOn", params, opts.mark) : await client.send("Runtime.callFunctionOn", params);
    if (result?.exceptionDetails) {
      throw captureError(
        "world",
        "scroll_dispatch_failed",
        `Scroll dispatch threw in-page: ${result.exceptionDetails.text ?? "unknown error"}.`
      );
    }
    const observed = result?.result?.value;
    if (typeof observed?.scrollTopBefore !== "number" || typeof observed.scrollTopAfter !== "number" || typeof observed.maxScrollTop !== "number") {
      throw captureError("world", "malformed_protocol", "Scroll did not return a valid traversed-range payload.", {
        method: "Runtime.callFunctionOn",
        response: result
      });
    }
    return { backendNodeId: backendNodeId2, role: resolved.role, name: resolved.name, to, scrollTopBefore: observed.scrollTopBefore, scrollTop: observed.scrollTopAfter, maxScrollTop: observed.maxScrollTop };
  } catch (error4) {
    primaryFailed = true;
    primaryError = error4;
    throw error4;
  } finally {
    try {
      await client.send("Runtime.releaseObject", { objectId });
    } catch (error4) {
      const cleanupError = captureError(
        "cleanup",
        "scroll_object_release_failed",
        `Runtime.releaseObject failed for the scroll container object of backend node ${backendNodeId2}.`,
        error4
      );
      if (primaryFailed) {
        throw new AggregateError(
          [primaryError, cleanupError],
          "Scroll dispatch failed and runtime-object release also failed.",
          { cause: primaryError }
        );
      }
      throw cleanupError;
    }
  }
}
var ACCEPTED_LIVE_PREFIXES, CANDIDATE_LIMIT;
var init_interact = __esm({
  "src/interact.ts"() {
    init_a11y();
    init_leaf_grammar();
    init_errors();
    init_selector();
    ACCEPTED_LIVE_PREFIXES = ["css", "ax:", "axid:", "backend:"];
    CANDIDATE_LIMIT = 10;
  }
});

// src/cdp/commands/page/click.ts
function pageInputDeps() {
  return deps2;
}
async function capturePageInputScreenshot(client, action, label2, noScreenshot, out) {
  try {
    return {
      screenshot: await deps2.autoScreenshot(client, action, label2, noScreenshot, out),
      screenshotWarning: null
    };
  } catch (error4) {
    const message = error4 instanceof Error ? error4.message : String(error4);
    if (!/^CDP request timeout \(\d+ms\): Page\.captureScreenshot$/.test(message)) throw error4;
    return {
      screenshot: null,
      screenshotWarning: `automatic screenshot timed out after the page action completed; no screenshot was saved (${message})`
    };
  }
}
function effectiveSettle(parsed, defaults2) {
  if (parsed.settle !== void 0) return parsed.settle;
  return deps2.getActiveSession() !== null ? defaults2.session : defaults2.standalone;
}
function emitInvalidInput(parsed, command, summary, followUp) {
  emitResult(
    { tag: "error", attrs: { command, code: "invalid_input" }, summary, followUp },
    { json: parsed.json }
  );
  process.exitCode = 1;
}
function emitResolutionError(parsed, command, failure) {
  if (failure.code === "unsupported-prefix") {
    emitResult(
      {
        tag: "error",
        attrs: { command, code: "unsupported_prefix" },
        summary: fact`received: target \`${failure.input}\` — the \`text:\` prefix is not accepted by live driving verbs; expected one of: bare CSS selector (or exact accessible name when CSS finds none), ax:<name>, axid:<id>, backend:<id>.`,
        followUp: fact`Retry \`${command}\` with \`ax:<name>\` (accessible-name substring) or a CSS selector; \`text:\` matching exists only on the query leaves.`
      },
      { json: parsed.json }
    );
    process.exitCode = 1;
    return;
  }
  if (failure.code === "invalid-css-selector") {
    emitResult(
      {
        tag: "error",
        attrs: { command, code: "invalid_css_selector" },
        summary: fact`received: bare target \`${failure.input}\` was rejected by DOM.querySelectorAll as a CSS selector.`,
        followUp: fact`Retry \`capture ${command} ax:${failure.input}\` to target that accessible name, or use \`backend:<id>\` from \`capture page elements\`.`
      },
      { json: parsed.json }
    );
    process.exitCode = 1;
    return;
  }
  const code = failure.code === "no-match" ? "no_match" : "ambiguous_target";
  const candidateRows = failure.candidates.map(
    (c) => line(data(c.role ?? "unknown"), text` "`, data(c.name ?? ""), text`" — backend:`, data(c.backendNodeId))
  );
  const sections = [];
  if (candidateRows.length > 0) {
    const shown = failure.matchCount > failure.candidates.length ? fact`candidates (first ${failure.candidates.length} of ${failure.matchCount}):` : text`candidates:`;
    sections.push(lineList([shown, ...candidateRows]));
  }
  emitResult(
    {
      tag: "error",
      attrs: { command, code },
      summary: fact`received: target \`${failure.input}\` matched ${failure.matchCount} live elements; expected exactly one.`,
      sections,
      followUp: failure.code === "no-match" ? text`Run \`capture page elements\` to list live targets with their backend:<id> keys.` : fact`Retry \`${command}\` with \`backend:<id>\` from the candidate list.`
    },
    { json: parsed.json }
  );
  process.exitCode = 1;
}
async function cmdPageClick(parsed, _args) {
  if (parsed.help) {
    console.log(USAGE);
    return;
  }
  const target = parsed.positional[0];
  if (!target || parsed.positional.length !== 1) {
    return emitInvalidInput(
      parsed,
      "page click",
      fact`received: ${parsed.positional.length} positional arguments; expected exactly one target (CSS selector or exact accessible name, ax:<name>, axid:<id>, or backend:<id>).`
    );
  }
  const settleDefaultSource = parsed.settle === void 0 ? deps2.getActiveSession() === null ? "standalone default" : "active-session default" : void 0;
  const settle = effectiveSettle(parsed, { standalone: 1e3, session: 2500 });
  const { result: outcome, settle: settleFacts } = await deps2.withPageAction(
    { ...parsed, command: "click" },
    { settleMs: settle },
    async (client) => {
      const live = client;
      const resolved = await resolveLiveTarget(live, target);
      if (!resolved.ok) return { failure: resolved };
      const dispatch2 = await clickResolved(live, resolved, { inspectHitTest: true });
      const screenshotResult = await capturePageInputScreenshot(client, "click", target, parsed.noScreenshot, parsed.out);
      return { dispatch: dispatch2, ...screenshotResult };
    }
  );
  if ("failure" in outcome) {
    return emitResolutionError(parsed, "page click", outcome.failure);
  }
  const { dispatch, screenshot, screenshotWarning } = outcome;
  const rows = [
    fact`clicked ${dispatch.role ?? "unknown"} "${dispatch.name ?? ""}" (backend:${dispatch.backendNodeId}) at x=${dispatch.x} y=${dispatch.y}`,
    ...dispatch.hitTestReceiverBackendNodeId === void 0 ? [] : [fact`dispatch hit test at x=${dispatch.x} y=${dispatch.y} resolved to backend:${dispatch.hitTestReceiverBackendNodeId}, not target backend:${dispatch.backendNodeId}`],
    fact`settle: requested ${settleFacts.requestedMs}ms, waited ${settleFacts.waitedMs}ms`,
    ...settleDefaultSource === void 0 ? [] : [fact`settle source: ${settleDefaultSource}; no --settle flag was passed.`]
  ];
  if (screenshot) rows.push(fact`screenshot: ${screenshot}`);
  if (screenshotWarning) rows.push(fact`screenshot-warning: ${screenshotWarning}`);
  emitResult(
    {
      tag: "clicked",
      attrs: {
        "backend-node-id": dispatch.backendNodeId,
        role: dispatch.role ?? void 0,
        name: dispatch.name ?? void 0,
        "hit-test-receiver-backend-node-id": dispatch.hitTestReceiverBackendNodeId
      },
      summary: lineList(rows)
    },
    { json: parsed.json }
  );
}
