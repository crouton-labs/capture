// src/cdp/scope-lock.ts
async function withScopeSerialization(client, scope, command, fn, overrides) {
  const d = overrides ?? deps;
  if (!d.isMotionHeldClient(client)) {
    return fn();
  }
  const session = d.getActiveSession();
  if (!session) {
    throw captureError(
      "internal",
      "recorder_session_missing",
      `${command} was routed through a recorder-held connection but no active session exists to serialize its ${scope} scope.`
    );
  }
  const lock = await acquirePrivateLock(path4.join(session.dir, `.${scope}-scope.lock`), {
    acquireTimeoutMs: 12e4,
    leaseMs: 6e4
  });
  try {
    return await fn();
  } finally {
    lock.release();
  }
}
