// src/cdp/measure/check.ts
function rectOf(r) {
  return { x: r.x, y: r.y, w: r.width, h: r.height };
}
function intersects(a, b) {
  return a.x < b.x + b.width && a.x + a.width > b.x && a.y < b.y + b.height && a.y + a.height > b.y;
}
function label(e) {
  return e.selector || e.id || "(unidentified element)";
}
function parentPath(domPath) {
  if (domPath == null) return void 0;
  const i = domPath.lastIndexOf("/");
  return i < 0 ? "" : domPath.slice(0, i);
}
function areDirectSiblings(a, b) {
  const pa = parentPath(a.domPath), pb = parentPath(b.domPath);
  return pa !== void 0 && pb !== void 0 && pa === pb && a.domPath !== b.domPath;
}
function parseAlphaToken(token2) {
  const t = token2.trim();
  return t.endsWith("%") ? Number(t.slice(0, -1)) / 100 : Number(t);
}
function colorAlpha(value) {
  if (value == null) return void 0;
  const v = value.trim().toLowerCase();
  if (v === "transparent" || v === "") return 0;
  const hex = /^#([0-9a-f]+)$/.exec(v);
  if (hex) {
    const h = hex[1];
    if (h.length === 4) return parseInt(h[3] + h[3], 16) / 255;
    if (h.length === 8) return parseInt(h.slice(6, 8), 16) / 255;
    if (h.length === 3 || h.length === 6) return 1;
    return void 0;
  }
  const fn = /^[a-z-]+\((.*)\)$/.exec(v);
  if (fn) {
    const inner = fn[1];
    if (inner.includes(",")) {
      const parts = inner.split(",");
      if (parts.length >= 4) {
        const a = parseAlphaToken(parts[3]);
        return Number.isFinite(a) ? Math.min(1, Math.max(0, a)) : void 0;
      }
      return 1;
    }
    const slash = inner.split("/");
    if (slash.length >= 2) {
      const a = parseAlphaToken(slash[slash.length - 1]);
      return Number.isFinite(a) ? Math.min(1, Math.max(0, a)) : void 0;
    }
    return 1;
  }
  if (/^[a-z]+$/.test(v)) return 1;
  return void 0;
}
function backgroundAlphaMap(ref) {
  const byNode = /* @__PURE__ */ new Map();
  const bySelector = /* @__PURE__ */ new Map();
  try {
    const styles = readRequired(ref, "styles.json");
    for (const s of styles.elements ?? []) {
      const alpha = colorAlpha(s.computed?.backgroundColor ?? s.computed?.["background-color"]);
      if (alpha === void 0) continue;
      if (s.backendNodeId != null) byNode.set(s.backendNodeId, alpha);
      if (s.selector) bySelector.set(s.selector, alpha);
    }
  } catch {
  }
  return { byNode, bySelector };
}
function effectiveOpacity(e, byPath) {
  let opacity = e.visibility?.opacity ?? 1;
  let p = parentPath(e.domPath);
  while (p) {
    const ancestor = byPath.get(p);
    if (!ancestor) break;
    opacity *= ancestor.visibility?.opacity ?? 1;
    p = parentPath(ancestor.domPath);
  }
  return opacity;
}
function isOpaque(e, bg, byPath) {
  if (effectiveOpacity(e, byPath) < 1) return false;
  const alpha = (e.backendNodeId != null ? bg.byNode.get(e.backendNodeId) : void 0) ?? (e.selector ? bg.bySelector.get(e.selector) : void 0);
  return alpha !== void 0 && alpha >= 1;
}
