function recoveryResult2(err) {
  const detail = err instanceof ArtifactResolutionError || err instanceof Error ? err.message : "The snapshot artifacts could not be resolved.";
  return {
    tag: "error",
    attrs: { command: "measure map ax", status: "artifact_unavailable" },
