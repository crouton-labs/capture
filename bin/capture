    ]);
    TimelineFrameModel = class {
      #frames = [];
      #frameById = {};
      #beginFrameQueue = new TimelineFrameBeginFrameQueue();
      #lastFrame = null;
      #mainFrameCommitted = false;
      #mainFrameRequested = false;
      #lastLayerTree = null;
      #framePendingActivation = null;
      #framePendingCommit = null;
      #lastBeginFrame = null;
      #lastNeedsBeginFrame = null;
