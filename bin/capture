function bounded(value) {
  return Math.min(1, Math.max(0, value));
}
function rgbChannel(token2) {
  const value = token2.trim();
  return value.endsWith("%") ? Number(value.slice(0, -1)) * 2.55 : Number(value);
}
function fromOklab(lightness, a, b, alpha) {
  if (![lightness, a, b, alpha].every(Number.isFinite) || alpha < 0 || alpha > 1) return void 0;
  const l = (lightness + 0.3963377774 * a + 0.2158037573 * b) ** 3;
  const m = (lightness - 0.1055613458 * a - 0.0638541728 * b) ** 3;
  const s = (lightness - 0.0894841775 * a - 1.291485548 * b) ** 3;
  const linear = [4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s, -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s, -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s];
  const channel = (value) => 255 * (value <= 31308e-7 ? 12.92 * bounded(value) : 1.055 * bounded(value) ** (1 / 2.4) - 0.055);
  return { red: channel(linear[0]), green: channel(linear[1]), blue: channel(linear[2]), alpha };
}
function rgba(value) {
  const input = value?.trim().toLowerCase();
  if (!input) return void 0;
  if (input === "transparent") return { red: 0, green: 0, blue: 0, alpha: 0 };
  const hex = /^#([\da-f]{3,4}|[\da-f]{6}|[\da-f]{8})$/i.exec(input);
  if (hex) {
    const digits = hex[1].length <= 4 ? hex[1].split("").map((digit) => digit + digit).join("") : hex[1];
    return { red: parseInt(digits.slice(0, 2), 16), green: parseInt(digits.slice(2, 4), 16), blue: parseInt(digits.slice(4, 6), 16), alpha: digits.length === 8 ? parseInt(digits.slice(6, 8), 16) / 255 : 1 };
  }
  const rgb = /^rgba?\(\s*([^,\s]+)(?:\s*,\s*|\s+)([^,\s]+)(?:\s*,\s*|\s+)([^,\s]+)(?:\s*(?:,|\/)\s*([^\s)]+))?\s*\)$/i.exec(input);
  if (rgb) {
    const channels = [rgbChannel(rgb[1]), rgbChannel(rgb[2]), rgbChannel(rgb[3])];
    const alpha = rgb[4] === void 0 ? 1 : parseAlphaToken(rgb[4]);
    return channels.some((channel) => !Number.isFinite(channel) || channel < 0 || channel > 255) || !Number.isFinite(alpha) || alpha < 0 || alpha > 1 ? void 0 : { red: channels[0], green: channels[1], blue: channels[2], alpha };
  }
  const oklab = /^oklab\(\s*([\d.]+)(?:\s*,\s*|\s+)([-\d.]+)(?:\s*,\s*|\s+)([-\d.]+)(?:\s*(?:,|\/)\s*([^\s)]+))?\s*\)$/i.exec(input);
  if (oklab) return fromOklab(Number(oklab[1]), Number(oklab[2]), Number(oklab[3]), oklab[4] === void 0 ? 1 : parseAlphaToken(oklab[4]));
  const oklch = /^oklch\(\s*([\d.]+)(?:\s*,\s*|\s+)([\d.]+)(?:\s*,\s*|\s+)([-\d.]+)(?:\s*(?:,|\/)\s*([^\s)]+))?\s*\)$/i.exec(input);
  if (oklch) {
    const chroma = Number(oklch[2]);
    const hue = Number(oklch[3]) * Math.PI / 180;
    return fromOklab(Number(oklch[1]), chroma * Math.cos(hue), chroma * Math.sin(hue), oklch[4] === void 0 ? 1 : parseAlphaToken(oklch[4]));
  }
  return void 0;
}
function composite(over, under) {
  const alpha = over.alpha + under.alpha * (1 - over.alpha);
  if (alpha === 0) return { red: 0, green: 0, blue: 0, alpha: 0 };
  return {
    red: (over.red * over.alpha + under.red * under.alpha * (1 - over.alpha)) / alpha,
    green: (over.green * over.alpha + under.green * under.alpha * (1 - over.alpha)) / alpha,
    blue: (over.blue * over.alpha + under.blue * under.alpha * (1 - over.alpha)) / alpha,
    alpha
  };
}
function applyOpacity(paint, opacity) {
  return { ...paint, alpha: paint.alpha * opacity };
}
function styleFor(element, stylesByNode, stylesBySelector) {
  return (element.backendNodeId === null || element.backendNodeId === void 0 ? void 0 : stylesByNode.get(element.backendNodeId)) ?? (element.selector === void 0 ? void 0 : stylesBySelector.get(element.selector)) ?? (element.tag === void 0 ? void 0 : stylesBySelector.get(element.tag));
}
function remainingOpacityIsOne(element, byPath) {
  let ancestor = element.domPath === void 0 ? void 0 : byPath.get(parentPath(element.domPath) ?? "");
  while (ancestor) {
    if ((ancestor.visibility?.opacity ?? 1) !== 1) return false;
    ancestor = ancestor.domPath === void 0 ? void 0 : byPath.get(parentPath(ancestor.domPath) ?? "");
  }
  return true;
}
function effectiveBackground(target, byPath, stylesByNode, stylesBySelector) {
  let element = target;
  let background = { red: 0, green: 0, blue: 0, alpha: 0 };
  let source;
  while (element) {
    const style = styleFor(element, stylesByNode, stylesBySelector);
    const paint = rgba(style?.computed?.backgroundColor ?? style?.computed?.["background-color"]);
    if (!paint) return void 0;
    const wasOpaque = background.alpha === 1;
    background = applyOpacity(composite(background, paint), element.visibility?.opacity ?? 1);
    if (!wasOpaque && background.alpha === 1) source = element;
    else if (background.alpha < 1) source = void 0;
    if (background.alpha === 1 && source && remainingOpacityIsOne(element, byPath)) return { color: [Math.round(background.red), Math.round(background.green), Math.round(background.blue)], source };
    element = element.domPath === void 0 ? void 0 : byPath.get(parentPath(element.domPath) ?? "");
  }
  return void 0;
}
function effectiveForeground(foreground, target, byPath, stylesByNode, stylesBySelector) {
  let element = target;
  let background = { red: 0, green: 0, blue: 0, alpha: 0 };
  let rendered = foreground;
  while (element) {
    const style = styleFor(element, stylesByNode, stylesBySelector);
    const paint = rgba(style?.computed?.backgroundColor ?? style?.computed?.["background-color"]);
    if (!paint) return void 0;
    const opacity = element.visibility?.opacity ?? 1;
    background = applyOpacity(composite(background, paint), opacity);
    rendered = applyOpacity(composite(rendered, paint), opacity);
    if (background.alpha === 1 && remainingOpacityIsOne(element, byPath)) return [Math.round(rendered.red), Math.round(rendered.green), Math.round(rendered.blue)];
    element = element.domPath === void 0 ? void 0 : byPath.get(parentPath(element.domPath) ?? "");
  }
  return void 0;
}
function contrastRatio(foreground, background) {
  const lum = (channels) => channels.reduce((sum, channel, index) => {
    const v = channel / 255;
    return sum + (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4) * [0.2126, 0.7152, 0.0722][index];
  }, 0);
  const a = lum(foreground), b = lum(background);
  return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
}
function measureElementContrast(ref, elementId) {
  const elements = readGeometry(ref).elements ?? [];
  const element = elements.find((candidate) => candidate.id === elementId);
  if (!element) return { available: false, uncertainty: "the selected geometry record is not present in geometry.json" };
  const styles = readRequired(ref, "styles.json").elements ?? [];
  const stylesByNode = /* @__PURE__ */ new Map();
  const stylesBySelector = /* @__PURE__ */ new Map();
  const byPath = /* @__PURE__ */ new Map();
  for (const candidate of elements) if (candidate.domPath) byPath.set(candidate.domPath, candidate);
  for (const style2 of styles) {
    if (style2.backendNodeId != null) stylesByNode.set(style2.backendNodeId, style2);
    if (style2.selector) stylesBySelector.set(style2.selector, style2);
  }
  const style = styleFor(element, stylesByNode, stylesBySelector);
  const foreground = rgba(style?.computed?.color);
  if (!foreground) return { available: false, uncertainty: "the selected element has no parseable recorded computed color" };
  const background = effectiveBackground(element, byPath, stylesByNode, stylesBySelector);
  if (!background) return { available: false, uncertainty: "an opaque effective background could not be resolved from recorded ancestor paint and opacity" };
  const renderedForeground = effectiveForeground(foreground, element, byPath, stylesByNode, stylesBySelector);
  if (!renderedForeground) return { available: false, uncertainty: "the effective foreground could not be resolved through recorded ancestor paint and opacity" };
  const backgroundSource = label(background.source);
  return {
    available: true,
    foreground: renderedForeground,
    background: background.color,
    ratio: contrastRatio(renderedForeground, background.color),
    backgroundSource,
    backgroundSourceElementId: background.source.id,
    provenance: `computed color; effective background supplied by ${backgroundSource}'s opaque paint after compositing recorded descendant backgrounds`
  };
}
function checkSnapshot(ref, requested) {
  const geometry = readGeometry(ref);
  const elements = geometry.elements ?? [];
  const meta = readMeta(ref);
  const selected = new Set(requested);
  const findings = [];
  const vp = viewport(meta, elements);
  const visible = elements.filter((e) => e.visibility?.visible !== false && e.rect.width > 0 && e.rect.height > 0);
  if (selected.has("overlap")) {
    const bg = backgroundAlphaMap(ref);
    const paint = paintOrderMap(ref);
    const byPath = /* @__PURE__ */ new Map();
    for (const e of elements) if (e.domPath) byPath.set(e.domPath, e);
    for (let i = 0; i < visible.length; i++) for (let j = i + 1; j < visible.length; j++) {
      const a = visible[i], b = visible[j];
      if (!intersects(a.rect, b.rect)) continue;
      if (!areDirectSiblings(a, b)) continue;
      const above = paintsAbove(a, b, paint);
      if (above === void 0) continue;
      const [over, under] = above ? [a, b] : [b, a];
      if (!isOpaque(over, bg, byPath)) continue;
      const ix = Math.max(a.rect.x, b.rect.x), iy = Math.max(a.rect.y, b.rect.y);
      const iw = Math.min(a.rect.x + a.rect.width, b.rect.x + b.rect.width) - ix;
      const ih = Math.min(a.rect.y + a.rect.height, b.rect.y + b.rect.height) - iy;
      const underArea = under.rect.width * under.rect.height;
      const pct = underArea > 0 ? Math.round(iw * ih / underArea * 100) : 0;
      const stacking = over.stackingContext?.creates ? `; ${label(over)} creates a stacking context` : "";
      findings.push(finding(
        "overlap",
        under,
        `${label(under)} ${pct}% occluded by ${label(over)}; ${label(under)} x=${under.rect.x} y=${under.rect.y} w=${under.rect.width} h=${under.rect.height} and ${label(over)} x=${over.rect.x} y=${over.rect.y} w=${over.rect.width} h=${over.rect.height}; overlap ${iw}\xD7${ih}px`,
        `${label(over)} paints above ${label(under)} in DOMSnapshot paint order${stacking}`
      ));
    }
  }
  if (selected.has("offscreen")) for (const e of visible) {
    const insideW = Math.max(0, Math.min(e.rect.x + e.rect.width, vp.width) - Math.max(e.rect.x, 0));
    const insideH = Math.max(0, Math.min(e.rect.y + e.rect.height, vp.height) - Math.max(e.rect.y, 0));
    if (insideW < e.rect.width || insideH < e.rect.height) findings.push(finding("offscreen", e, `${label(e)} has ${insideW}\xD7${insideH}px inside viewport ${vp.width}\xD7${vp.height}; rect x=${e.rect.x} y=${e.rect.y} w=${e.rect.width} h=${e.rect.height}`));
  }
  if (selected.has("overflow")) {
    for (const e of elements) if ((e.layout?.scrollWidth ?? 0) > (e.layout?.clientWidth ?? 0)) findings.push(finding("overflow", e, `${label(e)} scrollWidth ${e.layout.scrollWidth}px > clientWidth ${e.layout.clientWidth}px`, `overflow-x ${e.layout?.overflowX ?? "unavailable"}`));
  }
  if (selected.has("tap-targets")) {
    for (const e of visible) if (/^(button|a|input|select|textarea)$/i.test(e.tag ?? "") && (e.rect.width < 44 || e.rect.height < 44)) findings.push(finding("tap-targets", e, `${label(e)} measures ${e.rect.width}\xD7${e.rect.height}px; threshold is 44\xD744px`));
  }
  if (selected.has("contrast")) {
    const styles = readRequired(ref, "styles.json").elements ?? [];
    const stylesByNode = /* @__PURE__ */ new Map();
    const stylesBySelector = /* @__PURE__ */ new Map();
    const byPath = /* @__PURE__ */ new Map();
    for (const element of elements) if (element.domPath) byPath.set(element.domPath, element);
    for (const style of styles) {
      if (style.backendNodeId != null) stylesByNode.set(style.backendNodeId, style);
      if (style.selector) stylesBySelector.set(style.selector, style);
    }
    for (const style of styles) {
      const foreground = rgba(style.computed?.color);
      const element = elements.find((candidate) => style.backendNodeId != null && candidate.backendNodeId === style.backendNodeId || candidate.selector === style.selector);
      if (!foreground || !element) continue;
      const background = effectiveBackground(element, byPath, stylesByNode, stylesBySelector);
      const renderedForeground = effectiveForeground(foreground, element, byPath, stylesByNode, stylesBySelector);
      if (!background || !renderedForeground) continue;
      const ratio = contrastRatio(renderedForeground, background.color);
      if (ratio < 4.5) {
        const source = label(background.source);
        findings.push(finding("contrast", element, `contrast ratio ${ratio.toFixed(2)}:1 \u2014 ${style.selector ?? label(element)} foreground ${style.computed?.color} against composited background rgb(${background.color.join(", ")})`, `computed color; effective background supplied by ${source}'s opaque paint after compositing recorded descendant backgrounds`));
      }
    }
  }
  if (selected.has("hit-test")) {
    const hit = readHittest(ref);
    for (const sample of hit.elements ?? []) {
      const e = elements.find((x) => sample.backendNodeId != null && x.backendNodeId === sample.backendNodeId || sample.selector && x.selector === sample.selector);
      if (!e) continue;
      const point = sample.points?.find((p) => {
        const receiver = p.result?.topReceiver;
        const receiverElement = receiver && elements.find((x) => receiver.backendNodeId != null && x.backendNodeId === receiver.backendNodeId);
        return receiverElement !== void 0 && !isSelfOrDescendant(e, receiverElement);
      })?.result;
      if (!point?.topReceiver) continue;
      findings.push(finding("hit-test", e, `${label(e)} sampled point (${point.x},${point.y}) resolves to non-descendant receiver ${point.topReceiver.selector ?? "unidentified element"}`, point.stack?.map((x) => `${x.selector ?? x.pointerEvents ?? "element"}${x.opacity === 0 ? " opacity 0" : ""}`).join(", ")));
    }
  }
  if (selected.has("truncation")) {
    for (const t of readText(ref).elements ?? []) if (t.truncated) {
      const e = elements.find((x) => t.backendNodeId != null && x.backendNodeId === t.backendNodeId || x.selector === t.selector);
      findings.push(finding("truncation", e, `${t.selector ?? label(e ?? {})} scrollWidth ${t.scrollWidth ?? 0}px > clientWidth ${t.clientWidth ?? 0}px`));
    }
  }
  if (selected.has("forms")) {
    for (const control of readForms(ref).controls ?? []) if (control.rect && (control.rect.width === 0 || control.rect.height === 0 || control.rect.x + control.rect.width < 0 || control.rect.y + control.rect.height < 0 || control.rect.x > vp.width || control.rect.y > vp.height)) findings.push({ kind: "forms", selector: control.selector, rect: rectOf(control.rect), detail: `${control.selector ?? "form control"} rect x=${control.rect.x} y=${control.rect.y} w=${control.rect.width} h=${control.rect.height} is outside or zero-sized in viewport ${vp.width}\xD7${vp.height}` });
  }
  if (selected.has("media")) {
    for (const media of readRequired(ref, "media.json").elements ?? []) if (media.visible === false || (media.naturalWidth === 0 || media.naturalHeight === 0) || media.decodeState === "loading") findings.push({ kind: "media", elementId: media.id, selector: media.selector, rect: rectOf(media.rect), detail: `${media.selector ?? media.id ?? "media element"} visible=${String(media.visible)} natural=${media.naturalWidth ?? "unavailable"}\xD7${media.naturalHeight ?? "unavailable"} rendered=${media.renderedWidth ?? media.rect.width}\xD7${media.renderedHeight ?? media.rect.height} decode=${media.decodeState ?? "unavailable"}` });
  }
  if (selected.has("animation")) {
    for (const animation of readAnimation(ref).animations ?? []) if (animation.infinite) findings.push({ kind: "animation", elementId: animation.id, selector: animation.selector ?? void 0, detail: `${animation.selector ?? animation.id ?? "animation"} duration ${animation.durationMs ?? "unavailable"}ms, iteration-count ${animation.iterationCount ?? "unavailable"}, playState ${animation.playState ?? "unavailable"}` });
  }
  const regions = unstableRegionsFor(ref);
  const annotated = annotateUnstableFacts(findings.map((f) => ({ ...f, elementId: f.elementId, rect: f.rect })), regions);
  return { findings: annotated.map(({ fact: fact4, caveats }) => ({ ...fact4, caveats })), elementCount: elements.length, settled: meta.settled, viewport: vp };
}
function writeFindingCrop(ref, finding2, index) {
  if (!finding2.rect || !artifactExists(ref, "screenshot.png")) return void 0;
  const source = import_pngjs4.PNG.sync.read(fs25.readFileSync(artifactPath(ref, "screenshot.png")));
  const x = Math.max(0, Math.floor(finding2.rect.x));
  const y = Math.max(0, Math.floor(finding2.rect.y));
  const w = Math.max(1, Math.min(source.width - x, Math.ceil(finding2.rect.w)));
  const h = Math.max(1, Math.min(source.height - y, Math.ceil(finding2.rect.h)));
  if (x >= source.width || y >= source.height || w <= 0 || h <= 0) return void 0;
  const crop = new import_pngjs4.PNG({ width: w, height: h });
  import_pngjs4.PNG.bitblt(source, crop, x, y, w, h, 0, 0);
  const name = `${index + 1}-${finding2.kind}.png`;
  writeBinaryPrivate(path30.join(ref.dir, "findings", name), import_pngjs4.PNG.sync.write(crop));
  return `${ref.id}/findings/${name}`;
}
