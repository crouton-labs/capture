        const natural = fact4.naturalWidth !== null && fact4.naturalHeight !== null ? { w: fact4.naturalWidth, h: fact4.naturalHeight } : null;
        const intrinsicAspectRatio = natural && natural.w > 0 && natural.h > 0 ? natural.w / natural.h : null;
        const crop = fact4.styleUnavailable ? null : computeObjectFitCrop(natural, { w: fact4.rect.width, h: fact4.rect.height }, fact4.objectFit, fact4.objectPosition);
        return {
          id: `m-${index}`,
          selector: fact4.cssPath ? sanitizeString(fact4.cssPath) : "",
          ...resolvedIdentity8(resolved[index]?.backendNodeId),
          tag: fact4.tag,
          rect: fact4.rect,
          visible: fact4.visible,
          naturalWidth: fact4.naturalWidth,
          naturalHeight: fact4.naturalHeight,
          renderedWidth: fact4.rect.width,
          renderedHeight: fact4.rect.height,
          devicePixelRatio: fact4.dpr,
          currentSrc: sanitizeOptional2(fact4.currentSrc),
          decodeState: fact4.decodeState,
          intrinsicAspectRatio,
          objectFit: sanitizeOptional2(fact4.objectFit),
          objectPosition: sanitizeOptional2(fact4.objectPosition),
          crop,
          styleUnavailable: fact4.styleUnavailable || void 0,
          intrinsicDimsUnavailable: fact4.intrinsicDimsUnavailable || void 0,
          contextType: fact4.contextType,
          backingWidth: fact4.backingWidth,
          backingHeight: fact4.backingHeight,
          poster: fact4.tag === "video" ? sanitizeOptional2(fact4.poster) : void 0,
          src: fact4.tag === "iframe" ? sanitizeOptional2(fact4.src) : void 0,
          crossOrigin: fact4.tag === "iframe" ? fact4.crossOrigin : void 0
        };
      });
      ctx.write.json("media.json", {
        elements,
        elementsTruncated,
        totalCount,
        coverage: { scope: "top-document" },
        identity: identity3,
        available,
        ...unavailableReason ? { unavailableReason } : {}
      });
    };
  }
});

// src/cdp/measure/snapshot.ts
function resolveScopedArtifactPath(dir, filename) {
  const target = path27.resolve(dir, filename);
  const rel = path27.relative(dir, target);
  const escapesDir = rel === ".." || rel.startsWith(`..${path27.sep}`) || path27.isAbsolute(rel);
  if (escapesDir) {
    throw new Error(`Refusing to write snapshot artifact "${filename}" outside its snap dir ${dir}`);
  }
  return target;
}
function makeWriter(dir, artifacts) {
  return {
    json(filename, value) {
      writeJsonPrivate(resolveScopedArtifactPath(dir, filename), value);
      artifacts.push(filename);
    },
    binary(filename, data32) {
      writeBinaryPrivate(resolveScopedArtifactPath(dir, filename), data32);
      artifacts.push(filename);
    },
    remove(filename) {
      const index = artifacts.lastIndexOf(filename);
      if (index !== -1) artifacts.splice(index, 1);
      try {
        unlinkPrivateFile(resolveScopedArtifactPath(dir, filename));
      } catch {
      }
    }
  };
}
function makeCollectorWriter(writer) {
  const staged = [];
  let open = true;
  return {
    writer: {
      json(filename, value) {
        if (open) staged.push({ filename, value });
      },
      binary(filename, data32) {
        if (open) staged.push({ filename, data: data32 });
      }
    },
    commit() {
      if (!open) return;
      open = false;
      const written = [];
      try {
        for (const artifact of staged) {
          if ("data" in artifact) writer.binary(artifact.filename, artifact.data);
          else writer.json(artifact.filename, artifact.value);
          written.push(artifact.filename);
        }
      } catch (error4) {
        for (const filename of written.reverse()) writer.remove(filename);
        throw error4;
      } finally {
        staged.length = 0;
      }
    },
    discard() {
      open = false;
      staged.length = 0;
    }
  };
}
function boundedClient(client, phase, partialPath, onTimeout, requestTimeoutCapMs = SNAPSHOT_REQUEST_TIMEOUT_MS) {
  const bounded2 = Object.create(client);
  bounded2.send = (method, params = {}, timeout = 6e4, sessionId) => {
    const timeoutMs = Math.min(timeout, requestTimeoutCapMs);
    let timer;
    let timedOut = false;
    const markTimedOut = (error4) => {
      if (timedOut) return;
      timedOut = true;
      onTimeout?.(error4);
    };
    const deadline = new Promise((_, reject) => {
      timer = setTimeout(() => {
        const error4 = new SnapshotCaptureTimeout(phase, method, timeoutMs, partialPath);
        markTimedOut(error4);
        reject(error4);
      }, timeoutMs);
    });
    const request = Promise.resolve().then(() => client.send(method, params, timeoutMs, sessionId)).catch((error4) => {
      if (error4 instanceof SnapshotCaptureTimeout) throw error4;
      if (error4 instanceof Error && error4.message.startsWith("CDP request timeout")) {
        const timeoutError = new SnapshotCaptureTimeout(phase, method, timeoutMs, partialPath);
        markTimedOut(timeoutError);
        throw timeoutError;
      }
      throw error4;
    });
    return Promise.race([request, deadline]).finally(() => {
      if (timer) clearTimeout(timer);
    });
  };
  return bounded2;
}
async function captureSnapshotSubstrate(options) {
  const client = options.target.client;
  const dir = ensurePrivateDir(options.path);
  const snapId = options.snapId ?? path27.basename(dir);
  const settleTimeoutMs = options.settleTimeout ?? DEFAULT_SETTLE_TIMEOUT_MS;
  const quietThresholdMs = options.quietThresholdMs ?? DEFAULT_QUIET_THRESHOLD_MS;
  const pollIntervalMs = options.pollIntervalMs ?? DEFAULT_POLL_INTERVAL_MS;
  const freezeAnimations = options.freezeAnimations ?? false;
  const captureUnsettled = options.captureUnsettled ?? false;
  const pixels = options.pixels ?? false;
  const state = options.state ?? [];
  const viewport2 = options.viewport ?? null;
  const colorScheme = options.colorScheme;
  const stateDiffPaddingCssPx = options.stateDiffPaddingCssPx ?? 8;
  const url = options.url ? sanitizeString(options.url) : null;
  const artifacts = [];
  const phaseClient = (phase) => boundedClient(client, phase, dir);
  await enableDomainsForSnap(phaseClient("domains"));
  let animationFreezeHandle;
  let animationsRestored = freezeAnimations ? false : void 0;
  let freezeOverrideApplied;
  let freezeIncomplete;
  let unfrozenCount;
  if (freezeAnimations) {
    animationFreezeHandle = await freezeAnimationsBeforeCapture(phaseClient("freeze-animations"));
    freezeOverrideApplied = animationFreezeHandle?.rateOverrideApplied;
    freezeIncomplete = animationFreezeHandle?.freezeIncomplete;
    unfrozenCount = animationFreezeHandle?.unfrozenCount;
  }
  const restoreAnimationsOnce = async () => {
    if (!animationFreezeHandle) return;
    const handle = animationFreezeHandle;
    animationFreezeHandle = void 0;
    const result = await restoreAnimationsAfterCapture(phaseClient("restore-animations"), handle);
    animationsRestored = result.restored;
  };
  try {
    const churnHandle = await injectChurnObservers(phaseClient("settle-observers"));
    let settleResult;
    try {
      settleResult = await pollForSettle({
        captureSample: buildDomSettleSampler(phaseClient("settle"), churnHandle),
        isEqual: domSignaturesEqual,
        settleTimeoutMs,
        quietThresholdMs,
        pollIntervalMs
      });
    } catch (pollError) {
      try {
        await collectChurnEvidence(phaseClient("settle-cleanup"), churnHandle);
      } catch {
      }
      throw pollError;
    }
    const churnEvidenceRaw = await collectChurnEvidence(phaseClient("settle-cleanup"), churnHandle);
    const settled = settleResult.settled;
    const captured = settled || captureUnsettled;
    const unstable = !settled;
    let unstableRegions = [];
    let domHtmlFact;
    const collectorOutcomes = [];
    if (unstable) {
      const animationEvidence = await collectAnimationEvidence(phaseClient("settle-evidence"));
      const grouped = groupChurnEvidence(churnEvidenceRaw, animationEvidence, settleResult.elapsedMs, settleTimeoutMs);
      unstableRegions = grouped.unstableRegions;
      writeJsonPrivate(path27.join(dir, "churn.json"), grouped.report);
      artifacts.push("churn.json");
      if (!captured) {
        writeJsonPrivate(path27.join(dir, "animation.json"), animationEvidence);
        artifacts.push("animation.json");
      }
    }
    if (captured) {
      const ctx = {
        client,
        dir,
        snapId,
        url,
        viewport: viewport2,
        settled,
        freezeAnimations,
        captureUnsettled,
        pixels,
        state,
        unstableRegions,
        ...{ stateDiffPaddingCssPx },
        write: makeWriter(dir, artifacts)
      };
      const collectors = options.collectors ?? COLLECTORS;
      const skipCollectors = new Set(options.skipCollectors ?? []);
      const baseline = collectors.filter((c) => c.phase === "baseline");
      const mutating = collectors.filter((c) => c.phase === "mutating");
      const runCollector = async (collector) => {
        if (skipCollectors.has(collector.name)) return { name: collector.name, status: "skipped" };
        const startedAt = Date.now();
        let requestTimeouts = 0;
        let timeoutError;
        const collectorWriter = makeCollectorWriter(ctx.write);
        try {
          await collector.fn({
            ...ctx,
            client: boundedClient(client, `collector:${collector.name}`, dir, (error4) => {
              requestTimeouts += 1;
              timeoutError ??= error4;
            }, collector.name === "scroll" ? SCROLL_COLLECTOR_REQUEST_TIMEOUT_MS : SNAPSHOT_REQUEST_TIMEOUT_MS),
            write: collectorWriter.writer
          });
          if (collector.name === "styles" && timeoutError) throw timeoutError;
          const ms = Date.now() - startedAt;
          collectorWriter.commit();
          return requestTimeouts > 0 ? { name: collector.name, status: "degraded", ms, requestTimeouts } : { name: collector.name, status: "ok", ms };
        } catch (error4) {
          const ms = Date.now() - startedAt;
          collectorWriter.discard();
          if (collector.name === "styles" && error4 instanceof SnapshotCaptureTimeout) throw error4;
          return { name: collector.name, status: "error", ms, ...requestTimeouts > 0 ? { requestTimeouts } : {} };
        }
      };
      for (const collector of baseline) collectorOutcomes.push(await runCollector(collector));
      const screenshotResponse = await phaseClient("baseline-screenshot").send("Page.captureScreenshot", { format: "png" });
      writeBinaryPrivate(path27.join(dir, "screenshot.png"), Buffer.from(screenshotResponse.data, "base64"));
      artifacts.push("screenshot.png");
      let domHtmlValue;
      let domHtmlUnavailableReason;
      try {
        const domResponse = await phaseClient("baseline-dom").send("Runtime.evaluate", {
          expression: "document.documentElement.outerHTML",
          returnByValue: true
        });
        domHtmlValue = domResponse.result?.value;
        if (domHtmlValue === void 0) {
          domHtmlUnavailableReason = "dom-evaluate-returned-no-value";
        }
      } catch {
        domHtmlValue = void 0;
        domHtmlUnavailableReason = "dom-evaluate-threw";
      }
      if (domHtmlValue === void 0) {
        domHtmlFact = { available: false, unavailableReason: domHtmlUnavailableReason };
      } else {
        writePrivateFile(path27.join(dir, "dom.html"), domHtmlValue);
        artifacts.push("dom.html");
        domHtmlFact = { available: true };
      }
      await restoreAnimationsOnce();
      for (const collector of mutating) collectorOutcomes.push(await runCollector(collector));
    } else {
      await restoreAnimationsOnce();
    }
    const meta = {
      id: snapId,
      url,
      viewport: viewport2,
      settled,
      capturedAt: (/* @__PURE__ */ new Date()).toISOString(),
      settleMs: settleResult.elapsedMs,
      settleTimeoutMs,
      freezeAnimations,
      captureUnsettled,
      pixels,
      states: state.map((spec) => sanitizeString(spec)),
      ...colorScheme ? { colorScheme } : {},
      unstableRegionCount: unstableRegions.length,
      ...freezeAnimations ? { animationsRestored: animationsRestored ?? false } : {},
      // #8: the browser-wide `Animation.setPlaybackRate({playbackRate:0})`
      // override itself failing to apply is a genuine I-6 fact distinct from
      // `animationsRestored` above (which reflects only the RESTORE step) —
      // a page can restore cleanly from whatever WAS frozen at origin-capture
      // time while still never having had the browser-wide override applied,
      // meaning any animation created after freeze was never covered. Only
      // ever written when the override genuinely failed; a successful
      // override (or freeze never requested / origin capture itself failed,
      // both already covered elsewhere) leaves this field absent — never a
      // fabricated affirmative value standing in for "we don't actually know".
      ...freezeOverrideApplied === false ? { freezeOverrideApplied: false } : {},
      // #72: only the noteworthy (incomplete) case is ever written — same
      // convention as `freezeOverrideApplied` above. A clean freeze (or
      // freeze not requested, or origin capture itself failed) leaves this
      // absent; a consumer must never read the absence as "confirmed clean"
      // on its own, only alongside the other freeze facts already emitted
      // (`animationsRestored`, `freezeOverrideApplied`) that cover those
      // other cases. `unfrozenCount` is only ever emitted alongside a `true`
      // `freezeIncomplete`, matching the handle's own documented contract.
      ...freezeIncomplete === true ? { freezeIncomplete: true, unfrozenCount: unfrozenCount ?? 0 } : {},
      ...domHtmlFact ? { domHtml: domHtmlFact } : {},
      ...captured ? { collectors: collectorOutcomes } : {}
    };
    writeJsonPrivate(path27.join(dir, "meta.json"), meta);
    artifacts.push("meta.json");
    return {
      id: snapId,
      dir,
      url,
      viewport: viewport2,
      settled,
      captured,
      settleMs: settleResult.elapsedMs,
      settleTimeoutMs,
      unstableRegions,
      artifacts,
      collectors: collectorOutcomes,
      meta
    };
  } catch (error4) {
    if (error4 instanceof SnapshotCaptureTimeout) {
      try {
        writeJsonPrivate(path27.join(dir, "capture-timeout.json"), {
          schemaVersion: 1,
          id: snapId,
          status: "timeout",
          phase: error4.phase,
          method: error4.method,
          timeoutMs: error4.timeoutMs,
          partialPath: dir,
          artifacts,
          capturedAt: (/* @__PURE__ */ new Date()).toISOString()
        });
        artifacts.push("capture-timeout.json");
      } catch {
      }
    }
    throw error4;
  } finally {
    await restoreAnimationsOnce();
  }
}
var path27, COLLECTORS, COLLECTOR_NAMES, SNAPSHOT_REQUEST_TIMEOUT_MS, SCROLL_COLLECTOR_REQUEST_TIMEOUT_MS, SnapshotCaptureTimeout;
var init_snapshot = __esm({
  "src/cdp/measure/snapshot.ts"() {
    path27 = __toESM(require("path"));
    init_artifacts();
    init_domains();
    init_settle();
    init_redaction();
    init_geometry();
    init_hittest();
    init_styles();
    init_queries();
    init_ax();
    init_text();
    init_forms();
    init_animation();
    init_focus();
    init_scroll2();
    init_layers();
    init_pixels();
    init_states();
    init_media();
    COLLECTORS = [
      { name: "geometry", phase: "baseline", fn: collectGeometry },
      { name: "ax", phase: "baseline", fn: collectAx },
      { name: "styles", phase: "baseline", fn: collectStyles },
      { name: "queries", phase: "baseline", fn: collectQueries },
      { name: "animation", phase: "baseline", fn: collectAnimation },
      { name: "layers", phase: "baseline", fn: collectLayers },
      { name: "media", phase: "baseline", fn: collectMedia },
      { name: "hittest", phase: "baseline", fn: collectHittest },
      { name: "text", phase: "baseline", fn: collectText },
      { name: "forms", phase: "baseline", fn: collectForms },
      { name: "focus", phase: "mutating", fn: collectFocus },
      { name: "scroll", phase: "mutating", fn: collectScroll },
      { name: "states", phase: "mutating", fn: collectStates },
      { name: "pixels", phase: "mutating", fn: collectPixels }
    ];
    COLLECTOR_NAMES = COLLECTORS.map((collector) => collector.name);
    SNAPSHOT_REQUEST_TIMEOUT_MS = 5e3;
    SCROLL_COLLECTOR_REQUEST_TIMEOUT_MS = 3e4;
    SnapshotCaptureTimeout = class extends Error {
      constructor(phase, method, timeoutMs, partialPath) {
        super(`snapshot capture timed out in ${phase} while waiting for ${method} after ${timeoutMs}ms; partial artifacts: ${partialPath}`);
        this.phase = phase;
        this.method = method;
        this.timeoutMs = timeoutMs;
        this.partialPath = partialPath;
        this.name = "SnapshotCaptureTimeout";
      }
      code = "snapshot_capture_timeout";
    };
  }
});

// src/output/artifact.ts
function isUrlRef(ref) {
  return /^[a-zA-Z][a-zA-Z0-9+.-]*:\/\//.test(ref);
}
function stripTrailingSep(p) {
  return p.length > 1 && (p.endsWith("/") || p.endsWith(path28.sep)) ? p.slice(0, -1) : p;
}
function resolveRefFromPath(ref, config3) {
  const resolved = assertUnderCaptureRoot(stripTrailingSep(ref));
  const metaPath = path28.join(resolved, "meta.json");
  if (!fs23.existsSync(metaPath)) {
    throw new ArtifactResolutionError(
      ref,
      [resolved],
      `no ${config3.label} found at this path (missing meta.json)`,
      config3.creatingCommand
    );
  }
  return { kind: config3.kind, id: path28.basename(resolved), dir: resolved };
}
function resolveRefFromId(ref, config3) {
  const active = getActiveSession();
  if (!active) {
    throw new ArtifactResolutionError(
      ref,
      [],
      `no active capture session \u2014 a bare id resolves against the active session's ${config3.idSegments.join("/")} directory`,
      `capture session start (then re-run), or pass the absolute ${config3.label} path printed by ${config3.creatingCommand}`
    );
  }
  const dir = path28.join(active.dir, ...config3.idSegments, ref);
  const resolved = assertUnderCaptureRoot(dir);
  const metaPath = path28.join(resolved, "meta.json");
  if (!fs23.existsSync(metaPath)) {
    throw new ArtifactResolutionError(
      ref,
      [resolved],
      `no ${config3.label} named ${JSON.stringify(ref)} found in the active session (${active.sessionId})`,
      config3.creatingCommand
    );
  }
  return { kind: config3.kind, id: ref, dir: resolved };
}
function rejectRelativePath(ref) {
  if (!path28.isAbsolute(ref) && (ref.includes("/") || ref.includes(path28.sep))) {
    throw new ArtifactResolutionError(
      ref,
      [],
      "relative paths are not accepted \u2014 pass an absolute artifact path (as printed by the capturing command) or a bare id"
    );
  }
}
async function resolveSnapRef(ref, options = {}) {
  if (isUrlRef(ref)) {
    if (!options.onUrl) {
      throw new ArtifactResolutionError(ref, [], "this command does not accept a URL target \u2014 pass a snapshot id or path instead");
    }
    const result = await options.onUrl(ref);
    return { kind: "snap", id: result.id, dir: assertUnderCaptureRoot(result.dir) };
  }
  if (path28.isAbsolute(ref)) return resolveRefFromPath(ref, SNAP_CONFIG);
  rejectRelativePath(ref);
  return resolveRefFromId(ref, SNAP_CONFIG);
}
function resolveRecRef(ref) {
  if (isUrlRef(ref)) {
    throw new ArtifactResolutionError(
      ref,
      [],
      "a recording ref cannot be a URL \u2014 record one first with `capture motion rec <url> --do <action>` or `--start`/`--stop`"
    );
  }
  if (path28.isAbsolute(ref)) return resolveRefFromPath(ref, REC_CONFIG);
  rejectRelativePath(ref);
  return resolveRefFromId(ref, REC_CONFIG);
}
function resolveTraceRef(ref) {
  if (isUrlRef(ref)) {
    throw new ArtifactResolutionError(ref, [], "a trace ref cannot be a URL \u2014 record one first with `capture perf trace <url>` or `--start`/`--stop`");
  }
  const resolved = path28.isAbsolute(ref) ? resolveRefFromPath(ref, TRACE_CONFIG) : (rejectRelativePath(ref), resolveRefFromId(ref, TRACE_CONFIG));
  let meta;
  try {
    meta = JSON.parse(readPrivateFile(path28.join(resolved.dir, "meta.json")).toString("utf8"));
  } catch (error4) {
    throw new ArtifactResolutionError(ref, [path28.join(resolved.dir, "meta.json")], `could not read trace metadata: ${error4 instanceof Error ? error4.message : String(error4)}`, TRACE_CONFIG.creatingCommand);
  }
  const completion = meta.completion;
  if (completion !== "complete" && completion !== "partial" && completion !== "orphaned") {
    throw new ArtifactResolutionError(ref, [path28.join(resolved.dir, "meta.json")], "trace metadata has no valid completion state", TRACE_CONFIG.creatingCommand);
  }
  const inventory = meta.files;
  const inventoryMalformed = !Array.isArray(inventory);
  const inventoryMismatch = !inventoryMalformed && inventory.some((entry) => {
    if (!entry || typeof entry !== "object" || Array.isArray(entry)) return true;
    const item = entry;
    const name = item.name;
    const bytes = item.bytes;
    if (typeof name !== "string" || typeof bytes !== "number" || !Number.isSafeInteger(bytes) || bytes < 0 || name.includes(path28.sep)) return true;
    try {
      return fs23.statSync(path28.join(resolved.dir, name)).size !== bytes;
    } catch {
      return true;
    }
  });
  const truncatedReason = inventoryMalformed ? "artifact_inventory_missing_or_malformed" : inventoryMismatch ? "artifact_inventory_mismatch" : void 0;
  return { ...resolved, completion: truncatedReason ? "truncated" : completion, ...truncatedReason ? { reason: truncatedReason } : typeof meta.reason === "string" ? { reason: meta.reason } : {} };
}
function creatingCommandFor(filename) {
  return CREATING_COMMAND_BY_FILE[filename];
}
function artifactPath(ref, filename, opts = {}) {
  const filePath = assertUnderCaptureRoot(path28.join(ref.dir, filename));
  const mustExist = opts.mustExist ?? true;
  if (mustExist && !fs23.existsSync(filePath)) {
    throw new ArtifactResolutionError(
      ref.id,
      [filePath],
      `${filename} is not present in ${ref.kind === "snap" ? "snapshot" : ref.kind === "rec" ? "recording" : "trace"} ${ref.id}`,
      creatingCommandFor(filename)
    );
  }
  return filePath;
}
function artifactExists(ref, filename) {
  return fs23.existsSync(assertUnderCaptureRoot(path28.join(ref.dir, filename)));
}
function readJsonArtifactFile(ref, filename) {
  const filePath = artifactPath(ref, filename);
  let raw;
  try {
    raw = fs23.readFileSync(filePath, "utf-8");
  } catch (err) {
    throw new ArtifactResolutionError(
      ref.id,
      [filePath],
      `could not read ${filename}: ${err instanceof Error ? err.message : String(err)}`,
      creatingCommandFor(filename)
    );
  }
  try {
    return JSON.parse(raw);
  } catch (err) {
    throw new ArtifactResolutionError(
      ref.id,
      [filePath],
      `${filename} is not valid JSON: ${err instanceof Error ? err.message : String(err)}`,
      creatingCommandFor(filename)
    );
  }
}
function readNdjsonArtifactFile(ref, filename) {
  const filePath = artifactPath(ref, filename);
  let raw;
  try {
    raw = fs23.readFileSync(filePath, "utf-8");
  } catch (err) {
    throw new ArtifactResolutionError(
      ref.id,
      [filePath],
      `could not read ${filename}: ${err instanceof Error ? err.message : String(err)}`,
      creatingCommandFor(filename)
    );
  }
  const lines = raw.split("\n").filter((l) => l.trim().length > 0);
  return lines.map((line4, i) => {
    try {
      return JSON.parse(line4);
    } catch (err) {
      throw new ArtifactResolutionError(
        ref.id,
        [filePath],
        `${filename} line ${i + 1} is not valid JSON: ${err instanceof Error ? err.message : String(err)}`,
        creatingCommandFor(filename)
      );
    }
  });
}
function assertKind(ref, kind, fnName) {
  if (ref.kind !== kind) {
    throw new TypeError(`${fnName} expects a ${kind} ref, got a ${ref.kind} ref (${ref.id})`);
  }
}
function readMeta(ref) {
  return readJsonArtifactFile(ref, "meta.json");
}
