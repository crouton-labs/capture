            expandedCharCodes.push(code1);
          } else if (code3 === 0 && ch4 !== 0) {
            expandedCharCodes.push(code1, code2);
          } else {
            expandedCharCodes.push(code1, code2, code3);
          }
          i += 4;
        }
        return getStringFromExpandedCharCodes(expandedCharCodes);
      }
