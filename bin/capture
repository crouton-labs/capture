        function emitObjectLiteralExpression(node) {
          pushNameGenerationScope(node);
          forEach(node.properties, generateMemberNames);
          const indentedFlag = getEmitFlags(node) & 131072;
          if (indentedFlag) {
            increaseIndent();
          }
