      writer;
      accepting = false;
      chunks = 0;
      garbageCollected = false;
      enabled = false;
      onChunk = (params) => {
        if (!this.accepting) return;
        const chunk = params?.chunk;
        if (typeof chunk !== "string") {
          this.ctx?.noteLoss("invalid_heap_snapshot_chunk");
          return;
        }
        this.writer.write(chunk);
        this.chunks += 1;
      };
      async start(ctx) {
