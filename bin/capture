// src/cdp/host/client.ts
function sendHostRequest(socketPath, request, timeoutMs = 15e3) {
  return new Promise((resolve12, reject) => {
    const socket = net.createConnection(socketPath);
    let buffer = "";
    const timer = setTimeout(() => {
      socket.destroy();
      reject(new Error(`collector host request timed out after ${timeoutMs}ms`));
    }, timeoutMs);
    socket.once("connect", () => socket.write(JSON.stringify({ ...request, reqId: ++requestId }) + "\n"));
    socket.on("data", (chunk) => {
      buffer += chunk.toString("utf8");
      const newline = buffer.indexOf("\n");
      if (newline === -1) return;
      clearTimeout(timer);
      socket.end();
      try {
        resolve12(JSON.parse(buffer.slice(0, newline)));
      } catch (error4) {
        reject(error4);
      }
    });
    socket.once("error", (error4) => {
      clearTimeout(timer);
      reject(error4);
    });
  });
}
