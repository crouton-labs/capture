        function shouldEmitBlockFunctionBodyOnSingleLine(body2) {
          if (getEmitFlags(body2) & 1) {
            return true;
          }
          if (body2.multiLine) {
            return false;
          }
          if (!nodeIsSynthesized(body2) && currentSourceFile && !rangeIsOnSingleLine(body2, currentSourceFile)) {
            return false;
          }
          if (getLeadingLineTerminatorCount(
            body2,
            firstOrUndefined(body2.statements),
            2
            /* PreserveLines */
          ) || getClosingLineTerminatorCount(body2, lastOrUndefined(body2.statements), 2, body2.statements)) {
            return false;
          }
          let previousStatement;
          for (const statement of body2.statements) {
            if (getSeparatingLineTerminatorCount(
              previousStatement,
              statement,
              2
              /* PreserveLines */
            ) > 0) {
              return false;
            }
            previousStatement = statement;
          }
          return true;
        }
