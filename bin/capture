          if (node.type !== BaseNode.types.CPU) {
            continue;
          }
          if (timing2.duration < minDurationMs) {
            continue;
          }
          events.push({
            start: timing2.startTime,
            end: timing2.endTime,
            duration: timing2.duration
          });
        }
        return events;
      }
    };
