          const isLast = node.kind === 15 || node.kind === 18;
          text2 = text2.substring(1, text2.length - (isLast ? 1 : 2));
        }
        text2 = text2.replace(/\r\n?/g, "\n");
        return setTextRange(factory2.createStringLiteral(text2), node);
      }
