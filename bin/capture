      containerQuery: winner.rule?.containerQueries?.length ? sanitizeString(winner.rule.containerQueries.map((cq) => cq.text).join(" ; ")) : void 0,
      winnerApproximate: winnerApproximateReason !== void 0 ? true : void 0,
      winnerApproximateReason,
      sourceResolutionUnavailable,
      sourceResolutionUnavailableReason
    });
  }
  return declarations2;
}
