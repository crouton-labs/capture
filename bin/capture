        };
        this.#computeInsightSet(data32, context);
      }
      /**
       * Computes insights for a specific navigation event.
       */
      #computeInsightsForNavigation(navigation, bounds, data32, traceEvents3, options) {
        const frameId = navigation.args.frame;
