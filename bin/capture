// src/errors.ts
function captureError(kind, code, message, cause) {
  return new CaptureError({ kind, code, message, cause });
}
function invalidInput(message, code = "invalid_input") {
  return captureError("invocation", code, message);
}
function worldFailure(message, cause) {
  return captureError("world", "world_failure", message, cause);
}
function normalizeFailure(error4) {
  if (error4 instanceof CaptureError) return error4;
  if (error4 instanceof AggregateError) return normalizeAggregateFailure(error4);
  const message = error4 instanceof Error ? error4.message : String(error4);
  return captureError("internal", "internal_error", message || "Capture encountered an unknown internal failure.", error4);
}
function normalizeAggregateFailure(error4) {
  const subs = error4.errors.map((sub) => normalizeFailure(sub));
  const primary = subs[0];
  const message = [error4.message, ...subs.map((sub, i) => `[${i + 1}] ${sub.descriptor.message}`)].filter((part) => part.length > 0).join(" ");
  if (primary === void 0) {
    return captureError("internal", "internal_error", message || "Capture encountered an empty aggregate failure.", error4);
  }
  return captureError(primary.descriptor.kind, primary.descriptor.code, message, error4);
}
function failureResult(error4) {
  const { descriptor } = normalizeFailure(error4);
  return {
    tag: "error",
    attrs: { code: descriptor.code, kind: descriptor.kind },
    summary: fact`${descriptor.message}`
  };
}
var CaptureError;
var init_errors = __esm({
  "src/errors.ts"() {
    init_render();
    CaptureError = class extends Error {
      descriptor;
      constructor(descriptor) {
        super(descriptor.message, descriptor.cause === void 0 ? void 0 : { cause: descriptor.cause });
        this.name = "CaptureError";
        this.descriptor = descriptor;
      }
    };
  }
});

// src/session/artifacts.ts
function hook(operation, phase, path48, component) {
  const detail = { operation, phase, path: path48, component };
  hooks?.onHook?.(detail);
  hooks?.[phase]?.(detail);
}
function syscall(role, real) {
  faults?.before?.(role);
  return real();
}
function closeDescriptor(fd, role, afterRealClose) {
  faults?.before?.(role);
  fs.closeSync(fd);
  afterRealClose?.();
  faults?.after?.(role);
}
function combineFailure(primary, secondary, message) {
  throw new AggregateError([primary, secondary], message);
}
function identity(stat) {
  return { dev: stat.dev, ino: stat.ino };
}
function sameIdentity(a, b) {
  return a.dev === b.dev && a.ino === b.ino;
}
function errno(error4) {
  return error4.code;
}
function isMissing(error4) {
  return errno(error4) === "ENOENT";
}
function assertName(name) {
  if (!name || name === "." || name === ".." || name.includes(path.sep)) throw new Error(`invalid artifact path component: ${name}`);
}
function writeAll(fd, data32, role = "artifact-data-write") {
  const bytes = Buffer.isBuffer(data32) ? data32 : Buffer.from(data32);
  for (let off = 0; off < bytes.length; ) {
    const remaining = bytes.length - off;
    faults?.before?.(role);
    if (!faults?.write) {
      const wrote2 = fs.writeSync(fd, bytes, off, remaining);
      if (!Number.isSafeInteger(wrote2) || wrote2 <= 0 || wrote2 > remaining) throw new Error("short private artifact write");
      off += wrote2;
      continue;
    }
    const prescribed = faults.write(role, () => remaining);
    if (!Number.isSafeInteger(prescribed) || prescribed <= 0 || prescribed > remaining) throw new Error("short private artifact write");
    const wrote = fs.writeSync(fd, bytes, off, prescribed);
    if (!Number.isSafeInteger(wrote) || wrote <= 0 || wrote > prescribed) throw new Error("short private artifact write");
    off += wrote;
  }
}
function privateDirHere() {
  const fd = fs.openSync(".", fs.constants.O_RDONLY | fs.constants.O_DIRECTORY | fs.constants.O_NOFOLLOW);
  try {
    fs.fchmodSync(fd, DIR_MODE);
  } finally {
    fs.closeSync(fd);
  }
}
function loadRegisteredArtifactRoots() {
  if (loadingArtifactRoots || !fs.existsSync(CAPTURE_ROOT)) return;
  loadingArtifactRoots = true;
  try {
    let records;
    try {
      records = readPrivateFile(ARTIFACT_ROOT_REGISTRY).toString("utf8");
    } catch (error4) {
      if (isMissing(error4)) return;
      throw error4;
    }
    for (const [index, line4] of records.split("\n").entries()) {
      if (!line4) continue;
      let value;
      try {
        value = JSON.parse(line4);
      } catch {
        throw new Error(`invalid artifact root registry record ${index + 1}`);
      }
      if (!value || typeof value !== "object" || Array.isArray(value) || Object.keys(value).length !== 1 || typeof value.root !== "string") throw new Error(`invalid artifact root registry record ${index + 1}`);
      const root = value.root;
      if (!path.isAbsolute(root) || path.resolve(root) !== root) throw new Error(`invalid artifact root registry record ${index + 1}`);
      artifactRoots.add(root);
    }
  } finally {
    loadingArtifactRoots = false;
  }
}
function rootForPath(target) {
  return [...artifactRoots].find((root) => target === root || target.startsWith(`${root}${path.sep}`));
}
function registeredArtifactRoots() {
  loadRegisteredArtifactRoots();
  return [...artifactRoots];
}
function verifyRoot(root, actual) {
  const prior = artifactRootIdentities.get(root);
  if (prior && !sameIdentity(prior, actual)) throw new Error("artifact root changed since it was first established");
  artifactRootIdentities.set(root, actual);
}
function rootOrAncestor(current) {
  return [...artifactRoots].some((root) => current === root || root.startsWith(`${current}${path.sep}`));
}
function registerArtifactRoot(root) {
  if (!path.isAbsolute(root)) throw new Error("--artifact-dir must be an absolute path");
  const resolved = path.resolve(root);
  loadRegisteredArtifactRoots();
  if (artifactRoots.has(resolved)) return resolved;
  artifactRoots.add(resolved);
  try {
    inPinnedDirectory(resolved, true, () => void 0, "root-bootstrap");
    appendNdjsonPrivate(ARTIFACT_ROOT_REGISTRY, { root: resolved });
  } catch (error4) {
    artifactRoots.delete(resolved);
    throw error4;
  }
  return resolved;
}
function inPinnedDirectory(absoluteDir, create, operation, operationKind = "traversal") {
  if (cwdPinned) throw new Error("nested private artifact cwd transaction");
  if (!path.isAbsolute(absoluteDir)) throw new Error(`private artifact directory must be absolute: ${absoluteDir}`);
  cwdPinned = true;
  const original = process.cwd();
  const originalIdentity = identity(fs.statSync("."));
  let result;
  let failure;
  try {
    const root = path.parse(absoluteDir).root;
    process.chdir(root);
    let current = root;
    for (const component of absoluteDir.slice(root.length).split(path.sep).filter(Boolean)) {
      assertName(component);
      current = path.join(current, component);
      const artifactRoot = rootForPath(current);
      const privateComponent = artifactRoot !== void 0;
      const darwinSystemAlias = process.platform === "darwin" && (current === "/var" || current === "/tmp") && [...artifactRoots].some((root2) => root2.startsWith(`${current}/`));
      const hookOperation = artifactRoots.has(current) || darwinSystemAlias ? "root-bootstrap" : operationKind;
      let before;
      try {
        before = fs.lstatSync(component);
        hook(hookOperation, "afterComponentLstat", current, component);
      } catch (error4) {
        if (!create || !(privateComponent || rootOrAncestor(current)) || !isMissing(error4)) throw error4;
        hook(hookOperation, "beforeComponentCreate", current, component);
        try {
          fs.mkdirSync(component, { mode: DIR_MODE });
        } catch (createError) {
          if (errno(createError) !== "EEXIST") throw createError;
        }
        before = fs.lstatSync(component);
      }
      if (before.isSymbolicLink() && darwinSystemAlias) {
        const expected2 = identity(fs.statSync(component));
        hook(hookOperation, "beforeComponentChdir", current, component);
        process.chdir(component);
        hook(hookOperation, "afterComponentChdirBeforeIdentityCheck", current, component);
        if (!sameIdentity(expected2, identity(fs.statSync(".")))) throw new Error(`artifact directory changed while pinning: ${component}`);
        continue;
      }
      if (before.isSymbolicLink()) throw new Error(`refusing symlinked artifact directory component: ${component}`);
      if (!before.isDirectory()) throw new Error(`refusing non-directory artifact component: ${component}`);
      const expected = identity(before);
      hook(hookOperation, "beforeComponentChdir", current, component);
      process.chdir(component);
      hook(hookOperation, "afterComponentChdirBeforeIdentityCheck", current, component);
      if (!sameIdentity(expected, identity(fs.statSync(".")))) throw new Error(`artifact directory changed while pinning: ${component}`);
      if (artifactRoots.has(current)) {
        verifyRoot(current, expected);
        hook("root-bootstrap", "afterRootPinned", current, component);
      }
      if (privateComponent) privateDirHere();
    }
    hook(absoluteDir === CAPTURE_ROOT ? "root-bootstrap" : operationKind, "afterParentPinned", absoluteDir);
    result = operation();
  } catch (error4) {
    failure = error4;
  }
  let restoreFailure;
  try {
    process.chdir(original);
    if (!sameIdentity(originalIdentity, identity(fs.statSync(".")))) restoreFailure = new Error("private artifact cwd restoration changed directory identity");
  } catch (error4) {
    restoreFailure = error4;
  }
  cwdPinned = false;
  if (restoreFailure) {
    if (failure) throw new AggregateError([failure, restoreFailure], "private artifact cwd restoration failed");
    throw restoreFailure;
  }
  if (failure) throw failure;
  return result;
}
function assertUnderCaptureRoot(targetPath) {
  const resolved = path.resolve(targetPath);
  loadRegisteredArtifactRoots();
  const root = rootForPath(resolved);
  if (!root || resolved === root) throw new Error(`artifact path escapes capture root or registered artifact root: ${targetPath}`);
  return resolved;
}
function pinnedParent(target, operation, create = true, operationKind = "traversal") {
  const resolved = assertUnderCaptureRoot(target);
  const name = path.basename(resolved);
  assertName(name);
  return inPinnedDirectory(path.dirname(resolved), create, () => operation(name), operationKind);
}
function ensurePrivateDir(dirPath) {
  const resolved = assertUnderCaptureRoot(dirPath);
  inPinnedDirectory(resolved, true, () => void 0);
  return resolved;
}
function openRegular(name, flags, create = false, onOpened, closeRole = "artifact-temp-close", hookOperation = "final-file") {
  let fd;
  try {
    fd = syscall("artifact-open", () => fs.openSync(name, flags | fs.constants.O_NOFOLLOW, create ? FILE_MODE : void 0));
    onOpened?.(fd);
    hook(hookOperation, "afterFinalOpen", path.resolve(process.cwd(), name), name);
    const stat = syscall("artifact-fstat", () => fs.fstatSync(fd));
    if (!stat.isFile()) throw new Error(`artifact is not a regular file: ${name}`);
    syscall("artifact-fchmod", () => fs.fchmodSync(fd, FILE_MODE));
    hook(hookOperation, "afterDescriptorValidated", path.resolve(process.cwd(), name), name);
    return fd;
  } catch (error4) {
    if (fd !== void 0) {
      try {
        closeDescriptor(fd, closeRole);
      } catch (closeError) {
        combineFailure(error4, closeError, "private artifact descriptor setup failed");
      }
    }
    throw error4;
  }
}
function createPrivateFile(filePath, data32 = "") {
  pinnedParent(filePath, (name) => {
    let fd;
    let created;
    let closed = false;
    let primary;
    try {
      fd = openRegular(name, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL, true, (opened) => {
        created = identity(fs.fstatSync(opened));
      });
      writeAll(fd, data32);
      syscall("artifact-temp-fsync", () => fs.fsyncSync(fd));
      closeDescriptor(fd, "artifact-temp-close", () => {
        closed = true;
      });
    } catch (error4) {
      primary = error4;
    }
    if (fd !== void 0 && !closed) {
      try {
        closeDescriptor(fd, "artifact-temp-close", () => {
          closed = true;
        });
      } catch (closeError) {
        if (primary) combineFailure(primary, closeError, "private artifact creation failed");
        throw closeError;
      }
    }
    if (primary) {
      try {
        cleanupOwnedFile(name, created);
      } catch (cleanupError) {
        combineFailure(primary, cleanupError, "private artifact creation cleanup failed");
      }
      throw primary;
    }
  });
}
function readFd(fd) {
  const chunks = [];
  const chunk = Buffer.allocUnsafe(65536);
  for (; ; ) {
    const n = fs.readSync(fd, chunk, 0, chunk.length, null);
    if (!n) return Buffer.concat(chunks);
    chunks.push(Buffer.from(chunk.subarray(0, n)));
  }
}
function readPrivateFile(filePath) {
  return pinnedParent(filePath, (name) => {
    const fd = openRegular(name, fs.constants.O_RDONLY);
    let value;
    let primary;
    try {
      value = readFd(fd);
    } catch (error4) {
      primary = error4;
    }
    try {
      closeDescriptor(fd, "artifact-temp-close");
    } catch (closeError) {
      if (primary) combineFailure(primary, closeError, "private artifact read failed");
      throw closeError;
    }
    if (primary) throw primary;
    return value;
  });
}
function openPrivateAppendFd(filePath) {
  return pinnedParent(filePath, (name) => openRegular(name, fs.constants.O_WRONLY | fs.constants.O_APPEND | fs.constants.O_CREAT, true));
}
function openPrivateChunkWriter(filePath) {
  const target = assertUnderCaptureRoot(filePath);
  const partial = `${target}.part`;
  const fd = openPrivateAppendFd(partial);
  let closed = false;
  let finished = false;
  let bytes = 0;
  const close = () => {
    if (closed) return;
    fs.fsyncSync(fd);
    closeDescriptor(fd, "artifact-temp-close");
    closed = true;
  };
  return {
    write(data32) {
      if (finished) throw new Error("chunk writer is already finalized");
      const buffer = Buffer.isBuffer(data32) ? data32 : Buffer.from(data32);
      writeAll(fd, buffer);
      bytes += buffer.length;
    },
    commit() {
      if (finished) return bytes;
      close();
      pinnedParent(target, (name) => {
        const partName = `${name}.part`;
        const part = fs.lstatSync(partName);
        if (!part.isFile()) throw new Error(`chunk artifact is not a regular file: ${partName}`);
        try {
          if (fs.lstatSync(name).isSymbolicLink()) throw new Error(`refusing to replace symlinked private artifact: ${name}`);
        } catch (error4) {
          if (!isMissing(error4)) throw error4;
        }
        fs.renameSync(partName, name);
      });
      finished = true;
      return bytes;
    },
    discard() {
      if (finished) return;
      try {
        close();
      } catch {
        if (!closed) {
          try {
            fs.closeSync(fd);
          } catch {
          }
          closed = true;
        }
      }
      try {
        unlinkPrivateFile(partial);
      } catch (error4) {
        if (!isMissing(error4)) throw error4;
      }
      finished = true;
    }
  };
}
function appendPrivateFile(filePath, data32) {
  pinnedParent(filePath, (name) => {
    const fd = openRegular(name, fs.constants.O_WRONLY | fs.constants.O_APPEND);
    let primary;
    try {
      writeAll(fd, data32);
      syscall("artifact-temp-fsync", () => fs.fsyncSync(fd));
    } catch (error4) {
      primary = error4;
    }
    try {
      closeDescriptor(fd, "artifact-temp-close");
    } catch (closeError) {
      if (primary) combineFailure(primary, closeError, "private artifact append failed");
      throw closeError;
    }
    if (primary) throw primary;
  });
}
function cleanupOwnedFile(name, expected) {
  if (!expected) return;
  let lastFailure;
  for (let attempt = 0; attempt < 2; attempt++) {
    try {
      const current = fs.lstatSync(name);
      if (!sameIdentity(expected, identity(current)) || !current.isFile()) return;
      hook("final-file", "beforeOwnedCleanupUnlink", path.resolve(process.cwd(), name), name);
      const rechecked = fs.lstatSync(name);
      if (!sameIdentity(expected, identity(rechecked)) || !rechecked.isFile()) return;
      syscall("artifact-cleanup-unlink", () => fs.unlinkSync(name));
      return;
    } catch (error4) {
      if (isMissing(error4)) return;
      lastFailure = error4;
    }
  }
  throw lastFailure;
}
function writePrivateFile(filePath, data32) {
  pinnedParent(filePath, (name) => {
    try {
      if (fs.lstatSync(name).isSymbolicLink()) throw new Error(`refusing to replace symlinked private artifact: ${name}`);
    } catch (error4) {
      if (!isMissing(error4)) throw error4;
    }
    const temporary = `.${name}.${process.pid}.${artifactTempToken()}.tmp`;
    let fd;
    let created;
    let closed = false;
    let published = false;
    let primary;
    try {
      hook("final-file", "beforeTempCreate", path.resolve(process.cwd(), temporary), temporary);
      fd = openRegular(temporary, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL, true, (opened) => {
        created = identity(fs.fstatSync(opened));
      });
      hook("final-file", "afterTempCreate", path.resolve(process.cwd(), temporary), temporary);
      writeAll(fd, data32);
      syscall("artifact-temp-fsync", () => fs.fsyncSync(fd));
      closeDescriptor(fd, "artifact-temp-close", () => {
        closed = true;
      });
      hook("final-file", "beforeRename", path.resolve(process.cwd(), name), name);
      const temporaryState = fs.lstatSync(temporary);
      if (!created || !temporaryState.isFile() || !sameIdentity(created, identity(temporaryState))) throw new Error(`private artifact temporary replaced before rename: ${temporary}`);
      syscall("artifact-rename", () => fs.renameSync(temporary, name));
      published = true;
    } catch (error4) {
      primary = error4;
    }
    if (fd !== void 0 && !closed) {
      try {
        closeDescriptor(fd, "artifact-temp-close", () => {
          closed = true;
        });
      } catch (closeError) {
        if (primary) combineFailure(primary, closeError, "private artifact replacement failed");
        throw closeError;
      }
    }
    if (primary) {
      if (!published) {
        try {
          cleanupOwnedFile(temporary, created);
        } catch (cleanupError) {
          combineFailure(primary, cleanupError, "private artifact replacement cleanup failed");
        }
      }
      throw primary;
    }
  });
}
function unlinkPrivateFile(filePath) {
  pinnedParent(filePath, (name) => {
    const stat = fs.lstatSync(name);
    if (stat.isSymbolicLink() || !stat.isFile()) throw new Error(`refusing to unlink non-regular private artifact: ${name}`);
    hook("final-file", "beforeUnlink", path.resolve(process.cwd(), name), name);
    syscall("artifact-cleanup-unlink", () => fs.unlinkSync(name));
  });
}
function writeJsonPrivate(filePath, value) {
  writePrivateFile(filePath, JSON.stringify(value, null, 2));
}
function writeNdjsonPrivate(filePath, records) {
  writePrivateFile(filePath, records.map((record5) => JSON.stringify(record5)).join("\n") + (records.length ? "\n" : ""));
}
function appendNdjsonPrivate(filePath, record5) {
  const line4 = `${JSON.stringify(record5)}
`;
  try {
    appendPrivateFile(filePath, line4);
  } catch (error4) {
    if (!isMissing(error4)) throw error4;
    try {
      createPrivateFile(filePath, line4);
    } catch (created) {
      if (errno(created) === "EEXIST") appendPrivateFile(filePath, line4);
      else throw created;
    }
  }
}
function writeBinaryPrivate(filePath, data32) {
  writePrivateFile(filePath, data32);
}
function removePinnedEntry(name) {
  const absolute = path.resolve(process.cwd(), name);
  const stat = fs.lstatSync(name);
  hook("recursive-removal", "afterChildLstat", absolute, name);
  if (stat.isSymbolicLink() || stat.isFile()) {
