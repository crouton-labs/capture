                setTextRange(
                  factory2.createAssignment(
                    thisArg,
                    callee.expression
                  ),
                  callee.expression
                ),
                callee.name
              );
              setTextRange(target, callee);
            } else {
              thisArg = callee.expression;
              target = callee;
            }
          } else if (isElementAccessExpression(callee)) {
            if (shouldBeCapturedInTempVariable(callee.expression, cacheIdentifiers)) {
