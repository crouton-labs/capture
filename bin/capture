// src/cdp/motion/recorder.ts
function motionHandle(handle, recId) {
  return handle.collectors.find((collector) => collector.id === recId && collector.kind === "motion") ?? null;
}
function finalFromMeta(recDir, recId) {
  const meta = JSON.parse(readPrivateFile(path36.join(recDir, "meta.json")).toString("utf8"));
  const frames2 = typeof meta.frames === "number" ? meta.frames : 0;
  const durationMs = typeof meta.durationMs === "number" ? meta.durationMs : 0;
  return {
    recId,
    recDir,
    frames: frames2,
    durationMs,
    fps: durationMs > 0 ? Math.round(frames2 / (durationMs / 1e3) * 10) / 10 : 0,
    state: meta.state === "partial" ? "partial" : meta.completion === "orphaned" ? "orphaned-finalized" : "finalized",
    eventCount: typeof meta.eventCount === "number" ? meta.eventCount : null,
    viewportRestored: typeof meta.viewportRestored === "boolean" ? meta.viewportRestored : null,
    viewportRetained: meta.viewportRetained === true
  };
}
async function liveHost(sessionDir2) {
  const scanned = scanCollectorHost(sessionDir2);
  if (scanned.classification !== "live" || !scanned.handle) throw captureError("precondition", "recorder_unavailable", `This session has no live collector host (${scanned.classification}).`);
  return scanned.handle;
}
async function startComposedRecorder(opts, deps23 = {}) {
  const operation = await admitSessionOperation(opts.sessionDir);
  try {
    return await withSessionLifecycle(opts.sessionDir, async () => {
      const session = getActiveSession();
      if (!session || session.dir !== opts.sessionDir) throw new Error("The active capture session is no longer available.");
      if (!session.targetId) throw new Error("The active session has no attached tab to record. Start it with a URL: `capture session start --url <url>`.");
      if (!session.harId) throw new Error("The active session has no live HAR recording id (harId); cannot arm a recorder without its HAR evidence store.");
      const port = session.port ?? await (deps23.detectPort?.() ?? Promise.reject(new Error("The active session has no CDP port.")));
      await updateSessionState(opts.sessionDir, { targetId: session.targetId, port });
      let scanned = scanCollectorHost(opts.sessionDir);
      if (scanned.classification === "unknown" || scanned.classification === "malformed") throw captureError("precondition", "recorder_unavailable", `This session's collector host is ${scanned.classification}.`);
      if (scanned.classification === "dead") {
        const reaped = await stopAndReapCollectorHostAtSessionStop(opts.sessionDir);
        if (reaped.status === "terminal") throw new Error(reaped.error);
        scanned = scanCollectorHost(opts.sessionDir);
      }
      if (scanned.classification === "absent") {
        const spawn4 = deps23.spawnCollectorHost ?? startCollectorHost;
        await spawn4(collectorHostSocketPath(opts.sessionDir), port, session.targetId, opts.sessionDir);
        scanned = scanCollectorHost(opts.sessionDir);
      }
      if (scanned.classification !== "live" || !scanned.handle) throw new Error("Collector host did not publish a live handle.");
      if (scanned.handle.targetId !== session.targetId) throw new Error("A collector host is bound to a different session target. Stop the session before changing tabs.");
      if (scanned.handle.collectors.some((collector2) => collector2.kind === "motion")) throw new Error("A recording is already active on this session. Stop it first: `capture motion rec --stop`.");
      const response = await sendHostRequest(scanned.handle.socketPath, { type: "collector-start", nonce: scanned.handle.nonce, kind: "motion", config: { harId: session.harId, viewport: opts.viewport } }, 3e4);
      if (!response.ok || !response.collector || typeof response.collector !== "object") throw new StartRecorderError(response.error ?? "collector host refused to start motion recording");
      const collector = response.collector;
      if (typeof collector.id !== "string" || typeof collector.dir !== "string") throw new StartRecorderError("collector host returned a malformed motion collector");
      await setActiveRecId(collector.id);
      return { recId: collector.id, recDir: collector.dir, state: "recording", reapedStale: null };
    });
  } finally {
    await operation.release();
  }
}
async function stopComposedRecorder(opts) {
  return withSessionLifecycle(opts.sessionDir, async () => {
    const recId = opts.recId ?? getActiveRecId();
    if (!recId) throw new Error("No active recording on this session. Start one first: `capture motion rec --start`.");
    const host = await liveHost(opts.sessionDir);
    const row = motionHandle(host, recId);
    if (!row) throw new Error(`No live motion collector named "${recId}".`);
    const response = await sendHostRequest(host.socketPath, { type: "collector-stop", nonce: host.nonce, id: recId }, 3e4);
    if (!response.ok) throw new Error(response.error ?? "collector host refused to stop motion recording");
    if (getActiveSession()?.dir === opts.sessionDir && getActiveRecId() === recId) await clearActiveRecId();
    return finalFromMeta(row.dir, recId);
  });
}
var path36, StartRecorderError;
var init_recorder = __esm({
  "src/cdp/motion/recorder.ts"() {
    path36 = __toESM(require("node:path"));
    init_artifacts();
    init_errors();
    init_session_context();
    init_coordinator();
    init_spawn();
    init_client2();
    init_handle();
    init_lifecycle();
    StartRecorderError = class extends Error {
      constructor(message, viewportRestored = null) {
        super(message);
        this.viewportRestored = viewportRestored;
        this.name = "StartRecorderError";
      }
    };
  }
});

// src/cdp/commands/motion/rec.ts
async function cmdMotionRec(parsed, _args) {
  if (parsed.help) {
    console.log(USAGE28);
    return;
  }
  const lifecycleError = validateLifecycleInputs(parsed);
  if (lifecycleError) return emitCommandError(parsed, lifecycleError.status, lifecycleError.message);
  let viewport2;
  if (parsed.viewport !== void 0) {
    try {
      viewport2 = parseViewport(parsed.viewport);
    } catch (error4) {
      return emitCommandError(parsed, "invalid_viewport", error4 instanceof Error ? error4.message : String(error4));
    }
  }
  if (parsed.start) return handleStart(parsed, viewport2);
  if (parsed.stop) return handleStop(parsed);
  return handleOneShot(parsed, viewport2);
}
async function handleOneShot(parsed, viewport2) {
  const url = parsed.positional[0];
  const active = deps6.getActiveSession();
  if (!parsed.do || parsed.positional.length > 1 || !url && !active) {
    return emitCommandError(parsed, "invalid_oneshot", "One-shot recording requires a URL (or an active session tab) and `--do <action>`.");
  }
  if (!active?.targetId && !url) {
    return emitCommandError(parsed, "no_session_target", "Active capture session has no target tab to record.");
  }
  if (!Number.isFinite(parsed.duration ?? 0) || (parsed.duration ?? 0) < 0) {
    return emitCommandError(parsed, "invalid_duration", "`--duration` must be a non-negative number of seconds.");
  }
  let parsedUrl;
  if (url) {
    try {
      parsedUrl = new URL(url);
    } catch {
      return emitCommandError(parsed, "invalid_url", `Invalid recording URL: ${url}`);
    }
  }
  if (active && !parsedUrl && active.harId) return handleHostedSessionOneShot(parsed, active, viewport2);
  const oneshot = active ? void 0 : deps6.createOneshotSession("motion", parsed.artifactDir);
  const destination = active ? path37.join(active.dir, "motion", "recs") : oneshot.artifactsDir;
  const recId = `rec-${crypto12.randomBytes(2).toString("hex")}`;
  const recDir = path37.join(destination, recId);
  ensurePrivateDir(recDir);
  ensurePrivateDir(path37.join(recDir, "frames"));
  let client;
  let originalViewport;
  let viewportMayHaveApplied = false;
  let failure = null;
  let failureStatus = "oneshot_failed";
  try {
    const port = parsed.port ?? await deps6.detectCdpPort();
    const tab = parsedUrl ? await deps6.openTab(port, parsedUrl.toString()) : await deps6.findTabById(port, active.targetId);
    if (!tab) throw new Error(`Active session target ${active.targetId} is no longer available.`);
    if (!tab.webSocketDebuggerUrl) throw new Error("Recording target has no WebSocket debugger URL.");
    client = deps6.createClient(tab.webSocketDebuggerUrl);
    await client.waitReady();
    await client.send("Page.enable");
    if (viewport2) {
      originalViewport = await readActualViewport(client);
      viewportMayHaveApplied = true;
      await applyViewportOverride(client, viewport2);
    }
    await waitForPageReady(client);
    const recorder = deps6.createRecorderSession({ client, recDir });
    await recorder.start();
    await driveOneShotAction(recorder, parsed.do);
    if (parsed.duration) await sleep3(parsed.duration);
    const stopped = await recorder.stop();
    let viewportRestored = null;
    if (viewportMayHaveApplied) {
      viewportRestored = await restoreSessionViewportForClient(client, originalViewport);
      viewportMayHaveApplied = false;
    }
    const finalized = finalizeOneShotRecording(recDir, recId, parsedUrl?.toString() ?? tab.url, parsed.do, stopped, deps6.encodeVideo, viewportRestored);
    emitFinalizedResult(parsed, finalized);
  } catch (err) {
    failure = err instanceof Error ? err.message : String(err);
    if (err instanceof DoActionError) failureStatus = err.status;
  } finally {
    let restored = null;
    if (client && viewportMayHaveApplied) restored = await restoreSessionViewportForClient(client, originalViewport);
    client?.close();
    if (failure !== null) {
      emitCommandError(parsed, failureStatus, failure, restored === null ? void 0 : { "viewport-restored": restored });
    }
  }
}
async function handleHostedSessionOneShot(parsed, session, viewport2) {
  let started;
  try {
    started = await deps6.startComposedRecorder({ sessionDir: session.dir, viewport: viewport2 });
    const scanned = scanCollectorHost(session.dir);
    if (scanned.classification !== "live" || !scanned.handle) throw new Error(`collector host is ${scanned.classification} after recording start`);
    const host = scanned.handle;
    await driveOneShotAction({
      async handleCdp(request) {
        const response = await sendHostRequest(host.socketPath, {
          type: "cdp",
          nonce: host.nonce,
          method: request.method,
          params: request.params ?? {},
          ...request.mark ? { annotation: request.mark } : {}
        }, 3e4);
        if (!response.ok) throw new Error(response.error ?? `collector host rejected ${request.method}`);
        return response;
      }
    }, parsed.do);
    if (parsed.duration) await sleep3(parsed.duration);
    const stopped = await deps6.stopComposedRecorder({ sessionDir: session.dir, recId: started.recId });
    ensureFinalizedInventory(stopped.recDir);
    const video = deps6.encodeVideo(stopped.recDir, stopped.durationMs);
    const metaPath = path37.join(stopped.recDir, "meta.json");
    if (fs32.existsSync(metaPath)) {
      const meta = JSON.parse(fs32.readFileSync(metaPath, "utf8"));
      writeJsonPrivate(metaPath, { ...meta, video });
    }
    stopped.video = video;
    emitFinalizedResult(parsed, stopped);
  } catch (err) {
    const status = err instanceof DoActionError ? err.status : "oneshot_failed";
    const message = err instanceof Error ? err.message : String(err);
    const recovery = started ? `${message}. Recording ${started.recId} remains live at ${started.recDir}; finalize it with \`capture motion rec --stop\` (or inspect \`capture session collectors\`).` : message;
    emitCommandError(parsed, status, recovery);
  }
}
function recorderLiveClient(recorder) {
  return {
    async send(method, params) {
      return (await recorder.handleCdp({ method, params: params ?? {} })).result;
    },
    async sendMarked(method, params, mark) {
      return (await recorder.handleCdp({ method, params, mark })).result;
    }
  };
}
function resolutionError(failure) {
  if (failure.code === "unsupported-prefix") {
    return new DoActionError(
      `Unsupported --do target prefix in "${failure.input}": text: is query-leaf-only. Accepted prefixes: bare css selector (or exact accessible name when CSS finds none), ax:<name>, axid:<id>, backend:<id>.`,
      "unsupported_target_prefix"
    );
  }
  if (failure.code === "no-match") {
    return new DoActionError(`--do target matched no live element: ${failure.input}.`, "target_resolution_failed");
  }
  const candidates = failure.candidates.map((c) => `${c.role ?? "unknown"} "${c.name ?? ""}" backend:${c.backendNodeId}`).join("; ");
  return new DoActionError(
    `--do target is ambiguous: ${failure.input} matched ${failure.matchCount} live elements. Candidates: ${candidates}. Retry with backend:<id>.`,
    "target_resolution_failed"
  );
}
async function driveOneShotAction(recorder, action) {
  const parsedAction = parseDoAction(action);
  const live = recorderLiveClient(recorder);
  const resolved = await resolveLiveTarget(live, parsedAction.target);
  if (!resolved.ok) throw resolutionError(resolved);
  if (parsedAction.verb === "click") {
    try {
      await clickResolved(live, resolved, { mark: action });
    } catch (err) {
      if (err instanceof CaptureError && err.descriptor.code === "target_not_clickable") {
        throw new DoActionError(err.message, "target_not_clickable");
      }
      throw err;
    }
    return;
  }
  await scrollResolved(live, resolved, parsedAction.to, { mark: action });
}
function finalizeOneShotRecording(recDir, recId, url, action, stopped, encodeVideo = encodeVideoIfAvailable, viewportRestored = null) {
  ensureFinalizedInventory(recDir);
  writeJsonPrivate(path37.join(recDir, "markers.json"), stopped.markers);
  const video = encodeVideo(recDir, stopped.durationMs);
  const fps = stopped.durationMs > 0 ? Math.round(stopped.frameCount / (stopped.durationMs / 1e3) * 10) / 10 : 0;
  const state = stopped.frameCount > 0 ? "finalized" : "partial";
  const meta = {
    id: recId,
    action,
    frames: stopped.frameCount,
    durationMs: stopped.durationMs,
    state,
    ...state === "partial" ? { reason: "no_frames" } : {},
    url,
    fps,
    eventCount: stopped.eventCount,
    video,
    viewportRestored,
    viewportRetained: false
  };
  writeJsonPrivate(path37.join(recDir, "meta.json"), meta);
  return { recId, recDir, frames: stopped.frameCount, durationMs: stopped.durationMs, fps, state, eventCount: stopped.eventCount, viewportRestored, viewportRetained: false, action, video };
}
function ensureFinalizedInventory(recDir) {
  ensurePrivateDir(path37.join(recDir, "frames"));
  for (const filename of ["rects.jsonl", "events.jsonl"]) {
    const artifactPath2 = path37.join(recDir, filename);
    if (!fs32.existsSync(artifactPath2)) writeNdjsonPrivate(artifactPath2, []);
  }
}
function validateLifecycleInputs(parsed) {
  if (parsed.start && parsed.stop) return { status: "invalid_lifecycle", message: "`--start` and `--stop` cannot be used together." };
  if (!parsed.stop && parsed.recId) return { status: parsed.start ? "invalid_lifecycle" : "invalid_oneshot", message: "`--rec-id` is valid only with `--stop`." };
  if (parsed.start) {
    if (parsed.positional.length > 0) return { status: "invalid_lifecycle", message: "`--start` does not accept a positional URL." };
    if (parsed.do) return { status: "invalid_lifecycle", message: "`--start` cannot be combined with `--do`." };
    if (parsed.duration !== void 0) return { status: "invalid_lifecycle", message: "`--start` cannot be combined with `--duration`." };
  }
  if (parsed.stop) {
    if (parsed.positional.length > 0) return { status: "invalid_lifecycle", message: "`--stop` does not accept positional arguments." };
    if (parsed.do) return { status: "invalid_lifecycle", message: "`--stop` cannot be combined with `--do`." };
    if (parsed.duration !== void 0) return { status: "invalid_lifecycle", message: "`--stop` cannot be combined with `--duration`." };
    if (parsed.viewport) return { status: "invalid_lifecycle", message: "`--stop` cannot be combined with `--viewport`; viewport restoration uses the recording started by `--start`." };
  }
  return null;
}
async function applyViewportOverride(client, viewport2) {
  if (!viewport2) return false;
  await client.send("Emulation.setDeviceMetricsOverride", {
    width: viewport2.width,
    height: viewport2.height,
    deviceScaleFactor: 1,
    mobile: false
  });
  return true;
}
async function readActualViewport(client) {
  const response = await client.send("Runtime.evaluate", {
    expression: "(() => ({ width: window.innerWidth, height: window.innerHeight, deviceScaleFactor: window.devicePixelRatio }))()",
    returnByValue: true
  });
  const viewport2 = response.result?.value;
  if (!viewport2 || ![viewport2.width, viewport2.height, viewport2.deviceScaleFactor].every((value) => typeof value === "number" && Number.isFinite(value) && value > 0)) {
    throw new Error("Could not read the target\u2019s actual viewport before recording; refusing to apply an override that cannot be verified on restore.");
  }
  return viewport2;
}
async function restoreSessionViewportForClient(client, original) {
  try {
    await client.send("Emulation.setDeviceMetricsOverride", {
      width: original.width,
      height: original.height,
      deviceScaleFactor: original.deviceScaleFactor,
      mobile: false
    });
    const restored = await readActualViewport(client);
    return restored.width === original.width && restored.height === original.height && restored.deviceScaleFactor === original.deviceScaleFactor;
  } catch {
    return false;
  }
}
async function waitForPageReady(client, timeoutMs = 5e3) {
  const deadline = Date.now() + timeoutMs;
  let lastState = "unknown";
  while (Date.now() < deadline) {
    const response = await client.send("Runtime.evaluate", {
      expression: `(() => ({ readyState: document.readyState, href: location.href }))()`,
      returnByValue: true
    });
    if (!response.exceptionDetails) {
      const value = response.result?.value;
      const readyState = typeof value?.readyState === "string" ? value.readyState : "unknown";
      const href = typeof value?.href === "string" ? value.href : "";
      lastState = `${readyState} ${href}`.trim();
      if ((readyState === "interactive" || readyState === "complete") && href !== "about:blank") return;
    }
    await sleep3(50);
  }
  throw new Error(`Timed out waiting for page readiness before recording one-shot action (last state: ${lastState}).`);
}
function encodeTimeoutMs(frameCount) {
  const BASE_MS = 3e4;
  const PER_FRAME_MS = 60;
  const MAX_MS = 15 * 6e4;
  return Math.min(MAX_MS, BASE_MS + Math.max(0, frameCount) * PER_FRAME_MS);
}
function classifyEncodeFailure(result) {
  if (result.error && result.error.code === "ETIMEDOUT") return "ffmpeg_encoding_timed_out";
  if (result.error) return "ffmpeg_execution_failed";
  if (result.signal === "SIGTERM") return "ffmpeg_terminated";
  return "ffmpeg_encoding_failed";
}
function timestampedFrameManifest(recDir, frames2, manifestPath) {
  let rects;
  let markers;
  try {
    rects = readPrivateFile(path37.join(recDir, "rects.jsonl")).toString("utf8").trim().split("\n").filter(Boolean).map((line4) => JSON.parse(line4));
    markers = JSON.parse(readPrivateFile(path37.join(recDir, "markers.json")).toString("utf8"));
  } catch {
    return { status: "unavailable", reason: "frame_timestamps_unavailable" };
  }
  const timestamps = /* @__PURE__ */ new Map();
  for (const rect3 of rects) {
    if (!rect3 || typeof rect3 !== "object") continue;
    const { file, screencastTimestamp } = rect3;
    if (typeof file !== "string" || typeof screencastTimestamp !== "number" || !Number.isFinite(screencastTimestamp) || timestamps.has(file)) return { status: "unavailable", reason: "frame_timestamps_unavailable" };
    timestamps.set(file, screencastTimestamp * 1e3);
  }
  const frameTimes = frames2.map((frame) => timestamps.get(frame));
  if (frameTimes.some((timestamp) => timestamp === void 0)) return { status: "unavailable", reason: "frame_timestamps_unavailable" };
  if (frameTimes.some((timestamp, index) => index > 0 && timestamp <= frameTimes[index - 1])) return { status: "unavailable", reason: "frame_timestamps_unordered" };
  const stoppedAtWallClockMs = markers.stoppedAtWallClockMs;
  if (typeof stoppedAtWallClockMs !== "number" || !Number.isFinite(stoppedAtWallClockMs)) return { status: "unavailable", reason: "frame_timestamps_unavailable" };
  const finalDurationMs = stoppedAtWallClockMs - frameTimes[frameTimes.length - 1];
  if (!(finalDurationMs > 0)) return { status: "unavailable", reason: "frame_timestamps_unavailable" };
  const durationsMs = frameTimes.slice(1).map((timestamp, index) => timestamp - frameTimes[index]);
  durationsMs.push(finalDurationMs);
  const quote = (filename) => filename.replace(/'/g, "'\\''");
  const lines = ["ffconcat version 1.0"];
  for (let index = 0; index < frames2.length; index++) {
    lines.push(`file '${quote(path37.join(recDir, "frames", frames2[index]))}'`, "option framerate 1000", `duration ${(durationsMs[index] / 1e3).toFixed(9)}`);
  }
  lines.push(`file '${quote(path37.join(recDir, "frames", frames2[frames2.length - 1]))}'`, "option framerate 1000");
  writePrivateFile(manifestPath, lines.join("\n") + "\n");
  return void 0;
}
function encodeVideoIfAvailable(recDir, _durationMs) {
  const framesDir = path37.join(recDir, "frames");
  const frames2 = fs32.existsSync(framesDir) ? fs32.readdirSync(framesDir).filter((name) => name.endsWith(".png")).sort() : [];
  if (frames2.length === 0) return { status: "unavailable", reason: "no_frames" };
  const probe = (0, import_child_process3.spawnSync)("ffmpeg", ["-hide_banner", "-encoders"], { encoding: "utf8", timeout: 5e3 });
  if (probe.error || probe.status !== 0 || !String(probe.stdout ?? "").includes("libvpx-vp9")) return { status: "unavailable", reason: "ffmpeg_or_vp9_encoder_unavailable" };
  const tempDir = path37.join(recDir, `.video-encode-${crypto12.randomBytes(8).toString("hex")}`);
  ensurePrivateDir(tempDir);
  const tempOutput = path37.join(tempDir, "video.webm");
  try {
    const manifestOutcome = timestampedFrameManifest(recDir, frames2, path37.join(tempDir, "frames.ffconcat"));
    if (manifestOutcome) return manifestOutcome;
    const result = (0, import_child_process3.spawnSync)("ffmpeg", [
      "-y",
      "-f",
      "concat",
      "-safe",
      "0",
      "-i",
      path37.join(tempDir, "frames.ffconcat"),
      "-fps_mode",
      "vfr",
      "-c:v",
      "libvpx-vp9",
      "-pix_fmt",
      "yuv420p",
      tempOutput
    ], { stdio: "ignore", timeout: encodeTimeoutMs(frames2.length) });
    if (result.error || result.status !== 0 || !fs32.existsSync(tempOutput)) {
      return { status: "failed", reason: classifyEncodeFailure(result) };
    }
    try {
      writeBinaryPrivate(path37.join(recDir, "video.webm"), fs32.readFileSync(tempOutput));
      return { status: "encoded" };
    } catch {
      return { status: "failed", reason: "video_install_failed" };
    }
  } finally {
    fs32.rmSync(tempDir, { recursive: true, force: true });
  }
}
function sleep3(ms) {
  return new Promise((resolve12) => setTimeout(resolve12, ms));
}
async function handleStart(parsed, viewport2) {
  const session = deps6.getActiveSession();
  if (!session) return emitCommandError(parsed, "no_active_session", "No active capture session. Start one first: `capture session start --url <url>`.");
  if (!session.targetId) return emitCommandError(parsed, "no_session_target", "Active capture session has no target tab to record.");
  let started;
  try {
    started = await deps6.startComposedRecorder({ sessionDir: session.dir, viewport: viewport2 });
  } catch (err) {
    const viewportRestored = err instanceof StartRecorderError ? err.viewportRestored : null;
    return emitCommandError(
      parsed,
      "start_failed",
      err instanceof Error ? err.message : String(err),
      viewportRestored === null ? void 0 : { "viewport-restored": viewportRestored }
    );
  }
  const staleViewport = started.reapedStale?.viewportRestored;
  const result = {
    tag: "recording",
    attestation: { kind: "recording", id: started.recId, path: started.recDir },
    attrs: {
      state: "recording",
      ...staleViewport !== null && staleViewport !== void 0 ? { "stale-viewport-restored": staleViewport } : {},
      "timestamp-uncertainty": "\xB11 frame for frame-derived timestamps"
    },
    summary: fact`Recorder armed on the session tab (screencast + tracing + observers).`,
    sections: started.reapedStale ? [fact`A stale recording (${started.reapedStale.recId}, dead process) was reaped before this one armed.`] : void 0
  };
  emitResult(result, { json: parsed.json });
}
async function handleStop(parsed) {
  const session = deps6.getActiveSession();
  if (!session) return emitCommandError(parsed, "no_active_session", "No active capture session. Start one first: `capture session start --url <url>`.");
  if (!session.targetId) return emitCommandError(parsed, "no_session_target", "Active capture session has no target tab to restore.");
  let stopped;
  try {
    stopped = await deps6.stopComposedRecorder({ sessionDir: session.dir, recId: parsed.recId });
    ensureFinalizedInventory(stopped.recDir);
    const video = deps6.encodeVideo(stopped.recDir, stopped.durationMs);
    const metaPath = path37.join(stopped.recDir, "meta.json");
    if (fs32.existsSync(metaPath)) {
      const meta = JSON.parse(fs32.readFileSync(metaPath, "utf8"));
      writeJsonPrivate(metaPath, { ...meta, video });
    }
    stopped.video = video;
  } catch (err) {
    return emitCommandError(parsed, "stop_failed", err instanceof Error ? err.message : String(err));
  }
  emitFinalizedResult(parsed, stopped);
}
function recordingLossCounts(recDir) {
  let raw;
  try {
    raw = readPrivateFile(path37.join(recDir, "events.jsonl")).toString("utf8");
  } catch (error4) {
    return { unavailableReason: `events.jsonl could not be read (${error4 instanceof Error ? error4.message : String(error4)})` };
  }
  let rectSampleElementsDropped = 0;
  let bindingRecordsDropped = 0;
  let rectSampleFramesTruncated = 0;
  let rectSampleFramesCandidateTruncated = 0;
  for (const line4 of raw.split("\n").filter(Boolean)) {
    let event;
    try {
      event = JSON.parse(line4);
    } catch {
      return { unavailableReason: "events.jsonl contains a malformed event record" };
    }
    if (!event || typeof event !== "object") continue;
    const { kind, count: count3 } = event;
    if (kind !== "rect-sample-dropped" && kind !== "binding-dropped") continue;
    if (!Number.isSafeInteger(count3) || count3 < 0) return { unavailableReason: `${String(kind)} has no non-negative integer count` };
    if (kind === "rect-sample-dropped") {
      if (!Number.isSafeInteger(rectSampleElementsDropped + count3)) return { unavailableReason: "rect-sample-dropped count exceeds the safe integer range" };
      rectSampleElementsDropped += count3;
    } else {
      if (!Number.isSafeInteger(bindingRecordsDropped + count3)) return { unavailableReason: "binding-dropped count exceeds the safe integer range" };
      bindingRecordsDropped += count3;
    }
  }
  let rectsRaw;
  try {
    rectsRaw = readPrivateFile(path37.join(recDir, "rects.jsonl")).toString("utf8");
  } catch (error4) {
    return { unavailableReason: `rects.jsonl could not be read (${error4 instanceof Error ? error4.message : String(error4)})` };
  }
  for (const line4 of rectsRaw.split("\n").filter(Boolean)) {
    let rect3;
    try {
      rect3 = JSON.parse(line4);
    } catch {
      return { unavailableReason: "rects.jsonl contains a malformed rect record" };
    }
    if (!rect3 || typeof rect3 !== "object") continue;
    if (rect3.elementSampleTruncated === true) {
      if (!Number.isSafeInteger(rectSampleFramesTruncated + 1)) return { unavailableReason: "rect-sample truncation count exceeds the safe integer range" };
      rectSampleFramesTruncated++;
    }
    if (rect3.candidateSampleTruncated === true) {
      if (!Number.isSafeInteger(rectSampleFramesCandidateTruncated + 1)) return { unavailableReason: "rect-sample candidate truncation count exceeds the safe integer range" };
      rectSampleFramesCandidateTruncated++;
    }
  }
  return { rectSampleElementsDropped, bindingRecordsDropped, rectSampleFramesTruncated, rectSampleFramesCandidateTruncated };
}
function emitFinalizedResult(parsed, stopped) {
  const durationS = `${(stopped.durationMs / 1e3).toFixed(1)}s`;
  const lossCounts = recordingLossCounts(stopped.recDir);
  const lossAttrs = "unavailableReason" in lossCounts ? { "rect-sample-elements-dropped": "unavailable", "binding-records-dropped": "unavailable", "rect-sample-frames-truncated": "unavailable", "rect-sample-frames-candidate-truncated": "unavailable" } : {
    "rect-sample-elements-dropped": lossCounts.rectSampleElementsDropped,
    "binding-records-dropped": lossCounts.bindingRecordsDropped,
    "rect-sample-frames-truncated": lossCounts.rectSampleFramesTruncated,
    "rect-sample-frames-candidate-truncated": lossCounts.rectSampleFramesCandidateTruncated
  };
  const lossFacts = "unavailableReason" in lossCounts ? [fact`Dropped rect-sample element and binding-record counts and rect-sample truncation state are unavailable: ${lossCounts.unavailableReason}.`] : [
    fact`Retained rect samples contain only the frame and element facts the recorder retained; ${lossCounts.rectSampleElementsDropped} rect-sample element fact(s) and ${lossCounts.bindingRecordsDropped} binding record(s) were dropped.`,
    ...lossCounts.rectSampleFramesTruncated > 0 ? [fact`${lossCounts.rectSampleFramesTruncated} rect sample frame(s) stopped after 4000 non-zero-size elements; remaining DOM candidates were not sampled because of the element cap.`] : [],
    ...lossCounts.rectSampleFramesCandidateTruncated > 0 ? [fact`${lossCounts.rectSampleFramesCandidateTruncated} rect sample frame(s) sampled rect geometry from 8000 DOM element candidates; remaining DOM candidates were not sampled because of the geometry-read cap.`] : []
  ];
  const result = {
    tag: "recording",
    attestation: { kind: "recording", id: stopped.recId, path: stopped.recDir },
    attrs: {
      frames: stopped.frames,
      fps: stopped.fps,
      duration: durationS,
      state: stopped.state,
      "event-records": stopped.eventCount ?? "unavailable",
      ...lossAttrs,
      "baseline-availability": baselineAvailability(stopped.recDir),
      ...stopped.action ? { action: stopped.action } : {},
      ...stopped.viewportRestored !== null ? { "viewport-restored": stopped.viewportRestored } : {},
      ...stopped.viewportRetained ? { "viewport-retained": true } : {},
      ..."video" in stopped ? { video: stopped.video?.status ?? "unavailable" } : {},
      "timestamp-uncertainty": "\xB11 frame for frame-derived timestamps"
    },
    summary: stopped.state === "partial" ? fact`Recording is partial: no screencast frames were captured over ${durationS}; retained event and recorder artifacts are available.` : stopped.state === "orphaned-finalized" ? fact`Recorder process was no longer running; finalized best-effort from artifacts already flushed to disk.` : stopped.eventCount !== null ? fact`Recording finalized: ${stopped.frames} frame(s) over ${durationS}, ${stopped.eventCount} event record(s).` : fact`Recording finalized: ${stopped.frames} frame(s) over ${durationS}.`,
    sections: lossFacts,
    artifacts: formatArtifactList(listRecordingArtifacts(stopped.recDir))
  };
  emitResult(result, { json: parsed.json });
}
function baselineAvailability(recDir) {
  try {
    const markers = JSON.parse(fs32.readFileSync(path37.join(recDir, "markers.json"), "utf8"));
    return markers.baselinesPending ? "pending" : typeof markers.performanceNowMs === "number" ? "available" : "unavailable";
  } catch {
    return "unavailable";
  }
}
function emitCommandError(parsed, status, message, attrs = {}) {
  emitResult({ tag: "error", attrs: { command: "motion rec", status, ...attrs }, summary: fact`${message}` }, { json: parsed.json });
  process.exitCode = 1;
}
function listRecordingArtifacts(recDir) {
  let entries;
  try {
    entries = fs32.readdirSync(recDir);
  } catch {
    return [];
  }
  const names = [];
  for (const entry of entries) {
    const full2 = path37.join(recDir, entry);
    if (fs32.statSync(full2).isDirectory()) {
      if (fs32.readdirSync(full2).length > 0) names.push(`${entry}/`);
    } else {
      names.push(entry);
    }
  }
  return names.sort().map((name) => ({ name }));
}
