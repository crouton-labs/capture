            output.push(charCode >> 6 & 63 | 128);
            output.push(charCode & 63 | 128);
          } else if (charCode < 131072) {
            output.push(charCode >> 18 | 240);
            output.push(charCode >> 12 & 63 | 128);
            output.push(charCode >> 6 & 63 | 128);
            output.push(charCode & 63 | 128);
          } else {
