function profilePath(token2) {
  return path2.join(CAPTURE_ROOT, "browsers", "profiles", token2);
}
function parseOwnedBrowser(value) {
  if (!value || typeof value !== "object" || Array.isArray(value)) return void 0;
  const record5 = value;
  const birth = parseBirth(record5.birth);
  const valid = birth !== void 0 && exactKeys(record5, ["version", "token", "port", "pid", "birth", "profileDir", "executablePath", "source", "headless", "startedAt", "lastUsedAt"]) && record5.version === 1 && typeof record5.token === "string" && RECORD_TOKEN.test(record5.token) && (record5.port === null || Number.isSafeInteger(record5.port) && record5.port >= 1 && record5.port <= 65535) && Number.isSafeInteger(record5.pid) && record5.pid > 0 && typeof record5.profileDir === "string" && record5.profileDir === profilePath(record5.token) && typeof record5.executablePath === "string" && path2.isAbsolute(record5.executablePath) && typeof record5.source === "string" && SOURCES.includes(record5.source) && typeof record5.headless === "boolean" && typeof record5.startedAt === "string" && ISO.test(record5.startedAt) && typeof record5.lastUsedAt === "string" && ISO.test(record5.lastUsedAt);
  if (!valid || birth === void 0) return void 0;
  return {
    version: 1,
    token: record5.token,
    port: record5.port,
    pid: record5.pid,
    birth,
    profileDir: record5.profileDir,
    executablePath: record5.executablePath,
    source: record5.source,
    headless: record5.headless,
    startedAt: record5.startedAt,
    lastUsedAt: record5.lastUsedAt
  };
}
function readOwnedBrowsers() {
  let entries;
  try {
    entries = fs2.readdirSync(browsersDir());
  } catch {
    return [];
  }
  const records = [];
  for (const entry of entries) {
    if (!entry.endsWith(".json") || !RECORD_TOKEN.test(entry.slice(0, -".json".length))) continue;
    const file = path2.join(browsersDir(), entry);
    let parsed;
    try {
      parsed = parseOwnedBrowser(JSON.parse(readPrivateFile(file).toString("utf-8")));
    } catch {
      parsed = void 0;
    }
    if (parsed) records.push(parsed);
    else forgetRecordFile(file);
  }
  return records.sort((a, b) => (a.port ?? 0) - (b.port ?? 0));
}
function forgetRecordFile(file) {
  try {
    unlinkPrivateFile(file);
  } catch {
  }
}
function stillOurs(record5) {
  const observed = processPidBirthProvider.read(record5.pid);
  return observed.status === "found" && sameBirth(observed.identity, record5.birth);
}
function removeProfile(profileDir) {
  fs2.rmSync(assertUnderCaptureRoot(profileDir), { recursive: true, force: true });
}
function sleep(ms) {
  return new Promise((resolve12) => setTimeout(resolve12, ms));
}
async function reap(record5) {
  for (const [signal, graceMs] of [["SIGTERM", TERM_GRACE_MS], ["SIGKILL", KILL_GRACE_MS]]) {
    if (!stillOurs(record5)) break;
    try {
      process.kill(record5.pid, signal);
    } catch {
      break;
    }
    const deadline = Date.now() + graceMs;
    while (Date.now() < deadline && stillOurs(record5)) await sleep(READY_POLL_MS);
  }
  forgetRecordFile(recordPath(record5.token));
  removeProfile(record5.profileDir);
}
async function endpointAnswers(port) {
  try {
    const response = await fetch(`http://${CDP_LOOPBACK_HOST}:${port}/json/version`, {
      signal: AbortSignal.timeout(ENDPOINT_PROBE_MS)
    });
    return response.ok;
  } catch {
    return false;
  }
}
async function sweepOwnedBrowsers() {
  const reaped = [];
  for (const record5 of readOwnedBrowsers()) {
    if (!stillOurs(record5)) {
      forgetRecordFile(recordPath(record5.token));
      removeProfile(record5.profileDir);
      reaped.push({ port: record5.port, pid: record5.pid, reason: "exited" });
      continue;
    }
    if (record5.port === null || !await endpointAnswers(record5.port)) {
      await reap(record5);
      reaped.push({ port: record5.port, pid: record5.pid, reason: "unreachable" });
      continue;
    }
    if (Date.now() - Date.parse(record5.lastUsedAt) > IDLE_REAP_MS) {
      await reap(record5);
      reaped.push({ port: record5.port, pid: record5.pid, reason: "idle" });
    }
  }
  return reaped;
}
function touchOwnedBrowser(port) {
  const record5 = readOwnedBrowsers().find((candidate) => candidate.port === port);
  if (!record5) return;
  writeJsonPrivate(recordPath(record5.token), { ...record5, lastUsedAt: (/* @__PURE__ */ new Date()).toISOString() });
}
function ownedBrowsersByPort() {
  const byPort = /* @__PURE__ */ new Map();
  for (const record5 of readOwnedBrowsers()) if (record5.port !== null) byPort.set(record5.port, record5);
  return byPort;
}
async function quitOwnedBrowsers(selector) {
  const records = readOwnedBrowsers().filter((record5) => selector.all || record5.port === selector.port);
  const stopped = [];
  for (const record5 of records) {
    await reap(record5);
    stopped.push({ port: record5.port, pid: record5.pid, reason: "requested" });
  }
  return stopped;
}
function executable(file) {
  try {
    fs2.accessSync(file, fs2.constants.X_OK);
    return fs2.statSync(file).isFile();
  } catch {
    return false;
  }
}
function puppeteerVersionDirs(product) {
  const root = path2.join(os2.homedir(), ".cache", "puppeteer", product);
  try {
    return fs2.readdirSync(root).sort().reverse().map((entry) => path2.join(root, entry));
  } catch {
    return [];
  }
}
function browserCandidates() {
  const configured = process.env.CAPTURE_BROWSER;
  const candidates = configured ? [{ path: path2.resolve(configured), source: "CAPTURE_BROWSER", headlessOnly: false }] : [];
  const relative2 = PUPPETEER_RELATIVE[`${process.platform}-${process.arch}`];
  if (relative2) {
    for (const dir of puppeteerVersionDirs("chrome-headless-shell")) {
      candidates.push({ path: path2.join(dir, relative2.shell), source: "puppeteer-cache", headlessOnly: true });
    }
    for (const dir of puppeteerVersionDirs("chrome")) {
      candidates.push({ path: path2.join(dir, relative2.chrome), source: "puppeteer-cache", headlessOnly: false });
    }
  }
  for (const file of SYSTEM_PATHS[process.platform] ?? []) {
    candidates.push({ path: file, source: "system", headlessOnly: false });
  }
  return candidates;
}
function resolveBrowserExecutable(headless) {
  const candidates = browserCandidates().filter((candidate) => headless || !candidate.headlessOnly);
  const found = candidates.find((candidate) => executable(candidate.path));
  if (found) return { path: found.path, source: found.source };
  throw captureError(
    "world",
    "no_browser_executable",
    `received: no usable ${headless ? "browser" : "headed browser"} executable; expected: Chrome/Chromium at one of ${candidates.map((candidate) => candidate.path).join(", ") || "(no known location for this platform)"}. Set CAPTURE_BROWSER=<absolute path> to name one explicitly, or install Chrome for Testing (npx @puppeteer/browsers install chrome-headless-shell@stable).`
  );
}
function devToolsPort(profileDir) {
  try {
    const first = fs2.readFileSync(path2.join(profileDir, "DevToolsActivePort"), "utf-8").split("\n")[0]?.trim();
    if (!first || !/^[1-9]\d*$/.test(first)) return null;
    const port = Number(first);
    return port >= 1 && port <= 65535 ? port : null;
  } catch {
    return null;
  }
}
function assertPortUnbound(port) {
  try {
    const output = (0, import_node_child_process2.execFileSync)("lsof", ["-nP", `-iTCP:${port}`, "-sTCP:LISTEN", "-F", "n"], { encoding: "utf-8", stdio: ["ignore", "pipe", "pipe"] });
    if (output.trim()) {
      throw captureError("precondition", "browser_port_in_use", `received: port ${port}; expected: no TCP listener on that port. Capture refuses to launch because the endpoint would be ambiguous across loopback address families.`);
    }
  } catch (error4) {
    if (error4.status === 1) return;
    if (error4 instanceof CaptureError && error4.descriptor.code === "browser_port_in_use") throw error4;
    throw captureError("world", "browser_port_check_failed", `received: port ${port}; checking TCP listeners with lsof failed, so Capture cannot prove the port is unbound: ${error4 instanceof Error ? error4.message : String(error4)}`, error4);
  }
}
async function launchOwnedBrowser(options) {
  if (options.port !== void 0) assertPortUnbound(options.port);
  const executablePath = resolveBrowserExecutable(options.headless);
  const token2 = crypto2.randomBytes(8).toString("hex");
  const profileDir = ensurePrivateDir(profilePath(token2));
  const args = [
    `--remote-debugging-port=${options.port ?? 0}`,
    `--remote-debugging-address=${CDP_LOOPBACK_HOST}`,
    `--user-data-dir=${profileDir}`,
    "--no-first-run",
    "--no-default-browser-check",
    "--disable-gpu",
    ...options.headless ? ["--headless=new"] : [],
    options.url ?? "about:blank"
  ];
  const child = (0, import_node_child_process2.spawn)(executablePath.path, args, { detached: true, stdio: "ignore" });
  child.unref();
  const pid = child.pid;
  if (pid === void 0) {
    removeProfile(profileDir);
    throw captureError("world", "browser_spawn_failed", `received: ${executablePath.path}; spawning it produced no pid.`);
  }
  const observed = processPidBirthProvider.read(pid);
  if (observed.status !== "found") {
    try {
      process.kill(pid, "SIGKILL");
    } catch {
    }
    removeProfile(profileDir);
    throw captureError(
      "world",
      "browser_identity_unavailable",
      `received: browser pid ${pid}; expected: a readable process-birth identity to own it by (${observed.status === "unknown" ? observed.reason : "the process was already gone"}).`
    );
  }
  const now = (/* @__PURE__ */ new Date()).toISOString();
  const record5 = {
    version: 1,
    token: token2,
    port: null,
    pid,
    birth: observed.identity,
    profileDir,
    executablePath: executablePath.path,
    source: executablePath.source,
    headless: options.headless,
    startedAt: now,
    lastUsedAt: now
  };
  writeJsonPrivate(recordPath(token2), record5);
  const deadline = Date.now() + READY_TIMEOUT_MS;
  for (; ; ) {
    const port = options.port ?? devToolsPort(profileDir);
    if (port !== null && await endpointAnswers(port)) {
      const ready = { ...record5, port, lastUsedAt: (/* @__PURE__ */ new Date()).toISOString() };
      writeJsonPrivate(recordPath(token2), ready);
      return ready;
    }
    if (Date.now() > deadline) {
      await reap(record5);
      throw captureError(
        "world",
        "browser_launch_timeout",
        `received: ${executablePath.path} (pid ${pid}); it did not answer CDP on ${options.port === void 0 ? "a kernel-chosen port" : `port ${options.port}`} within ${READY_TIMEOUT_MS}ms. The browser was stopped and its profile removed.`
      );
    }
    await sleep(READY_POLL_MS);
  }
}
