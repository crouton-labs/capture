function bridgeSocketPath(sessionDir2) {
  return path7.join(sessionDir2, "bridge.sock");
}
function collectorSocketDir() {
  const dir = "/tmp/capture-sockets";
  try {
    fs5.mkdirSync(dir, { mode: 448 });
  } catch (error4) {
    if (error4.code !== "EEXIST") throw error4;
  }
  const stat = fs5.lstatSync(dir);
  if (!stat.isDirectory() || stat.isSymbolicLink()) throw new Error(`collector socket directory is not a real directory: ${dir}`);
  if (typeof process.getuid === "function" && stat.uid !== process.getuid()) throw new Error(`collector socket directory is not owned by this user: ${dir}`);
  fs5.chmodSync(dir, 448);
  return dir;
}
function shortSocketName(scopeDir) {
  return crypto5.createHash("sha1").update(path7.resolve(scopeDir)).digest("hex").slice(0, 16);
}
function collectorHostSocketPath(sessionDir2) {
  return path7.join(collectorSocketDir(), `host-${shortSocketName(sessionDir2)}.sock`);
}
async function startBridge(sessionDir2, port, timeoutMs = 5e3) {
  const socketPath = bridgeSocketPath(sessionDir2);
  const scriptPath = process.argv[1];
  const child = (0, import_child_process2.spawn)(
    process.execPath,
    [scriptPath, "__bridge-serve", "--socket", socketPath, "--port", String(port)],
    { detached: true, stdio: "ignore" }
  );
  child.unref();
  const pid = child.pid;
  if (!pid) {
    throw new Error("Failed to spawn CDP bridge process.");
  }
  const start2 = Date.now();
  while (!fs5.existsSync(socketPath)) {
    if (Date.now() - start2 > timeoutMs) {
      stopBridge(pid, socketPath);
      throw new Error(
        `CDP bridge (pid ${pid}) did not come up within ${timeoutMs}ms. Check that a browser is reachable on port ${port} (capture tab list --port ${port}).`
      );
    }
    await new Promise((r) => setTimeout(r, 50));
  }
  return { socketPath, pid };
}
async function startCollectorHost(socketPath, port, targetId, sessionDir2, timeoutMs = 5e3) {
  const child = (0, import_child_process2.spawn)(process.execPath, [process.argv[1], "__bridge-serve", "--socket", socketPath, "--port", String(port), "--target", targetId, "host", sessionDir2], { detached: true, stdio: "ignore" });
  child.unref();
  if (!child.pid) throw new Error("Failed to spawn collector host process.");
  const started = Date.now();
  while (!fs5.existsSync(socketPath)) {
    if (Date.now() - started > timeoutMs) {
      stopBridge(child.pid, socketPath);
      throw new Error(`Collector host (pid ${child.pid}) did not come up within ${timeoutMs}ms.`);
    }
    await new Promise((resolve12) => setTimeout(resolve12, 50));
  }
  return { socketPath, pid: child.pid };
}
function stopBridge(pid, socketPath) {
  if (pid) {
    try {
      process.kill(pid, "SIGTERM");
    } catch {
    }
  }
  if (socketPath) {
    try {
      if (fs5.lstatSync(socketPath).isSocket()) fs5.unlinkSync(socketPath);
    } catch {
    }
  }
}
