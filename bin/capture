function count(values) {
  const counts = /* @__PURE__ */ new Map();
  for (const value of values) {
    if (value) counts.set(value, (counts.get(value) ?? 0) + 1);
  }
  return [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
}
function distribution(label2, values) {
  const entries = count(values);
  const body2 = entries.length ? entries.map(([value, n]) => `${value} \xD7${n}`).join(" \xB7 ") : "(none recorded)";
  return fact`${label2}: ${body2}`;
}
function hexRgb(value) {
  const hex = /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(value.trim());
  if (hex) {
    const s = hex[1].length === 3 ? hex[1].split("").map((c) => c + c).join("") : hex[1];
    return [Number.parseInt(s.slice(0, 2), 16), Number.parseInt(s.slice(2, 4), 16), Number.parseInt(s.slice(4, 6), 16)];
  }
  const rgb = /^rgba?\((\d+),\s*(\d+),\s*(\d+)/i.exec(value.trim());
  return rgb ? [Number(rgb[1]), Number(rgb[2]), Number(rgb[3])] : void 0;
}
function colorDistance(a, b) {
  const aa = hexRgb(a);
  const bb = hexRgb(b);
  if (!aa || !bb) return void 0;
  return Math.sqrt((aa[0] - bb[0]) ** 2 + (aa[1] - bb[1]) ** 2 + (aa[2] - bb[2]) ** 2) / 255 * 100;
}
function caveated(lines, snap) {
  return annotateUnstableFacts(lines, unstableRegionsFor(snap)).map(
    ({ fact: item, caveats }) => caveats.length ? line(item.line, fact` — nondeterminism caveat: unstable region ${caveats.map((c) => c.regionId).join(", ")}`) : item.line
  );
}
function rectOf3(rect3) {
  if (!rect3) return void 0;
  const w = rect3.w ?? rect3.width;
  const h = rect3.h ?? rect3.height;
  return typeof w === "number" && typeof h === "number" ? { x: rect3.x, y: rect3.y, w, h } : void 0;
}
function provenanceLines2(styles) {
  const sources = [];
  for (const element of styles.elements) for (const declaration of element.winningDeclarations ?? []) {
    const authored = declaration.authored;
    const generated = declaration.generated;
    const source = authored?.file ? `${authored.file}:${authored.line ?? 0}:${authored.column ?? 0}` : generated?.sourceURL ? `${generated.sourceURL}:${generated.line ?? 0}:${generated.column ?? 0}` : declaration.sourceStyleSheetUrl ?? declaration.selector;
    if (typeof source === "string") sources.push(source);
  }
  return sources.length ? [distribution("Winning declaration provenance", sources)] : [];
}
function nearDuplicateLines(colors) {
  const distinct = [...new Set(colors)];
  const near = [];
  for (let i = 0; i < distinct.length; i++) for (let j = i + 1; j < distinct.length; j++) {
    const delta2 = colorDistance(distinct[i], distinct[j]);
    if (delta2 !== void 0 && delta2 < 1) near.push(fact`Near-duplicate: ${distinct[i]} and ${distinct[j]} (ΔE-like RGB distance ${delta2.toFixed(2)})`);
  }
  return near;
}
function geometryIdentity(element, geometry) {
  const match = geometry.elements.find((candidate) => candidate.selector && candidate.selector === element.selector);
  return match ? { elementId: match.id, rect: rectOf3(match.rect) } : { elementId: element.id };
}
function colorLines(snap, styles, geometry) {
  const facts = [];
  const colors = [];
  for (const e of styles.elements) for (const prop of ["color", "background-color"]) {
    const value = e.computed?.[prop];
    if (value) {
      colors.push(value);
      facts.push({ ...geometryIdentity(e, geometry), line: fact`${prop} ${value}` });
    }
  }
  return [distribution("Color values", colors), ...nearDuplicateLines(colors), ...caveated(facts.slice(0, 20), snap), ...provenanceLines2(styles)];
}
function styleValueLines(snap, styles, geometry, axis) {
  const props = axis === "font" ? ["font-family", "font-size", "font-weight", "line-height"] : axis === "spacing" ? ["margin-top", "margin-right", "margin-bottom", "margin-left", "padding-top", "padding-right", "padding-bottom", "padding-left"] : axis === "radius" ? ["border-radius"] : ["box-shadow", "text-shadow"];
  const values = [];
  const facts = [];
  for (const e of styles.elements) for (const prop of props) {
    const value = e.computed?.[prop];
    if (value) {
      values.push(`${prop}: ${value}`);
      facts.push({ ...geometryIdentity(e, geometry), line: fact`${prop}: ${value}` });
    }
  }
  return [distribution(`${axis} values`, values), ...caveated(facts.slice(0, 20), snap), ...provenanceLines2(styles)];
}
function geometryLines(snap, geometry, textReport) {
  const edges = geometry.elements.flatMap((e) => e.rect ? [String(e.rect.x), String(e.rect.y)] : []);
  const sorted2 = geometry.elements.map((e) => ({ e, r: rectOf3(e.rect) })).filter((x) => !!x.r).sort((a, b) => a.r.y - b.r.y);
  const gaps = [];
  for (let i = 1; i < sorted2.length; i++) {
    const gap = sorted2[i].r.y - (sorted2[i - 1].r.y + sorted2[i - 1].r.h);
    if (gap >= 0) gaps.push(`${Math.round(gap)}px`);
  }
  const baselines = textReport.elements.flatMap((e) => e.lines?.map((l) => l.baseline).filter((v) => typeof v === "number") ?? []).map((v) => `${Math.round(v)}px`);
  const grid = geometry.elements.filter((e) => !!e.layout?.grid).length;
  const area2 = sorted2.reduce((total, { r }) => total + r.w * r.h, 0);
  const repeated = count(geometry.elements.map((e) => e.selector ?? e.id).filter(Boolean)).filter(([, n]) => n > 1);
  const repeatedLine = repeated.length ? fact`Repeated-component selector counts: ${repeated.map(([selector, n]) => `${selector} \xD7${n}`).join(" \xB7 ")}.` : text`Repeated-component selector counts: no repeated recorded selectors.`;
  const lines = [distribution("Edge clusters", edges), distribution("Vertical gap distribution", gaps), distribution("Baseline clusters", baselines), fact`Grid occupancy: ${grid} grid-item record(s); summed element box area: ${Math.round(area2)}px² (overlapping boxes are counted independently).`, repeatedLine, text`Whitespace/ink: raster coverage is not recorded unless this snapshot includes pixel substrate; geometry reports box-area coverage only.`];
  return [...lines, ...caveated(sorted2.slice(0, 20).map(({ e, r }) => ({ elementId: e.id, rect: r, line: fact`Geometry record ${e.selector ?? e.id}: x=${r.x} y=${r.y} w=${r.w} h=${r.h}` })), snap)];
}
function animationLines(snap, report) {
  const values = report.animations.map((a) => `${a.animationName ?? "(unnamed)"} ${a.durationMs ?? "unknown"}ms ${a.iterationCount ?? "unknown"} iterations ${a.playState ?? "unknown"}`);
  return [fact`Animations: ${report.animations.length}; infinite: ${report.animations.filter((a) => a.infinite).length}.`, distribution("Animation distribution", values), ...caveated(report.animations.map((a) => ({ elementId: a.id, line: fact`${a.selector ?? a.id}: ${a.animationName ?? "(unnamed)"}` })), snap)];
}
function mediaLines(snap) {
  const media = readMedia(snap);
  const values = media.elements.map((m) => `${m.tag ?? "media"} ${m.naturalWidth ?? "?"}\xD7${m.naturalHeight ?? "?"} \u2192 ${m.renderedWidth ?? "?"}\xD7${m.renderedHeight ?? "?"}`);
  return [fact`Replaced-element records: ${media.elements.length}.`, distribution("Media dimensions", values), ...caveated(media.elements.map((m) => ({ elementId: m.id, rect: rectOf3(m.rect), line: fact`${m.selector ?? m.id}: ${m.currentSrc ?? "(no current source)"}` })), snap)];
}
function queryLines(report) {
  const media = report.mediaQueries ?? [];
  const containers = report.containerQueries ?? [];
  return [fact`Environment: ${JSON.stringify(report.environment ?? {})}`, fact`Active media-query records: ${media.length}; container-query records: ${containers.length}.`, distribution("Media query conditions", media.map((q) => String(q.query ?? q.error ?? "unknown"))), distribution("Container query conditions", containers.map((q) => String(q.query ?? "unknown")))];
}
function roleLines(snap) {
  const ax = readAx(snap);
  const nodes = ax.nodes ?? ax.axNodes ?? [];
  const roles = nodes.filter((node) => !node.ignored).map((node) => typeof node.role === "string" ? node.role : node.role?.value ?? "unknown");
  return [distribution("Accessibility role instances", roles)];
}
function buildCensus(axis, snapshots) {
  const lines = [];
  if (axis === "color") {
    const values = snapshots.flatMap((snap) => readStyles(snap).elements.flatMap((e) => ["color", "background-color"].map((prop) => e.computed?.[prop]).filter((v) => !!v)));
    lines.push(distribution("Color values across snapshots", values), ...nearDuplicateLines(values));
  }
  for (const snap of snapshots) {
    const geometry = readGeometry(snap);
    const styles = readStyles(snap);
    const textReport = readText(snap);
    const meta = readMeta(snap);
    lines.push(fact`Snapshot ${snap.id}: ${geometry.elements.length} geometry records; settled=${meta.settled === true ? "true" : "false"}.`);
    if (axis === "color") lines.push(...colorLines(snap, styles, geometry));
    else if (axis === "font" || axis === "spacing" || axis === "radius" || axis === "shadow") lines.push(...styleValueLines(snap, styles, geometry, axis));
    else if (axis === "geometry") lines.push(...geometryLines(snap, geometry, textReport), ...roleLines(snap));
    else if (axis === "animation") lines.push(...animationLines(snap, readAnimation(snap)));
    else if (axis === "queries") lines.push(...queryLines(readQueries(snap)));
    else if (axis === "media") lines.push(...mediaLines(snap));
  }
  const distinct = new Set(lines.map((l) => JSON.stringify(l))).size;
  return { axis, snapshots, distinct, lines };
}
function censusResultLines(report) {
  return lineList(report.lines.length ? report.lines : [text`No census facts were recorded.`]);
}
