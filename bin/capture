        function isStartOfParameter(isJSDocParameter) {
          return token2() === 26 || isBindingIdentifierOrPrivateIdentifierOrPattern() || isModifierKind(token2()) || token2() === 60 || isStartOfType(
            /*inStartOfParameter*/
