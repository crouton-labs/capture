function rectsOverlap(a, b) {
  return a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y;
}
function annotateUnstableFacts(facts, regions) {
  return facts.map((fact4) => {
    const caveats = [];
    for (const region of regions) {
      const byElement = fact4.elementId !== void 0 && (region.elementIds?.includes(fact4.elementId) ?? false);
      const byRect = fact4.rect !== void 0 && region.rect !== void 0 && rectsOverlap(fact4.rect, region.rect);
      if (byElement || byRect) {
        caveats.push({ regionId: region.id, selector: region.selector, reason: region.reason });
      }
    }
    return { fact: fact4, caveats };
  });
}
