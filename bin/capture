function sessionMetaPath2(id, artifactRoot = CAPTURE_ROOT) {
  return path16.join(sessionDir(id, artifactRoot), ".session.json");
}
function tryReadSession(id, artifactRoot = CAPTURE_ROOT) {
  const metaPath = sessionMetaPath2(id, artifactRoot);
  const bad = (reason) => ({ ok: false, id, metaPath, reason });
  let parsed;
  try {
    parsed = JSON.parse(readPrivateFile(metaPath).toString("utf-8"));
  } catch (error4) {
    if (error4.code === "ENOENT") throw error4;
    return bad("not valid JSON; the record is corrupt");
  }
  if (!isActiveStateCandidate(parsed)) return bad("does not match the session record schema; written by an incompatible version or corrupted");
  return { ok: true, session: parsed };
}
function readSession(id) {
  const active = getActiveSession();
  if (active?.sessionId === id) return active;
  for (const artifactRoot of registeredArtifactRoots()) {
    const metaPath = sessionMetaPath2(id, artifactRoot);
    let read;
    try {
      read = tryReadSession(id, artifactRoot);
    } catch (error4) {
      if (error4.code === "ENOENT") continue;
      throw error4;
    }
    if (!read.ok) throw captureError("artifact", "invalid_session_record", `session metadata at ${metaPath} ${read.reason}.`);
    return read.session;
  }
  throw captureError("precondition", "unknown_session", `No capture session found: ${id}`);
}
function generateId() {
  return `cap-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 6)}`;
}
async function waitForPageLoad(client, timeoutMs, attachTimeoutMs = SESSION_TAB_ATTACH_TIMEOUT_MS) {
  await client.waitReady();
  await client.send("Page.enable", {}, attachTimeoutMs);
  return await new Promise((resolve12) => {
    const timer = setTimeout(() => resolve12(true), timeoutMs);
    const done = (timedOut) => {
      clearTimeout(timer);
      resolve12(timedOut);
    };
    client.on("Page.loadEventFired", () => done(false));
    client.send("Runtime.evaluate", {
      expression: "document.readyState",
      returnByValue: true
    }).then((r) => {
      const value = r?.result?.value;
      if (value === "complete") done(false);
    }).catch(() => {
    });
  });
}
