      }
      function getDisplayPartsFromComment(comment, checker) {
        if (typeof comment === "string") {
          return [textPart(comment)];
        }
        return flatMap(
          comment,
          (node) => node.kind === 322 ? [textPart(node.text)] : buildLinkParts(node, checker)
