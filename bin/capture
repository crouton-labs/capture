async function probeCdpPort(port) {
  try {
    const version = await httpGetJson(port, "/json/version", 500);
    if (version) {
      const browser = version.Browser;
      const userAgent = version["User-Agent"] ?? "";
      if (!browser) return null;
      if (!version.webSocketDebuggerUrl) return null;
      const isElectron = userAgent.includes("Electron");
      let app = browser;
      if (isElectron) {
        const appMatch = userAgent.match(
          /(\S+?)\/[\d.]+ Chrome\/[\d.]+ Electron/
        );
        if (appMatch) app = appMatch[1];
      }
      const hasPageTarget = await probeHasPageTarget(port);
      return { browser, app, isElectron, hasPageTarget };
    }
  } catch {
  }
  return null;
}
async function probeHasPageTarget(port) {
  try {
    const list2 = await httpGetJson(port, "/json/list", 500);
    return Array.isArray(list2) && list2.some((t) => t.type === "page");
  } catch {
    return false;
  }
}
function getLocalhostListeningPorts() {
  try {
    const output = (0, import_child_process.execSync)(
      'netstat -an 2>/dev/null | grep "127.0.0.1.*LISTEN"',
      { encoding: "utf-8" }
    );
    const ports = [];
    for (const line4 of output.split("\n")) {
      const match = line4.match(/127\.0\.0\.1\.(\d+)/);
      if (match) {
        ports.push(parseInt(match[1], 10));
      }
    }
    return ports;
  } catch {
    return [];
  }
}
function getListeningProcessNames() {
  const names = /* @__PURE__ */ new Map();
  try {
    const output = (0, import_child_process.execSync)("lsof -nP -iTCP -sTCP:LISTEN -Fpcn 2>/dev/null", {
      encoding: "utf-8"
    });
    let command = null;
    for (const line4 of output.split("\n")) {
      if (line4.startsWith("c")) {
        command = line4.slice(1);
      } else if (command && line4.startsWith("n")) {
        const match = line4.match(/:(\d+)(?:\s|$)/);
        if (match) names.set(Number(match[1]), command);
      }
    }
  } catch {
  }
  return names;
}
function identifyBrowserBundleId(browser, processName) {
  const identity3 = (processName ?? browser).toLowerCase();
  for (const [bundleId, patterns] of Object.entries(BROWSER_PATTERNS)) {
    if (patterns.some((pattern) => identity3.includes(pattern))) return bundleId;
  }
  return "unknown";
}
async function detectCdpPortsAsync() {
  const ports = getLocalhostListeningPorts();
  const processNames2 = getListeningProcessNames();
  const results = [];
  const probes = ports.map(async (port) => {
    const probe = await probeCdpPort(port);
    if (probe) {
      const processName = processNames2.get(port);
      results.push({
        port,
        app: processName ?? probe.app,
        bundleId: identifyBrowserBundleId(probe.browser, processName),
        isElectron: probe.isElectron,
        hasPageTarget: probe.hasPageTarget
      });
    }
  });
  await Promise.all(probes);
  return results;
}
function pickPreferredEndpointWithReason(endpoints, defaultBrowser) {
  const withPages = endpoints.filter((e) => e.hasPageTarget);
  const candidates = withPages.length > 0 ? withPages : endpoints;
  const candidateScope = withPages.length > 0 ? "among endpoints with a live page target" : "because no discovered endpoint has a live page target";
  if (defaultBrowser) {
    const match = candidates.find(
      (p) => p.bundleId === defaultBrowser && !p.isElectron
    );
    if (match) return { endpoint: match, reason: `matched the configured default browser ${candidateScope}` };
  }
  const knownBrowser = candidates.find(
    (endpoint) => endpoint.bundleId !== "unknown" && !endpoint.isElectron
  );
  if (knownBrowser) return { endpoint: knownBrowser, reason: `is a recognized non-Electron browser ${candidateScope}` };
  const nonElectron = candidates.find((endpoint) => !endpoint.isElectron);
  if (nonElectron) return { endpoint: nonElectron, reason: `is the first non-Electron endpoint ${candidateScope}` };
  return { endpoint: candidates[0], reason: `is the first discovered endpoint ${candidateScope}` };
}
function pickPreferredEndpoint(endpoints, defaultBrowser) {
  return pickPreferredEndpointWithReason(endpoints, defaultBrowser).endpoint;
}
async function detectCdpEndpoint() {
  const endpoints = await detectCdpPortsAsync();
  if (endpoints.length === 0) {
    throw new Error(
      "No browser with CDP found. Start your browser with remote debugging enabled:\n  Arc: Already enabled by default\n  Chrome: --remote-debugging-port=9222\n  Electron apps expose CDP automatically"
    );
  }
  const { endpoint, reason } = pickPreferredEndpointWithReason(endpoints, getDefaultBrowserId());
  return { ...endpoint, selectionReason: reason };
}
async function detectCdpPort() {
  return (await detectCdpEndpoint()).port;
}
