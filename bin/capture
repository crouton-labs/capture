        function typeHasProtectedAccessibleBase(target, type) {
          const baseTypes = getBaseTypes(type);
          if (!length(baseTypes)) {
            return false;
          }
          const firstBase = baseTypes[0];
          if (firstBase.flags & 2097152) {
            const types = firstBase.types;
