// src/har-manager.ts
function fail(source, path48, message) {
  throw new Error(`HAR validation failed [${source}] at ${path48}: ${message}`);
}
function hasOwn(o, key) {
  return Object.prototype.hasOwnProperty.call(o, key);
}
function isPlainObject(v) {
  if (typeof v !== "object" || v === null || Array.isArray(v)) return false;
  const proto = Object.getPrototypeOf(v);
  return proto === Object.prototype || proto === null;
}
function vObject(v, source, path48) {
  if (!isPlainObject(v)) fail(source, path48, "must be a plain object");
  return v;
}
function exactKeys2(o, allowed, source, path48) {
  for (const k of Object.keys(o)) {
    if (!allowed.includes(k)) fail(source, `${path48}.${k}`, "is an unknown key");
  }
}
function vArray(v, source, path48) {
  if (!Array.isArray(v)) fail(source, path48, "must be an array");
  for (let i = 0; i < v.length; i++) {
    if (!Object.prototype.hasOwnProperty.call(v, i)) {
      fail(source, `${path48}[${i}]`, "is a sparse-array hole");
    }
  }
  return v;
}
function vString(v, source, path48) {
  if (typeof v !== "string") fail(source, path48, "must be a string");
  return v;
}
function vNonEmptyString(v, source, path48) {
  const s = vString(v, source, path48);
  if (s.length === 0) fail(source, path48, "must be a nonempty string");
  return s;
}
function vNullableString(v, source, path48) {
  if (v === null) return null;
  return vString(v, source, path48);
}
function vBoolean(v, source, path48) {
  if (typeof v !== "boolean") fail(source, path48, "must be a boolean");
  return v;
}
function vLiteral(v, expected, source, path48) {
  if (v !== expected) fail(source, path48, `must equal ${JSON.stringify(expected)}`);
  return expected;
}
function vFinite(v, source, path48) {
  if (typeof v !== "number" || !Number.isFinite(v)) fail(source, path48, "must be a finite number");
  return v;
}
function vFiniteMin(v, min, source, path48) {
  const n = vFinite(v, source, path48);
  if (n < min) fail(source, path48, `must be >= ${min}`);
  return n;
}
function vIntInRange(v, lo, hi, source, path48) {
  if (typeof v !== "number" || !Number.isInteger(v)) fail(source, path48, "must be an integer");
  if (v < lo || v > hi) fail(source, path48, `must be an integer in ${lo}..${hi}`);
  return v;
}
function vSafeIntMin(v, min, source, path48) {
  if (typeof v !== "number" || !Number.isSafeInteger(v)) fail(source, path48, "must be a safe integer");
  if (v < min) fail(source, path48, `must be a safe integer >= ${min}`);
  return v;
}
function vSafeIntInRange(v, lo, hi, source, path48) {
  if (typeof v !== "number" || !Number.isSafeInteger(v)) fail(source, path48, "must be a safe integer");
  if (v < lo || v > hi) fail(source, path48, `must be a safe integer in ${lo}..${hi}`);
  return v;
}
function assertStartedDateTime(startedDateTime, requestWallTime, source, wallPath, startedPath) {
  const d = new Date(requestWallTime * 1e3);
  if (Number.isNaN(d.getTime())) {
    fail(source, wallPath, "is outside the representable ISO date range");
  }
  if (startedDateTime !== d.toISOString()) {
    fail(source, startedPath, "must equal new Date(requestWallTime * 1000).toISOString()");
  }
}
function vHeader(v, source, path48) {
  const o = vObject(v, source, path48);
  exactKeys2(o, ["name", "value"], source, path48);
  return {
    name: vString(o.name, source, `${path48}.name`),
    value: vString(o.value, source, `${path48}.value`)
  };
}
function vHeaders(v, source, path48) {
  return vArray(v, source, path48).map((h, i) => vHeader(h, source, `${path48}[${i}]`));
}
function vPostData(v, source, path48) {
  const o = vObject(v, source, path48);
  exactKeys2(o, ["mimeType", "text"], source, path48);
  return {
    mimeType: vString(o.mimeType, source, `${path48}.mimeType`),
    text: vString(o.text, source, `${path48}.text`)
  };
}
function vRequest(v, source, path48) {
  const o = vObject(v, source, path48);
  const withPost = hasOwn(o, "postData");
  exactKeys2(o, withPost ? ["method", "url", "headers", "postData"] : ["method", "url", "headers"], source, path48);
  const req = {
    method: vNonEmptyString(o.method, source, `${path48}.method`),
    url: vNonEmptyString(o.url, source, `${path48}.url`),
    headers: vHeaders(o.headers, source, `${path48}.headers`)
  };
  if (withPost) {
    req.postData = vPostData(o.postData, source, `${path48}.postData`);
  }
  return req;
}
function vClocks(v, source, path48) {
  const o = vObject(v, source, path48);
  exactKeys2(o, ["requestWallTime", "requestMonotonic", "responseMonotonic", "terminalMonotonic"], source, path48);
  const requestMonotonic = vFiniteMin(o.requestMonotonic, 0, source, `${path48}.requestMonotonic`);
  const terminalMonotonic = vFiniteMin(o.terminalMonotonic, 0, source, `${path48}.terminalMonotonic`);
  const responseMonotonic = o.responseMonotonic === null ? null : vFiniteMin(o.responseMonotonic, 0, source, `${path48}.responseMonotonic`);
  if (terminalMonotonic < requestMonotonic) {
    fail(source, `${path48}.terminalMonotonic`, "must be >= requestMonotonic");
  }
  if (responseMonotonic !== null) {
    if (responseMonotonic < requestMonotonic) {
      fail(source, `${path48}.responseMonotonic`, "must be >= requestMonotonic");
    }
  }
  return {
    requestWallTime: vFinite(o.requestWallTime, source, `${path48}.requestWallTime`),
    requestMonotonic,
    responseMonotonic,
    terminalMonotonic
  };
}
function vEntryTerminal(v, source, path48) {
  const o = vObject(v, source, path48);
  if (o.kind === "finished") {
    exactKeys2(o, ["kind", "encodedDataLength"], source, path48);
    return { kind: "finished", encodedDataLength: vFiniteMin(o.encodedDataLength, 0, source, `${path48}.encodedDataLength`) };
  }
  if (o.kind === "redirect") {
    exactKeys2(o, ["kind"], source, path48);
    return { kind: "redirect" };
  }
  if (o.kind === "failed") {
    exactKeys2(o, ["kind", "errorText", "canceled", "blockedReason", "resourceType"], source, path48);
    return {
      kind: "failed",
      errorText: vString(o.errorText, source, `${path48}.errorText`),
      canceled: vBoolean(o.canceled, source, `${path48}.canceled`),
      blockedReason: vNullableString(o.blockedReason, source, `${path48}.blockedReason`),
      resourceType: vNullableString(o.resourceType, source, `${path48}.resourceType`)
    };
  }
  return fail(source, `${path48}.kind`, 'must be "finished", "redirect", or "failed"');
}
function vCaptureResponseState(v, source, path48) {
  const o = vObject(v, source, path48);
  exactKeys2(o, ["state"], source, path48);
  if (o.state === "received") return { state: "received" };
  if (o.state === "unavailable") return { state: "unavailable" };
  return fail(source, `${path48}.state`, 'must be "received" or "unavailable"');
}
function vBodyProvenance(v, source, path48) {
  const o = vObject(v, source, path48);
  if (o.state === "captured") {
    if (o.sourceEncoding !== "text" && o.sourceEncoding !== "base64") {
      fail(source, `${path48}.sourceEncoding`, 'must be "text" or "base64"');
    }
    exactKeys2(o, ["state", "sourceEncoding", "decodedByteLength", "capturedByteLength", "truncated"], source, path48);
    const decodedByteLength = vSafeIntMin(o.decodedByteLength, 0, source, `${path48}.decodedByteLength`);
    const capturedByteLength = vSafeIntInRange(o.capturedByteLength, 0, MAX_BODY_BYTES, source, `${path48}.capturedByteLength`);
    const truncated = vBoolean(o.truncated, source, `${path48}.truncated`);
    if (capturedByteLength > decodedByteLength) {
      fail(source, `${path48}.capturedByteLength`, "must not exceed decodedByteLength");
    }
    if (truncated !== capturedByteLength < decodedByteLength) {
      fail(source, `${path48}.truncated`, "must equal (capturedByteLength < decodedByteLength)");
    }
    return { state: "captured", sourceEncoding: o.sourceEncoding, decodedByteLength, capturedByteLength, truncated };
  }
  if (o.state === "fetch_failed") {
    exactKeys2(o, ["state", "error"], source, path48);
    return { state: "fetch_failed", error: vNonEmptyString(o.error, source, `${path48}.error`) };
  }
  if (o.state === "not_applicable") {
    exactKeys2(o, ["state", "reason"], source, path48);
    if (o.reason !== "redirect" && o.reason !== "no_response" && o.reason !== "network_failed") {
      fail(source, `${path48}.reason`, 'must be "redirect", "no_response", or "network_failed"');
    }
    return { state: "not_applicable", reason: o.reason };
  }
  return fail(source, `${path48}.state`, 'must be "captured", "fetch_failed", or "not_applicable"');
}
function vWebSocketMessage(v, source, path48) {
  const o = vObject(v, source, path48);
  exactKeys2(o, ["type", "time", "opcode", "data"], source, path48);
  if (o.type !== "send" && o.type !== "receive") {
    fail(source, `${path48}.type`, 'must be "send" or "receive"');
  }
  return {
    type: o.type,
    time: vFinite(o.time, source, `${path48}.time`),
    opcode: vIntInRange(o.opcode, 0, 15, source, `${path48}.opcode`),
    data: vString(o.data, source, `${path48}.data`)
  };
}
function vWebSocketEntry(o, source, path48) {
  exactKeys2(o, ["startedDateTime", "request", "response", "_resourceType", "_webSocketMessages"], source, path48);
  vLiteral(o._resourceType, "websocket", source, `${path48}._resourceType`);
  const startedDateTime = vNonEmptyString(o.startedDateTime, source, `${path48}.startedDateTime`);
  const parsed = new Date(startedDateTime);
  if (Number.isNaN(parsed.getTime()) || parsed.toISOString() !== startedDateTime) {
    fail(source, `${path48}.startedDateTime`, "must be a canonical UTC ISO instant");
  }
  const request = vRequest(o.request, source, `${path48}.request`);
  const respObj = vObject(o.response, source, `${path48}.response`);
  exactKeys2(respObj, ["status", "headers", "content"], source, `${path48}.response`);
  const status = vIntInRange(respObj.status, 0, 599, source, `${path48}.response.status`);
  if (status !== 0 && status < 100) {
    fail(source, `${path48}.response.status`, "must be 0 (handshake response never observed) or 100..599");
  }
  const respHeaders = vHeaders(respObj.headers, source, `${path48}.response.headers`);
  const contentObj = vObject(respObj.content, source, `${path48}.response.content`);
  exactKeys2(contentObj, [], source, `${path48}.response.content`);
  const messages = vArray(o._webSocketMessages, source, `${path48}._webSocketMessages`).map(
    (m, i) => vWebSocketMessage(m, source, `${path48}._webSocketMessages[${i}]`)
  );
  return {
    startedDateTime,
    request,
    response: { status, headers: respHeaders, content: {} },
    _resourceType: "websocket",
    _webSocketMessages: messages
  };
}
function vEntry(v, source, path48) {
  const o = vObject(v, source, path48);
  if (hasOwn(o, "_resourceType")) return vWebSocketEntry(o, source, path48);
  exactKeys2(o, ["startedDateTime", "time", "request", "response", "_capture"], source, path48);
  const startedDateTime = vString(o.startedDateTime, source, `${path48}.startedDateTime`);
  const time = vFiniteMin(o.time, 0, source, `${path48}.time`);
  const request = vRequest(o.request, source, `${path48}.request`);
  const respObj = vObject(o.response, source, `${path48}.response`);
  exactKeys2(respObj, ["status", "headers", "content"], source, `${path48}.response`);
  const status = vIntInRange(respObj.status, 0, 599, source, `${path48}.response.status`);
  const respHeaders = vHeaders(respObj.headers, source, `${path48}.response.headers`);
  const contentObj = vObject(respObj.content, source, `${path48}.response.content`);
  const capObj = vObject(o._capture, source, `${path48}._capture`);
  exactKeys2(capObj, ["schemaVersion", "requestId", "generation", "clocks", "terminal", "response", "body"], source, `${path48}._capture`);
  vLiteral(capObj.schemaVersion, 1, source, `${path48}._capture.schemaVersion`);
  const requestId2 = vNonEmptyString(capObj.requestId, source, `${path48}._capture.requestId`);
  const generation = vSafeIntMin(capObj.generation, 1, source, `${path48}._capture.generation`);
  const clocks = vClocks(capObj.clocks, source, `${path48}._capture.clocks`);
  const terminal2 = vEntryTerminal(capObj.terminal, source, `${path48}._capture.terminal`);
  const capResponse = vCaptureResponseState(capObj.response, source, `${path48}._capture.response`);
  const body2 = vBodyProvenance(capObj.body, source, `${path48}._capture.body`);
  assertStartedDateTime(startedDateTime, clocks.requestWallTime, source, `${path48}._capture.clocks.requestWallTime`, `${path48}.startedDateTime`);
  const expectedTime = (clocks.terminalMonotonic - clocks.requestMonotonic) * 1e3;
  if (time !== expectedTime) {
    fail(source, `${path48}.time`, "must equal (terminalMonotonic - requestMonotonic) * 1000");
  }
  if (capResponse.state === "received") {
    if ((status < 100 || status > 599) && !(terminal2.kind === "redirect" && status === 0)) {
      fail(source, `${path48}.response.status`, "a received response requires status 100..599 (or 0 for a redirect with no HTTP response)");
    }
  } else {
    if (terminal2.kind !== "failed") {
      fail(source, `${path48}._capture.response.state`, '"unavailable" is permitted only for terminal kind "failed"');
    }
    if (status !== 0) fail(source, `${path48}.response.status`, "an unavailable response requires status 0");
    if (respHeaders.length !== 0) fail(source, `${path48}.response.headers`, "an unavailable response requires empty headers");
    if (clocks.responseMonotonic !== null) {
      fail(source, `${path48}._capture.clocks.responseMonotonic`, "must be null when no response was received");
    }
  }
  if (status === 0 && capResponse.state !== "unavailable" && terminal2.kind !== "redirect") {
    fail(source, `${path48}.response.status`, "status 0 is permitted only for an unavailable response or a redirect with no HTTP response");
  }
  if (terminal2.kind === "finished") {
    if (capResponse.state !== "received") {
      fail(source, `${path48}._capture.response.state`, "a finished terminal requires a received response");
    }
    if (body2.state !== "captured" && body2.state !== "fetch_failed") {
      fail(source, `${path48}._capture.body.state`, 'a finished terminal requires body "captured" or "fetch_failed"');
    }
  } else if (terminal2.kind === "redirect") {
    if (capResponse.state !== "received") {
      fail(source, `${path48}._capture.response.state`, "a redirect requires a received response");
    }
    if (status !== 0 && (status < 300 || status > 399)) {
      fail(source, `${path48}.response.status`, "a redirect requires status 0 (no HTTP response) or 300..399");
    }
    if (body2.state !== "not_applicable" || body2.reason !== "redirect") {
      fail(source, `${path48}._capture.body`, "a redirect requires body not_applicable/redirect");
    }
    if (clocks.responseMonotonic !== null) {
      fail(source, `${path48}._capture.clocks.responseMonotonic`, "must be null for a redirect entry");
    }
  } else {
    if (body2.state !== "not_applicable" || body2.reason !== "no_response" && body2.reason !== "network_failed") {
      fail(source, `${path48}._capture.body`, "a failed terminal requires body not_applicable/no_response or not_applicable/network_failed");
    }
    if (capResponse.state === "unavailable" && body2.reason !== "no_response") {
      fail(source, `${path48}._capture.body.reason`, 'a failed terminal without a response requires reason "no_response"');
    }
    if (capResponse.state === "received" && body2.reason !== "network_failed") {
      fail(source, `${path48}._capture.body.reason`, 'a failed terminal with a received response requires reason "network_failed"');
    }
  }
  const content = {};
  if (body2.state === "captured" && body2.sourceEncoding === "text") {
    exactKeys2(contentObj, ["text"], source, `${path48}.response.content`);
    const text2 = vString(contentObj.text, source, `${path48}.response.content.text`);
    if (Buffer.byteLength(text2, "utf8") !== body2.capturedByteLength) {
      fail(source, `${path48}.response.content.text`, "UTF-8 byte length must equal body.capturedByteLength");
    }
    content.text = text2;
  } else if (body2.state === "captured" && body2.sourceEncoding === "base64") {
    exactKeys2(contentObj, ["text", "encoding"], source, `${path48}.response.content`);
    const text2 = vString(contentObj.text, source, `${path48}.response.content.text`);
    vLiteral(contentObj.encoding, "base64", source, `${path48}.response.content.encoding`);
    const decoded = Buffer.from(text2, "base64");
    if (decoded.toString("base64") !== text2) {
      fail(source, `${path48}.response.content.text`, "must be canonical base64");
    }
    if (decoded.length !== body2.capturedByteLength) {
      fail(source, `${path48}.response.content.text`, "decoded byte length must equal body.capturedByteLength");
    }
    if (body2.capturedByteLength !== Math.min(body2.decodedByteLength, MAX_BODY_BYTES)) {
      fail(source, `${path48}._capture.body.capturedByteLength`, "must equal min(decodedByteLength, 262144) for base64 bodies");
    }
    content.text = text2;
    content.encoding = "base64";
  } else {
    exactKeys2(contentObj, [], source, `${path48}.response.content`);
  }
  return {
    startedDateTime,
    time,
    request,
    response: { status, headers: respHeaders, content },
    _capture: { schemaVersion: 1, requestId: requestId2, generation, clocks, terminal: terminal2, response: capResponse, body: body2 }
  };
}
function vIncompleteResponse(v, source, path48, minResponseMonotonic, allowUnknownClock = false, allowNoHttpStatus = false) {
  const o = vObject(v, source, path48);
  exactKeys2(o, ["status", "headers", "responseMonotonic"], source, path48);
  const responseMonotonic = o.responseMonotonic === null ? allowUnknownClock ? null : fail(source, `${path48}.responseMonotonic`, "must be a finite number") : vFiniteMin(o.responseMonotonic, minResponseMonotonic, source, `${path48}.responseMonotonic`);
  const status = vIntInRange(o.status, 0, 599, source, `${path48}.status`);
  if (status < 100 && status !== 0 || status === 0 && (!allowNoHttpStatus || responseMonotonic !== null)) {
    fail(source, `${path48}.status`, "must be 100..599 (or 0 for a redirect with no HTTP response)");
  }
  return { status, headers: vHeaders(o.headers, source, `${path48}.headers`), responseMonotonic };
}
function vStoppedBeforeTerminal(o, source, path48) {
  exactKeys2(o, ["kind", "requestId", "generation", "startedDateTime", "request", "_capture"], source, path48);
  const requestId2 = vNonEmptyString(o.requestId, source, `${path48}.requestId`);
  const generation = vSafeIntMin(o.generation, 1, source, `${path48}.generation`);
  const startedDateTime = vString(o.startedDateTime, source, `${path48}.startedDateTime`);
  const request = vRequest(o.request, source, `${path48}.request`);
  const cap2 = vObject(o._capture, source, `${path48}._capture`);
  exactKeys2(cap2, ["schemaVersion", "requestWallTime", "requestMonotonic", "response"], source, `${path48}._capture`);
  vLiteral(cap2.schemaVersion, 1, source, `${path48}._capture.schemaVersion`);
  const requestWallTime = vFinite(cap2.requestWallTime, source, `${path48}._capture.requestWallTime`);
  const requestMonotonic = vFiniteMin(cap2.requestMonotonic, 0, source, `${path48}._capture.requestMonotonic`);
  const response = cap2.response === null ? null : vIncompleteResponse(cap2.response, source, `${path48}._capture.response`, requestMonotonic);
  assertStartedDateTime(startedDateTime, requestWallTime, source, `${path48}._capture.requestWallTime`, `${path48}.startedDateTime`);
  return {
    kind: "stopped_before_terminal",
    requestId: requestId2,
    generation,
    startedDateTime,
    request,
    _capture: { schemaVersion: 1, requestWallTime, requestMonotonic, response }
  };
}
function vInvalidClockTerminal(v, source, path48) {
  const o = vObject(v, source, path48);
  if (o.kind === "finished") {
    exactKeys2(o, ["kind", "terminalMonotonic", "encodedDataLength"], source, path48);
    return {
      kind: "finished",
      terminalMonotonic: vFiniteMin(o.terminalMonotonic, 0, source, `${path48}.terminalMonotonic`),
      encodedDataLength: vFiniteMin(o.encodedDataLength, 0, source, `${path48}.encodedDataLength`)
    };
  }
  if (o.kind === "redirect") {
    exactKeys2(o, ["kind", "terminalMonotonic"], source, path48);
    return { kind: "redirect", terminalMonotonic: vFiniteMin(o.terminalMonotonic, 0, source, `${path48}.terminalMonotonic`) };
  }
  if (o.kind === "failed") {
    exactKeys2(o, ["kind", "terminalMonotonic", "errorText", "canceled", "blockedReason", "resourceType"], source, path48);
    return {
      kind: "failed",
      terminalMonotonic: vFiniteMin(o.terminalMonotonic, 0, source, `${path48}.terminalMonotonic`),
      errorText: vString(o.errorText, source, `${path48}.errorText`),
      canceled: vBoolean(o.canceled, source, `${path48}.canceled`),
      blockedReason: vNullableString(o.blockedReason, source, `${path48}.blockedReason`),
      resourceType: vNullableString(o.resourceType, source, `${path48}.resourceType`)
    };
  }
  return fail(source, `${path48}.kind`, 'must be "finished", "redirect", or "failed"');
}
function vInvalidClockOrder(o, source, path48) {
  exactKeys2(o, ["kind", "requestId", "generation", "startedDateTime", "request", "response", "terminal", "_capture", "violation"], source, path48);
  const requestId2 = vNonEmptyString(o.requestId, source, `${path48}.requestId`);
  const generation = vSafeIntMin(o.generation, 1, source, `${path48}.generation`);
  const startedDateTime = vString(o.startedDateTime, source, `${path48}.startedDateTime`);
  const request = vRequest(o.request, source, `${path48}.request`);
  const terminal2 = vInvalidClockTerminal(o.terminal, source, `${path48}.terminal`);
  const response = o.response === null ? null : vIncompleteResponse(o.response, source, `${path48}.response`, 0, true, terminal2.kind === "redirect");
  const cap2 = vObject(o._capture, source, `${path48}._capture`);
  exactKeys2(cap2, ["schemaVersion", "requestWallTime", "requestMonotonic"], source, `${path48}._capture`);
  vLiteral(cap2.schemaVersion, 1, source, `${path48}._capture.schemaVersion`);
  const requestWallTime = vFinite(cap2.requestWallTime, source, `${path48}._capture.requestWallTime`);
  const requestMonotonic = vFiniteMin(cap2.requestMonotonic, 0, source, `${path48}._capture.requestMonotonic`);
  let violation;
  if (o.violation === "response_before_request") violation = "response_before_request";
  else if (o.violation === "terminal_before_request") violation = "terminal_before_request";
  else if (o.violation === "terminal_before_response") violation = "terminal_before_response";
  else return fail(source, `${path48}.violation`, 'must be "response_before_request", "terminal_before_request", or "terminal_before_response"');
  assertStartedDateTime(startedDateTime, requestWallTime, source, `${path48}._capture.requestWallTime`, `${path48}.startedDateTime`);
  if (terminal2.kind === "redirect") {
    if (response === null) fail(source, `${path48}.response`, "a redirect terminal requires an observed response");
    if (response.status !== 0 && (response.status < 300 || response.status > 399)) {
      fail(source, `${path48}.response.status`, "a redirect terminal requires status 0 (no HTTP response) or 300..399");
    }
    if (response.responseMonotonic !== null) {
      fail(source, `${path48}.response.responseMonotonic`, "must be null for a redirect terminal");
    }
  } else if (response?.responseMonotonic === null) {
    fail(source, `${path48}.response.responseMonotonic`, "may be null only for a redirect terminal");
  }
  if (violation === "response_before_request") {
    if (response === null || response.responseMonotonic === null) fail(source, `${path48}.violation`, '"response_before_request" requires an observed response clock');
    else if (!(response.responseMonotonic < requestMonotonic)) {
      fail(source, `${path48}.violation`, '"response_before_request" requires response.responseMonotonic < requestMonotonic');
    }
  } else if (violation === "terminal_before_request") {
    if (!(terminal2.terminalMonotonic < requestMonotonic)) {
      fail(source, `${path48}.violation`, '"terminal_before_request" requires terminal.terminalMonotonic < requestMonotonic');
    }
  } else {
    if (response === null || response.responseMonotonic === null) fail(source, `${path48}.violation`, '"terminal_before_response" requires an observed response clock');
    else if (!(terminal2.terminalMonotonic < response.responseMonotonic)) {
      fail(source, `${path48}.violation`, '"terminal_before_response" requires terminal.terminalMonotonic < response.responseMonotonic');
    }
  }
  return { kind: "invalid_clock_order", requestId: requestId2, generation, startedDateTime, request, response, terminal: terminal2, _capture: { schemaVersion: 1, requestWallTime, requestMonotonic }, violation };
}
function vStoppedDuringBody(o, source, path48) {
  exactKeys2(o, ["kind", "requestId", "generation", "startedDateTime", "request", "response", "_capture"], source, path48);
  const requestId2 = vNonEmptyString(o.requestId, source, `${path48}.requestId`);
  const generation = vSafeIntMin(o.generation, 1, source, `${path48}.generation`);
  const startedDateTime = vString(o.startedDateTime, source, `${path48}.startedDateTime`);
  const request = vRequest(o.request, source, `${path48}.request`);
  const respObj = vObject(o.response, source, `${path48}.response`);
  exactKeys2(respObj, ["status", "headers"], source, `${path48}.response`);
  const response = {
    status: vIntInRange(respObj.status, 100, 599, source, `${path48}.response.status`),
    headers: vHeaders(respObj.headers, source, `${path48}.response.headers`)
  };
  const cap2 = vObject(o._capture, source, `${path48}._capture`);
  exactKeys2(cap2, ["schemaVersion", "requestWallTime", "requestMonotonic", "responseMonotonic", "terminalMonotonic", "encodedDataLength"], source, `${path48}._capture`);
  vLiteral(cap2.schemaVersion, 1, source, `${path48}._capture.schemaVersion`);
  const requestWallTime = vFinite(cap2.requestWallTime, source, `${path48}._capture.requestWallTime`);
  const requestMonotonic = vFiniteMin(cap2.requestMonotonic, 0, source, `${path48}._capture.requestMonotonic`);
  const responseMonotonic = vFiniteMin(cap2.responseMonotonic, requestMonotonic, source, `${path48}._capture.responseMonotonic`);
  const terminalMonotonic = vFiniteMin(cap2.terminalMonotonic, requestMonotonic, source, `${path48}._capture.terminalMonotonic`);
  const encodedDataLength = vFiniteMin(cap2.encodedDataLength, 0, source, `${path48}._capture.encodedDataLength`);
  assertStartedDateTime(startedDateTime, requestWallTime, source, `${path48}._capture.requestWallTime`, `${path48}.startedDateTime`);
  return {
    kind: "stopped_during_body",
    requestId: requestId2,
    generation,
    startedDateTime,
    request,
    response,
    _capture: { schemaVersion: 1, requestWallTime, requestMonotonic, responseMonotonic, terminalMonotonic, encodedDataLength }
  };
}
function vIncomplete(v, source, path48) {
  const o = vObject(v, source, path48);
  if (o.kind === "stopped_before_terminal") return vStoppedBeforeTerminal(o, source, path48);
  if (o.kind === "invalid_clock_order") return vInvalidClockOrder(o, source, path48);
  if (o.kind === "stopped_during_body") return vStoppedDuringBody(o, source, path48);
  return fail(source, `${path48}.kind`, 'must be "stopped_before_terminal", "invalid_clock_order", or "stopped_during_body"');
}
function validateHarFile(value, source) {
  const o = vObject(value, source, "harFile");
  exactKeys2(o, ["log", "incompleteLifecycles"], source, "harFile");
  const log = vObject(o.log, source, "harFile.log");
  exactKeys2(log, ["version", "creator", "entries"], source, "harFile.log");
  vLiteral(log.version, "1.2", source, "harFile.log.version");
  const creator = vObject(log.creator, source, "harFile.log.creator");
  exactKeys2(creator, ["name", "version"], source, "harFile.log.creator");
  vLiteral(creator.name, "capture", source, "harFile.log.creator.name");
  const creatorVersion = vNonEmptyString(creator.version, source, "harFile.log.creator.version");
  const entries = vArray(log.entries, source, "harFile.log.entries").map((e, i) => vEntry(e, source, `harFile.log.entries[${i}]`));
  const incompleteLifecycles = vArray(o.incompleteLifecycles, source, "harFile.incompleteLifecycles").map(
    (c, i) => vIncomplete(c, source, `harFile.incompleteLifecycles[${i}]`)
  );
  return {
    log: { version: "1.2", creator: { name: "capture", version: creatorVersion }, entries },
    incompleteLifecycles
  };
}
function validateHarAppendBatch(value, source) {
  const o = vObject(value, source, "harAppendBatch");
  exactKeys2(o, ["entries", "incompleteLifecycles"], source, "harAppendBatch");
  const entries = vArray(o.entries, source, "harAppendBatch.entries").map((e, i) => vEntry(e, source, `harAppendBatch.entries[${i}]`));
