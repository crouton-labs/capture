// src/session-context.ts
function activeScopeKey() {
  return process.env.CRTR_NODE_ID ?? "default";
}
function activeSessionScopeKey() {
  return activeScopeKey();
}
function getActivePath() {
  return path3.join(CAPTURE_ROOT, `.active-${activeScopeKey()}`);
}
function isIndex(value) {
  if (!value || typeof value !== "object" || Array.isArray(value)) return false;
  const record5 = value;
  return typeof record5.sessionId === "string" && typeof record5.dir === "string";
}
function statActiveEntry() {
  try {
    const stat = fs3.lstatSync(getActivePath(), { bigint: true });
    return { dev: stat.dev.toString(), ino: stat.ino.toString() };
  } catch (error4) {
    if (error4.code === "ENOENT") return null;
    throw error4;
  }
}
function readActivePointer() {
  const entry = statActiveEntry();
  if (!entry) return { index: null, entry: null };
  try {
    const raw = readPrivateFile(getActivePath()).toString("utf-8");
    const parsed = JSON.parse(raw);
    if (!isIndex(parsed)) return { index: null, entry };
    return { index: { sessionId: parsed.sessionId, dir: parsed.dir }, entry };
  } catch {
    return { index: null, entry };
  }
}
function sessionMetaPath(sessionDir2) {
  return path3.join(sessionDir2, ".session.json");
}
function sessionStateLockPath(sessionDir2) {
  return path3.join(assertUnderCaptureRoot(sessionDir2), ".session-state.lock");
}
async function withSessionStateLock(sessionDir2, action) {
  const lock = await acquirePrivateLock(sessionStateLockPath(sessionDir2), {
    acquireTimeoutMs: 3e4,
    leaseMs: 500
  });
  try {
    return action();
  } finally {
    lock.release();
  }
}
function isActiveStateCandidate(value) {
  if (!value || typeof value !== "object" || Array.isArray(value)) return false;
  const record5 = value;
  const nullableString = (field) => field === void 0 || field === null || typeof field === "string";
