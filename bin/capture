            typeof request.waitEvent === "string" ? request.waitEvent : void 0,
            typeof request.timeoutMs === "number" ? request.timeoutMs : void 0,
            request.observeDocumentResponse === true
          );
          answer({ ok: true, ...dispatched && typeof dispatched === "object" ? dispatched : { result: dispatched } });
          return;
        }
        default:
          answer({ ok: false, error: `unknown collector host request: ${type}` });
          return;
      }
    } catch (error4) {
      answer({ ok: false, error: error4 instanceof Error ? error4.message : String(error4) });
    }
  });
