          sourceFile,
          formatContext,
          3
          /* FormatOnSemicolon */
        );
      }
      function formatOnOpeningCurly(position, sourceFile, formatContext) {
        const openingCurly = findImmediatelyPrecedingTokenOfKind(position, 19, sourceFile);
