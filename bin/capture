            case 213:
              return substituteElementAccessExpression(node);
            case 214:
              return substituteCallExpression(node);
          }
          return node;
        }
        function substitutePropertyAccessExpression(node) {
          if (node.expression.kind === 108) {
            return setTextRange(
              factory2.createPropertyAccessExpression(
