  const positional = [];
  const parsed = { command, positional };
  const commandPath = syntaxCommand(argv);
  const valueFor = (flag, next) => schemaValueFor(commandPath, flag, next);
  const integer = (token2, flag, min, max, safe = false) => schemaInteger(commandPath, token2, flag, min, max, safe);
  const durationMs = (token2) => schemaDuration(commandPath, token2);
  for (let i = 0; i < rest.length; i++) {
    const arg = rest[i];
    const next = rest[i + 1];
    if (VALUE_FLAGS.has(arg) && !(arg === "--crop" && commandPath === "measure text")) valueFor(arg, next);
