function reconstructHeapSnapshot(dir) {
  const snapshot = path9.join(dir, "snapshot.heapsnapshot");
  if (!fs7.existsSync(snapshot)) return { summary: { bytes: 0 }, files: [] };
  const bytes = fs7.statSync(snapshot).size;
  return { summary: { bytes }, files: [{ name: "snapshot.heapsnapshot", bytes }] };
}
